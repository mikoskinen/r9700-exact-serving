#!/bin/sh
# r9700-host-tuning apply|revert|status: disables CPU idle states with an exit latency of 100 us or more and sets the
# performance governor. Installed as /usr/local/sbin/r9700-host-tuning and run at boot by r9700-host-tuning.service;
# `systemctl stop r9700-host-tuning` reverts. kernel.numa_balancing=0 is set by /etc/sysctl.d/90-r9700-numa.conf.
set -eu
PATH=/usr/sbin:/usr/bin:/sbin:/bin
deep() { for s in /sys/devices/system/cpu/cpu[0-9]*/cpuidle/state[0-9]*; do [ "$(cat $s/latency)" -ge 100 ] && echo $s; done; }
case "${1:-status}" in
  apply)  for s in $(deep); do echo 1 > $s/disable; done
          for f in /sys/devices/system/cpu/cpu[0-9]*/cpufreq/scaling_governor; do echo performance > $f; done ;;
  revert) for s in $(deep); do echo 0 > $s/disable; done
          for f in /sys/devices/system/cpu/cpu[0-9]*/cpufreq/scaling_governor; do echo schedutil > $f; done ;;
  status) ;;
  *) echo "usage: r9700-host-tuning apply|revert|status" >&2; exit 2 ;;
esac
n=$(deep | wc -l); d=0; for s in $(deep); do [ "$(cat $s/disable)" = 1 ] && d=$((d+1)); done
echo "r9700-host-tuning ${1:-status}: deep C-states (exit >= 100 us) disabled $d/$n | governor $(cat /sys/devices/system/cpu/cpu[0-9]*/cpufreq/scaling_governor | sort | uniq -c | tr -s ' ' | tr '\n' ',') | numa_balancing $(cat /proc/sys/kernel/numa_balancing)"
