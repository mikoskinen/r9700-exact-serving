/* r4d_ds41_ggml.hip -- DeepSeek-V4.1's GEMMs over llama.cpp's own GGUF blocks: gemm_nt_ggml,
 * moe_gemm_ggml, logits_gemm_ggml and embed_lookup_ggml (libref/ref_ggml.cpp is the oracle).
 *
 * The weight is the type's native blocks, rows back to back as r4d_ds41_ggml_layout.cpp (libref's
 * layout) writes them, K / block * block_bytes bytes a row; the engine hands it as u8 with the
 * DECLARED shape [N, K], so the row stride comes from the type, never from the operand. A float
 * [N, K] weight is the logical form (rad-kbench's random operands) and is read as it is.
 *
 * Arithmetic, as libref: every weight value is dequantised to f32 exactly as llama.cpp's
 * dequantize_row_<type> computes it (libquant/lq_ggml_dequant.cpp: the same operations in the same
 * order, d widened from f16 exactly), multiplied by the bf16 activation widened to f32 (a rounded
 * product, no FMA: the unit is -ffp-contract=off) and summed in f32, then rounded once to the
 * output dtype. Only the order of the sum differs from libref's index order.
 *
 * Two paths a op, picked by the row band:
 *   gemv  (M <= 16): the weight streamed once. A wave owns 1 or 2 weight rows; its lanes walk the
 *         row's 32-value units (lane = unit mod 32), each unit decoded into registers and dotted
 *         with every activation row, the activation chunk staged once a block in LDS as f32. A
 *         wave butterfly closes each sum. Up to 8 activation rows a pass, 16 in two.
 *   WMMA  (above the decode bands; every block type DeepSeek-V4.1 uses): gg_wm_kernel, RDNA4's
 *         v_wmma_f32_16x16x16_bf16 on bf16-exact unscaled grid values with each scale group's f32
 *         scale applied once to the group's f32 partial (see its section): libref's weight values,
 *         another summation order.
 *   tiled (the rest: the float form, IQ4_NL, K not a multiple of 128): 128 x 128 output tiles, the
 *         weight tile dequantised into LDS once a 32-value slab and reused by 128 activation rows,
 *         the next slab's raw blocks prefetched into registers; f32 multiply-add on 8 x 8 register
 *         tiles.
 * A unit is 32 values of one block in four groups of 8 consecutive values; for the K-quants its
 * groups follow llama.cpp's own bit layout (Q6_K: one l-range of 8 over the four quarter planes of
 * a half), so every byte a lane loads is used once.
 *
 * Block formats and the I-quant grids follow ggml (ggml-common.h, ggml-quants.c) and llama.cpp's
 * ggml-cuda mmvq/mmq (MIT, the ggml authors), used as a design reference; the grid tables below
 * are generated from libquant/lq_ggml_tables.cpp (ggml-common.h's, verbatim; IQ1_S's stored as
 * grid + 1 so a value is an unsigned byte).
 */
#include "r4d.h"
#include "r4d_args.h"
#include "r4d_common.h"
#include "r4d_emit.h"
#include "r4d_plugin.h"

#include <atomic>
#include <cstdint>
#include <cstdio>
#include <cstdlib>
#include <cstring>
#include <type_traits>

namespace {

/* ================================================================== tables (ggml-common.h) */
