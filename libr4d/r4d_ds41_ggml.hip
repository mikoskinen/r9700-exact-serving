/* ================================================================== loads and conversions */

/* The block types and the float logical form. Block offsets are only 2-byte aligned for every type
 * but Q5_K (176-byte blocks), so those types read 16-bit words; Q5_K reads dwords. */
enum : int { GG_Q8_0 = 0, GG_Q5_K, GG_Q6_K, GG_IQ4_NL, GG_IQ2_XXS, GG_IQ1_S, GG_F32, GG_NTYPES };

typedef __attribute__((address_space(1))) const uint32_t* gg_gu32;
typedef __attribute__((address_space(1))) const r4d_u32x4* gg_gu128;
/* Wider words at a 2-byte-aligned address, one load each: the device runs with unaligned access
 * enabled (the compiler emits global_load_b32/b64 for these). Only the decode kernel uses them. */
typedef uint32_t __attribute__((aligned(2))) gg_u32a2_t;
typedef unsigned int gg_u32x2 __attribute__((ext_vector_type(2)));
typedef gg_u32x2 __attribute__((aligned(2))) gg_u64a2_t;
typedef __attribute__((address_space(1))) const gg_u32a2_t* gg_gu32a2;
typedef __attribute__((address_space(1))) const gg_u64a2_t* gg_gu64a2;

__device__ __forceinline__ uint32_t gg_u16(const uint8_t* p) { return ldg_u16((const uint16_t*)p); }
__device__ __forceinline__ uint32_t gg_d32a2(const uint8_t* p) {
    return gg_u16(p) | (gg_u16(p + 2) << 16);
}
__device__ __forceinline__ uint32_t gg_d32(const uint8_t* p) { return *(gg_gu32)(const void*)p; }
__device__ __forceinline__ uint32_t gg_byte(uint32_t w, int i) { return (w >> (8 * i)) & 0xffu; }
__device__ __forceinline__ int gg_sbyte(uint32_t w, int i) { return (int)(int8_t)(w >> (8 * i)); }

/* IEEE half -> float exactly, as lq::ggml::f16_to_f32 (subnormals, infinities, NaN payloads). */
__device__ __forceinline__ float gg_h2f(uint32_t h) {
    const uint32_t s = (h & 0x8000u) << 16, e = (h >> 10) & 0x1fu, m = h & 0x3ffu;
    const float sub = __uint_as_float(__float_as_uint((float)m * 0x1p-24f) | s);
    const uint32_t nb = e == 0x1fu ? (s | 0x7f800000u | (m << 13)) : (s | ((e + 112u) << 23) | (m << 13));
    return e == 0u ? sub : __uint_as_float(nb);
}

/* Rounded once to the output dtype as libref's stt does: bf16 RNE with a NaN kept quiet. */
__device__ __forceinline__ void gg_put(uint16_t* p, float v) { *p = (uint16_t)(bf16_hi_rne_nan(v) >> 16); }
__device__ __forceinline__ void gg_put(float* p, float v) { *p = v; }

template <int N, int I = 0, class F>
__device__ __forceinline__ void gg_for(F&& f) {
    if constexpr (I < N) {
        f(std::integral_constant<int, I>{});
        gg_for<N, I + 1>(f);
    }
}

/* ================================================================== the types
 *
 * Per type: QK values and BB bytes a block, UPB 32-value units a block, NR raw dwords a unit,
 * TB bytes of LDS table. load() reads unit u of the block at `b` into raw dwords; goff(u, G) is
 * where group G (8 consecutive values) of the unit starts in the block; dec<G>() turns the raw
 * dwords into the group's eight f32 values, each by llama.cpp's formula. */
template <int T> struct Gg;

/* Q8_0: d (f16), qs[32]. y = qs * d. */
template <> struct Gg<GG_Q8_0> {
    static constexpr int QK = 32, BB = 34, UPB = 1, NR = 9, TB = 0;
    __device__ static __forceinline__ void load(const uint8_t* b, int, uint32_t* r) {
        r[0] = gg_u16(b);
#pragma unroll
        for (int i = 0; i < 8; ++i) r[1 + i] = gg_d32a2(b + 2 + 4 * i);
    }
    __device__ static __forceinline__ int goff(int, int g) { return 8 * g; }
    template <int G>
    __device__ static __forceinline__ void dec(const uint32_t* r, int, const void*, float* w) {
        const float d = gg_h2f(r[0]);
#pragma unroll
        for (int t = 0; t < 8; ++t) w[t] = (float)gg_sbyte(r[1 + 2 * G + t / 4], t % 4) * d;
    }
};

/* Q5_K: d, dmin, scales[12], qh[32], qs[128]. Chunk j of 64: d1 = d * sc, m1 = dmin * m from
 * scale_min_k4(2j + hi); y = d1 * (nibble + 16 * qh bit (2j + hi)) - m1. A unit is one l-range of
 * 8 (l0 = 8 (u & 3)) over the chunk pair jp = u >> 2: groups (j = 2jp + G/2, hi = G & 1). */
template <> struct Gg<GG_Q5_K> {
    static constexpr int QK = 256, BB = 176, UPB = 8, NR = 10, TB = 0;
    __device__ static __forceinline__ void load(const uint8_t* b, int u, uint32_t* r) {
        const int jp = u >> 2, l0 = 8 * (u & 3);
        r[0] = gg_d32(b);
        r[1] = gg_d32(b + 4);
        r[2] = gg_d32(b + 8);
        r[3] = gg_d32(b + 12);
        r[4] = gg_d32(b + 16 + l0);
        r[5] = gg_d32(b + 20 + l0);
        r[6] = gg_d32(b + 48 + 64 * jp + l0);
        r[7] = gg_d32(b + 52 + 64 * jp + l0);
        r[8] = gg_d32(b + 80 + 64 * jp + l0);
        r[9] = gg_d32(b + 84 + 64 * jp + l0);
    }
    __device__ static __forceinline__ int goff(int u, int g) {
        return 128 * (u >> 2) + 64 * (g >> 1) + 32 * (g & 1) + 8 * (u & 3);
    }
    template <int G>
    __device__ static __forceinline__ void dec(const uint32_t* r, int u, const void*, float* w) {
        constexpr int JL = G >> 1, HI = G & 1;
        const int jp = u >> 2;
        const float d = gg_h2f(r[0] & 0xffffu), dmin = gg_h2f(r[0] >> 16);
        /* scale_min_k4(is = 4 jp + G): q[G], q[G + 4], q[G + 8] are byte G of r[1], r[2], r[3]. */
        const uint32_t qa = gg_byte(r[1], G), qb = gg_byte(r[2], G), qc = gg_byte(r[3], G);
        const uint32_t sc = jp ? ((qc & 0xFu) | ((qa >> 6) << 4)) : (qa & 63u);
        const uint32_t mn = jp ? ((qc >> 4) | ((qb >> 6) << 4)) : (qb & 63u);
        const float d1 = d * (float)sc, m1 = dmin * (float)mn;
        const int hs = 4 * jp + G;            /* the qh bit: 2j + hi */
#pragma unroll
        for (int t = 0; t < 8; ++t) {
            const uint32_t qlb = gg_byte(r[6 + 2 * JL + t / 4], t % 4);
            const uint32_t q = HI ? (qlb >> 4) : (qlb & 0xFu);
            const uint32_t hb = (gg_byte(r[4 + t / 4], t % 4) >> hs) & 1u;
            w[t] = d1 * (float)(int)(q + (hb << 4)) - m1;
        }
    }
};

/* Q6_K: ql[128], qh[64], scales[16] (int8), d. Half h of 128: y[l + 32q] =
 * d * sc[is + 2q] * (q6 - 32), q6 = ql nibble | 2 qh bits << 4. A unit is one l-range of 8
 * (l0 = 8 (u & 3)) of half h = u >> 2 over the four quarters q (the groups). */
template <> struct Gg<GG_Q6_K> {
    static constexpr int QK = 256, BB = 210, UPB = 8, NR = 9, TB = 0;
    __device__ static __forceinline__ void load(const uint8_t* b, int u, uint32_t* r) {
        const int h = u >> 2, l0 = 8 * (u & 3);
        r[0] = gg_d32a2(b + 64 * h + l0);
        r[1] = gg_d32a2(b + 64 * h + l0 + 4);
        r[2] = gg_d32a2(b + 64 * h + 32 + l0);
        r[3] = gg_d32a2(b + 64 * h + 36 + l0);
        r[4] = gg_d32a2(b + 128 + 32 * h + l0);
        r[5] = gg_d32a2(b + 132 + 32 * h + l0);
        r[6] = gg_d32a2(b + 192 + 8 * h);
        r[7] = gg_d32a2(b + 196 + 8 * h);
        r[8] = gg_u16(b + 208);
    }
    __device__ static __forceinline__ int goff(int u, int g) {
        return 128 * (u >> 2) + 32 * g + 8 * (u & 3);
    }
    template <int G>
    __device__ static __forceinline__ void dec(const uint32_t* r, int u, const void*, float* w) {
        const int is = (u & 3) >> 1;
        const int sc = gg_sbyte(G < 2 ? r[6] : r[7], 2 * (G & 1) + is);
        const float ds = gg_h2f(r[8]) * (float)sc;
#pragma unroll
        for (int t = 0; t < 8; ++t) {
            const uint32_t qlb = gg_byte(r[(G & 1) * 2 + t / 4], t % 4);
            const uint32_t nib = G >= 2 ? (qlb >> 4) : (qlb & 0xFu);
            const uint32_t hb = (gg_byte(r[4 + t / 4], t % 4) >> (2 * G)) & 3u;
            w[t] = ds * (float)((int)(nib | (hb << 4)) - 32);
        }
    }
};

/* IQ4_NL: d, qs[16]. y[j] = d * kvalues[qs[j] & 15], y[j + 16] = d * kvalues[qs[j] >> 4]. */
template <> struct Gg<GG_IQ4_NL> {
    static constexpr int QK = 32, BB = 18, UPB = 1, NR = 5, TB = 64;
    __device__ static __forceinline__ void load(const uint8_t* b, int, uint32_t* r) {
        r[0] = gg_u16(b);
#pragma unroll
        for (int i = 0; i < 4; ++i) r[1 + i] = gg_d32a2(b + 2 + 4 * i);
    }
    __device__ static __forceinline__ int goff(int, int g) { return 8 * g; }
    template <int G>
    __device__ static __forceinline__ void dec(const uint32_t* r, int, const void* tab, float* w) {
        const float* kv = (const float*)tab;
        const float d = gg_h2f(r[0]);
#pragma unroll
        for (int t = 0; t < 8; ++t) {
            const uint32_t by = gg_byte(r[1 + 2 * (G & 1) + t / 4], t % 4);
            w[t] = d * kv[G >= 2 ? (by >> 4) : (by & 0xFu)];
        }
    }
};

/* IQ2_XXS: d, qs[32] u16. Sub-block ib: aux0 = four grid indices, aux1 = 4 x 7 sign bits and the
 * scale; db = d * (0.5 + (aux1 >> 28)) * 0.25; y = db * grid * (+-1). */
template <> struct Gg<GG_IQ2_XXS> {
    static constexpr int QK = 256, BB = 66, UPB = 8, NR = 3, TB = 2048;
    __device__ static __forceinline__ void load(const uint8_t* b, int u, uint32_t* r) {
        r[0] = gg_u16(b);
        r[1] = gg_d32a2(b + 2 + 8 * u);
        r[2] = gg_d32a2(b + 6 + 8 * u);
    }
    __device__ static __forceinline__ void load_w(const uint8_t* b, int u, uint32_t* r) {
        r[0] = gg_u16(b);
        const gg_u32x2 v = *(gg_gu64a2)(const void*)(b + 2 + 8 * u);
        r[1] = v.x;
        r[2] = v.y;
    }
    __device__ static __forceinline__ int goff(int u, int g) { return 32 * u + 8 * g; }
    template <int G>
    __device__ static __forceinline__ void dec(const uint32_t* r, int, const void* tab, float* w) {
        const uint32_t* grid = (const uint32_t*)tab;
        const float db = gg_h2f(r[0]) * (0.5f + (float)(r[2] >> 28)) * 0.25f;
        const uint32_t gi = gg_byte(r[1], G);
        const uint32_t lo = grid[2 * gi], hi = grid[2 * gi + 1];
        /* ksigns_iq2xs[s] = s with bit 7 the parity of s (an even count of minus signs). */
        const uint32_t sx = (r[2] >> (7 * G)) & 127u;
        const uint32_t sg = sx | ((__builtin_popcount(sx) & 1u) << 7);
#pragma unroll
        for (int t = 0; t < 8; ++t) {
            const float m = db * (float)gg_byte(t < 4 ? lo : hi, t % 4);
            w[t] = ((sg >> t) & 1u) ? -m : m;
        }
    }
};

/* IQ1_S: d, qs[32], qh[8] u16. Sub-block ib: dl = d * (2 ((qh >> 12) & 7) + 1), delta = -+0.125
 * by qh's top bit, grid index qs | 3 qh bits << 8; y = dl * (grid + delta). The table holds
 * grid + 1 (0, 1, 2), so grid + delta = byte + (delta - 1), exact either way. */
template <> struct Gg<GG_IQ1_S> {
    static constexpr int QK = 256, BB = 50, UPB = 8, NR = 3, TB = 16384;
    __device__ static __forceinline__ void load(const uint8_t* b, int u, uint32_t* r) {
        r[0] = gg_u16(b);
        r[1] = gg_d32a2(b + 2 + 4 * u);
        r[2] = gg_u16(b + 34 + 2 * u);
    }
    __device__ static __forceinline__ void load_w(const uint8_t* b, int u, uint32_t* r) {
        r[0] = gg_u16(b);
        r[1] = *(gg_gu32a2)(const void*)(b + 2 + 4 * u);
        r[2] = gg_u16(b + 34 + 2 * u);
    }
    __device__ static __forceinline__ int goff(int u, int g) { return 32 * u + 8 * g; }
    template <int G>
    __device__ static __forceinline__ void dec(const uint32_t* r, int, const void* tab, float* w) {
        const uint32_t* grid = (const uint32_t*)tab;
        const uint32_t qh = r[2];
        const float dl = gg_h2f(r[0]) * (float)(int)(2 * ((qh >> 12) & 7u) + 1);
        const float c = (qh & 0x8000u) ? -1.125f : -0.875f;
        const uint32_t gi = gg_byte(r[1], G) | (((qh >> (3 * G)) & 7u) << 8);
        const uint32_t lo = grid[2 * gi], hi = grid[2 * gi + 1];
#pragma unroll
        for (int t = 0; t < 8; ++t) w[t] = dl * ((float)gg_byte(t < 4 ? lo : hi, t % 4) + c);
    }
};

/* The float logical form: 32 values a unit, read as they are. */
template <> struct Gg<GG_F32> {
    static constexpr int QK = 32, BB = 128, UPB = 1, NR = 32, TB = 0;
    __device__ static __forceinline__ void load(const uint8_t* b, int, uint32_t* r) {
#pragma unroll
        for (int i = 0; i < 32; ++i) r[i] = gg_d32(b + 4 * i);
    }
    __device__ static __forceinline__ int goff(int, int g) { return 8 * g; }
    template <int G>
    __device__ static __forceinline__ void dec(const uint32_t* r, int, const void*, float* w) {
#pragma unroll
        for (int t = 0; t < 8; ++t) w[t] = __uint_as_float(r[8 * G + t]);
    }
};

/* The type's table into LDS at `lds`, by the whole block; the caller barriers. */
template <int T>
__device__ __forceinline__ void gg_load_table(uint8_t* lds) {
    constexpr int TB = Gg<T>::TB;
    if constexpr (TB > 0) {
        const r4d_u32x4* src = (T == GG_IQ1_S)    ? (const r4d_u32x4*)(const void*)kGgIq1sGridP1
                             : (T == GG_IQ2_XXS) ? (const r4d_u32x4*)(const void*)kGgIq2xxsGrid
                                                 : (const r4d_u32x4*)(const void*)kGgIq4nlValues;
        r4d_u32x4* dst = (r4d_u32x4*)lds;
        for (int i = (int)threadIdx.x; i < TB / 16; i += (int)blockDim.x) dst[i] = src[i];
    }
}

/* Eight bf16 activations widened to f32 (exact). `al`: the address is 16-byte aligned. */
__device__ __forceinline__ void gg_x8(const uint16_t* p, bool al, float* v) {
    uint32_t q[4];
    if (al) {
        const r4d_u32x4 t = *(gg_gu128)(const void*)p;
        q[0] = t[0]; q[1] = t[1]; q[2] = t[2]; q[3] = t[3];
    } else {
#pragma unroll
        for (int i = 0; i < 4; ++i) q[i] = ldg_u16(p + 2 * i) | (ldg_u16(p + 2 * i + 1) << 16);
    }
#pragma unroll
    for (int i = 0; i < 4; ++i) { v[2 * i] = bf16w_lo(q[i]); v[2 * i + 1] = bf16w_hi(q[i]); }
}

/* The same eight bf16 as four bf16-pair dwords, unconverted. */
__device__ __forceinline__ void gg_x8raw(const uint16_t* p, bool al, uint32_t* q) {
    if (al) {
        const r4d_u32x4 t = *(gg_gu128)(const void*)p;
        q[0] = t[0]; q[1] = t[1]; q[2] = t[2]; q[3] = t[3];
    } else {
#pragma unroll
        for (int i = 0; i < 4; ++i) q[i] = ldg_u16(p + 2 * i) | (ldg_u16(p + 2 * i + 1) << 16);
    }
}

/* Expert e's rows of the sorted order as libref assigns them: its binary search gives row i to
 * the last expert whose offset is <= i (expert 0 below off[0], the last one up to T), which for
 * moe_scatter's non-decreasing offsets is [off[e], off[e + 1]) with those two ends opened. */
__device__ __forceinline__ void gg_range(const int32_t* off, int e, int ne, int T, int* s, int* t) {
    int a = e == 0 ? 0 : off[e];
    int b = e == ne - 1 ? T : off[e + 1];
    a = a < 0 ? 0 : (a > T ? T : a);
    b = b < a ? a : (b > T ? T : b);
    *s = a;
    *t = b;
}

/* The activation row a sorted slot reads (a_order "token": sorted / top_k, "sorted": the slot),
 * or -1 for a dropped slot or a token past `a`: a row of zeros, as libref writes it. */
__device__ __forceinline__ int gg_moe_tok(const int32_t* sorted, int i, int top_k, int a_sorted, int AR) {
    const int flat = sorted[i];
    if (flat < 0) return -1;
    const int tok = a_sorted ? i : flat / top_k;
    return tok < AR ? tok : -1;
}

/* ================================================================== gemv (decode) */
constexpr int kGgWaves = 8;
constexpr int kGgThreads = 256;
constexpr int kGgXM = 8;                 /* activation rows a pass */
constexpr int kGgDecodeRows = 48;        /* gemm_nt_ggml / logits_gemm_ggml: rows the decode kernel takes */
constexpr int kGgMaxExpert = 1024;

struct GgGemvArgs {
    const uint16_t* x;
    long long x_ld;                      /* elements */
    const uint8_t* w;                    /* plain weight, or stacked experts */
    const uint8_t* const* wtab;          /* expert table (device pointers), or null */
    long long w_ld;                      /* bytes a weight row */
    long long w_es;                      /* bytes an expert (stacked) */
    void* y;
    long long y_ld;
    const int32_t* sorted;
    const int32_t* off;
    int M;                               /* GEMM: activation rows; MoE: output rows T */
    int N, K;
    int XM;                              /* activation rows a pass, <= kGgXM */
    int XLM;                             /* rows whose whole K fits the LDS buffer (0..XM) */
    int XR;                              /* floats a whole staged row (K plus its pad) */
    int KC;                              /* values a chunk when the pass's rows do not fit whole */
    int rgpi;                            /* row groups a work item */
    int ipe;                             /* work items an expert (GEMM: in all) */
    int n_expert, top_k, a_sorted, AR, x_al;
    int live_off, x_off;                 /* LDS byte offsets of the live list and the rows */
};

/* A staged row: its values with 4 floats of pad after every 32, so the eight lanes of a block's
 * sub-blocks read different banks. */
__device__ __forceinline__ int gg_xphys(int kk) { return kk + ((kk >> 5) << 2); }

/* The activation row a pass row reads (null: a dropped slot, a row of zeros). */
template <bool MOE>
__device__ __forceinline__ const uint16_t* gg_xrow(const GgGemvArgs& A, int i) {
    int row;
    if constexpr (MOE) row = gg_moe_tok(A.sorted, i, A.top_k, A.a_sorted, A.AR);
    else row = i;
    return row >= 0 ? A.x + (long long)row * A.x_ld : nullptr;
}

/* Values [k0, k1) of rows p0 .. p0 + mc - 1 widened into LDS by the block, `xr` floats a row. */
template <bool MOE>
__device__ __forceinline__ void gg_stage(const GgGemvArgs& A, float* xs, int p0, int mc, int k0,
                                         int k1, int xr) {
    const int c8n = (k1 - k0) >> 3;
    for (int idx = (int)threadIdx.x; idx < mc * c8n; idx += kGgThreads) {
        const int m = idx / c8n, kk = (idx - m * c8n) << 3;
        const uint16_t* xrow = gg_xrow<MOE>(A, p0 + m);
        float v[8];
        if (xrow) {
            gg_x8(xrow + k0 + kk, A.x_al != 0, v);
        } else {
#pragma unroll
            for (int t = 0; t < 8; ++t) v[t] = 0.0f;
        }
        float* d = xs + m * xr + gg_xphys(kk);
        *(float4*)d = make_float4(v[0], v[1], v[2], v[3]);
        *(float4*)(d + 4) = make_float4(v[4], v[5], v[6], v[7]);
    }
}

/* One unit of RPW rows into the sums; the staged rows hold values from kb on, xr floats a row. */
template <int T, int RPW>
__device__ __forceinline__ void gg_unit(const uint32_t (&raw)[RPW][Gg<T>::NR], int U,
                                        const float* xs, int xr, int kb, int mc, const void* tab,
                                        const bool (&ok)[RPW], float (&acc)[RPW][kGgXM]) {
    using Q = Gg<T>;
    const int b = U / Q::UPB, u = U - b * Q::UPB;
    gg_for<4>([&](auto gi) {
        constexpr int G = decltype(gi)::value;
        const int kk = b * Q::QK + Q::goff(u, G) - kb;
        float w[RPW][8];
#pragma unroll
        for (int r = 0; r < RPW; ++r)
            if (ok[r]) Q::template dec<G>(raw[r], u, tab, w[r]);
#pragma unroll
        for (int m = 0; m < kGgXM; ++m) {
            if (m < mc) {
                const float* xp = xs + m * xr + gg_xphys(kk);
                const float4 a = *(const float4*)xp;
                const float4 c = *(const float4*)(xp + 4);
                const float xv[8] = { a.x, a.y, a.z, a.w, c.x, c.y, c.z, c.w };
#pragma unroll
                for (int r = 0; r < RPW; ++r)
                    if (ok[r]) {
#pragma unroll
                        for (int t = 0; t < 8; ++t) acc[r][m] += xv[t] * w[r][t];
                    }
            }
        }
    });
}

/* Units [U0, U1) of rows n0.. into the sums: lane = unit mod 32 (U0 a multiple of 32), UF units
 * a lane in flight (eight for the three-word I-quant units, two for the K-quants' and q8_0's). A
 * lane's units and their order are the same whether K is staged whole or in chunks of a multiple
 * of 32 units, so the bits do not depend on M or on the path. */
template <int T, int RPW>
__device__ __forceinline__ void gg_row(const GgGemvArgs& A, const uint8_t* wb, const float* xs,
                                       int xr, int kb, int U0, int U1, int n0, int mc, int lane,
                                       const void* tab, float (&acc)[RPW][kGgXM]) {
    using Q = Gg<T>;
    constexpr int UF = Q::NR <= 4 ? (RPW == 1 ? 8 : 4) : 2;
    bool ok[RPW];
    const uint8_t* wr[RPW];
#pragma unroll
    for (int r = 0; r < RPW; ++r) {
        ok[r] = n0 + r < A.N;
        wr[r] = wb + (long long)(ok[r] ? n0 + r : 0) * A.w_ld;
    }
    for (int U = U0 + lane; U < U1; U += 32 * UF) {
        uint32_t raw[UF][RPW][Q::NR];
        gg_for<UF>([&](auto fi) {
            constexpr int F = decltype(fi)::value;
            const int V = U + 32 * F;
            if (V < U1) {
                const int b = V / Q::UPB;
#pragma unroll
                for (int r = 0; r < RPW; ++r)
                    if (ok[r]) Q::load(wr[r] + (long long)b * Q::BB, V - b * Q::UPB, raw[F][r]);
            }
        });
        gg_for<UF>([&](auto fi) {
            constexpr int F = decltype(fi)::value;
            const int V = U + 32 * F;
            if (V < U1) gg_unit<T, RPW>(raw[F], V, xs, xr, kb, mc, tab, ok, acc);
        });
    }
}

template <int T, int RPW, bool MOE, typename OT>
__global__ __launch_bounds__(kGgThreads) void gg_gemv_kernel(GgGemvArgs A) {
    using Q = Gg<T>;
    extern __shared__ __attribute__((aligned(16))) uint8_t gg_smem[];
    __shared__ int s_nlive;
    const int tid = (int)threadIdx.x, lane = tid & 31, wave = tid >> 5;
    gg_load_table<T>(gg_smem);
    const void* tab = gg_smem;
    int* live = (int*)(gg_smem + A.live_off);
    float* xs = (float*)(gg_smem + A.x_off);
    constexpr int RG = kGgWaves * RPW;
    const int nrg = (A.N + RG - 1) / RG;
    const int UK = A.K / Q::QK * Q::UPB;              /* units a row */
    const int XRC = A.KC + A.KC / 8;                  /* floats a chunked row */
    int n_items = A.ipe;
    if constexpr (MOE) {
        /* The experts with rows, in ascending order. */
        if (wave == 0) {
            int cnt = 0;
            for (int e0 = 0; e0 < A.n_expert; e0 += 32) {
                const int e = e0 + lane;
                int s = 0, t = 0;
                if (e < A.n_expert) gg_range(A.off, e, A.n_expert, A.M, &s, &t);
                const bool nz = e < A.n_expert && t > s;
                const uint32_t bal = __builtin_amdgcn_ballot_w32(nz);
                if (nz) live[cnt + __builtin_popcount(bal & ((1u << lane) - 1u))] = e;
                cnt += __builtin_popcount(bal);
            }
            if (lane == 0) s_nlive = cnt;
        }
        __syncthreads();
        n_items = s_nlive * A.ipe;
    } else {
        __syncthreads();
    }
    int cur_e = -1, cur_p = -1;                       /* the rows the LDS buffer holds whole */
    for (int it = (int)blockIdx.x; it < n_items; it += (int)gridDim.x) {
        int e = 0, ri = it, rs = 0, re = A.M;
        const uint8_t* wb = A.w;
        if constexpr (MOE) {
            e = live[it / A.ipe];
            ri = it - (it / A.ipe) * A.ipe;
            gg_range(A.off, e, A.n_expert, A.M, &rs, &re);
            wb = A.wtab ? A.wtab[e] : A.w + (long long)e * A.w_es;
        }
        const int rg0 = ri * A.rgpi, rg1 = min(rg0 + A.rgpi, nrg);
        for (int p0 = rs; p0 < re; p0 += A.XM) {
            const int mc = min(A.XM, re - p0);
            const bool whole = mc <= A.XLM;            /* block-uniform */
            if (whole && (cur_e != e || cur_p != p0)) {
                lds_barrier();
                gg_stage<MOE>(A, xs, p0, mc, 0, A.K, A.XR);
                lds_barrier();
                cur_e = e;
                cur_p = p0;
            }
            /* The pass's live rows (a dropped slot writes zeros), read once, not a row group. */
            uint32_t livem = (1u << mc) - 1u;
            if constexpr (MOE) {
                livem = 0;
                for (int m = 0; m < mc; ++m)
                    if (gg_moe_tok(A.sorted, p0 + m, A.top_k, A.a_sorted, A.AR) >= 0) livem |= 1u << m;
            }
            for (int rg = rg0; rg < rg1; ++rg) {
                const int n0 = rg * RG + wave * RPW;
                const bool active = n0 < A.N;          /* wave-uniform */
                float acc[RPW][kGgXM];
#pragma unroll
                for (int r = 0; r < RPW; ++r)
#pragma unroll
                    for (int m = 0; m < kGgXM; ++m) acc[r][m] = 0.0f;
                if (whole) {
                    if (active) gg_row<T, RPW>(A, wb, xs, A.XR, 0, 0, UK, n0, mc, lane, tab, acc);
                } else {
                    /* The pass's rows do not fit whole: K in chunks, restaged a row group (every
                     * wave takes part in the barriers). */
                    for (int k0 = 0; k0 < A.K; k0 += A.KC) {
                        const int k1 = min(k0 + A.KC, A.K);
                        lds_barrier();
                        gg_stage<MOE>(A, xs, p0, mc, k0, k1, XRC);
                        lds_barrier();
                        if (active)
                            gg_row<T, RPW>(A, wb, xs, XRC, k0, k0 / Q::QK * Q::UPB, k1 / Q::QK * Q::UPB,
                                           n0, mc, lane, tab, acc);
                    }
                    cur_e = -1;
                }
                if (!active) continue;
#pragma unroll
                for (int r = 0; r < RPW; ++r) {
                    const int n = n0 + r;
                    if (n >= A.N) continue;
#pragma unroll
                    for (int m = 0; m < kGgXM; ++m) {
                        if (m >= mc) continue;
                        const float v = r4d_wave_sum(acc[r][m]);
                        if (lane == 0)
                            gg_put((OT*)A.y + (long long)(p0 + m) * A.y_ld + n, ((livem >> m) & 1u) ? v : 0.0f);
                    }
                }
            }
        }
    }
}

/* ================================================================== moe decode
 *
 * gg_md_kernel, moe_gemm_ggml's decode band (up to kMdMaxT sorted rows). Each block reads the
 * routing itself: a row's expert by libref's binary search over the offsets, the row dead when its
 * slot is dropped or its token lies past `a`. The live rows (in sorted order, so grouped by
 * expert) are cut into segments of at most XM consecutive rows of one expert, and a segment's
 * work is its expert's N weight rows in tasks of RPW rows. The grid's waves split all the tasks
 * evenly, each a contiguous run, so an expert without live rows costs nothing, a live one is
 * streamed once a segment, and the experts of a step stream side by side. The dead rows are
 * zeroed by all the blocks together.
 *
 * A block's tasks sit in one or a few consecutive segments; it stages their activation rows (all
 * that fit XB rows of LDS) once, widened to f32, then its waves stream their tasks: every lane
 * loads its units of all RPW rows at once (one round trip a task), and decodes them against the
 * staged rows, the grid table in LDS. Per output the arithmetic is gg_gemv_kernel's to the bit:
 * lane = unit mod 32, the lane's units in order, the same butterfly, and the same dequantised
 * values (the I-quants by an exact rearrangement, md_unit_iq1s / md_unit_iq2xxs), so this path,
 * the old one and gemm_nt_ggml's gemv agree on every bit. */
constexpr int kMdMaxT = 288;             /* sorted rows a launch: 48 tokens at top-6 */
constexpr int kMdXM = 4;                 /* rows a segment at most (the sums a lane keeps a row) */
constexpr long long kMdLds = 65536;      /* LDS a block at most */

struct GgMdArgs {
    const uint16_t* x;
    long long x_ld;
    const uint8_t* w;                    /* stacked experts, or null */
    const uint8_t* const* wtab;          /* the expert table, or null */
    long long w_ld, w_es;                /* bytes a weight row, an expert */
    uint16_t* y;
    long long y_ld;
    const int32_t* sorted;
    const int32_t* off;
    int T, N, K;                         /* T: sorted (output) rows */
    int n_expert, top_k, a_sorted, AR, x_al;
    int XB;                              /* activation rows the LDS buffer holds */
    int XM;                              /* rows a segment, <= min(XB, kMdXM) */
    int meta_off, x_off;                 /* LDS byte offsets */
    int raw_off, raw_wave;               /* the waves' chunk buffers (md_step_stg), or -1 */
    int xs_off;                          /* the dot path's unit sums of the staged rows (IQ1_S) */
};

/* Where a staged row keeps value k in LDS, so that the lanes of a wave (lane = unit mod 32, all
 * reading group G of their units) hit distinct banks. f32 rows: k a multiple of 4, the 16-byte
 * chunks of each 32-float line permuted by line / 2; eight values from a multiple of 8 are two
 * chunks. bf16 rows: eight values from a multiple of 8 are one chunk, permuted by line / 4. */
__device__ __forceinline__ int gg_xswz(int k) {
    return (k & ~31) | ((((k >> 2) ^ (k >> 6)) & 7) << 2);
}
__device__ __forceinline__ int gg_xswz16(int k) {
    const int q = k >> 3;
    return (q ^ ((q >> 4) & 3)) << 3;
}

/* IEEE half -> float by the hardware conversion: exact for zeros, subnormals, normals and
 * infinities (f16 denormals are kept); a NaN comes out quiet. */
__device__ __forceinline__ float gg_h2f_hw(uint32_t h) {
    return (float)__builtin_bit_cast(_Float16, (uint16_t)h);
}

/* The mc (<= XMX) staged rows' eight values at k .. k + 7: f32 rows when XMX is 1, bf16 rows
 * (widened here, exactly) above. */
template <int XMX>
__device__ __forceinline__ void md_x8(const float* xs, int K, int k, int mc, float (&xv)[XMX][8]) {
    if constexpr (XMX == 1) {
        const float4 a = *(const float4*)(xs + gg_xswz(k));
        const float4 c = *(const float4*)(xs + gg_xswz(k + 4));
        xv[0][0] = a.x; xv[0][1] = a.y; xv[0][2] = a.z; xv[0][3] = a.w;
        xv[0][4] = c.x; xv[0][5] = c.y; xv[0][6] = c.z; xv[0][7] = c.w;
    } else {
        const uint16_t* xb = (const uint16_t*)(const void*)xs;
        const int p = gg_xswz16(k);
#pragma unroll
        for (int m = 0; m < XMX; ++m) {
            if (m < mc) {
                const r4d_u32x4 v = *(const r4d_u32x4*)(const void*)(xb + m * K + p);
#pragma unroll
                for (int i = 0; i < 4; ++i) {
                    xv[m][2 * i] = bf16w_lo(v[i]);
                    xv[m][2 * i + 1] = bf16w_hi(v[i]);
                }
            }
        }
    }
}

/* One weight row's eight values into its sums, value by value (gg_unit's order). */
template <int XMX>
__device__ __forceinline__ void md_acc(const float (&w)[8], const float (&xv)[XMX][8], int mc,
                                       float (&acc)[XMX]) {
#pragma unroll
    for (int m = 0; m < XMX; ++m) {
        if (XMX == 1 || m < mc) {
#pragma unroll
            for (int t = 0; t < 8; ++t) acc[m] += xv[m][t] * w[t];
        }
    }
}

/* One unit of RPW rows by the type's own dec (any type; the I-quants' path for a block whose d is
 * an infinity or a NaN). */
template <int T, int RPW, int XMX, bool SER = false>
__device__ __forceinline__ void md_unit(const uint32_t (&raw)[RPW][Gg<T>::NR], int U, const float* xs,
                                        int K, int mc, const void* tab, const bool (&ok)[RPW],
                                        float (&acc)[RPW][XMX]) {
    using Q = Gg<T>;
    const int b = U / Q::UPB, u = U - b * Q::UPB;
    gg_for<4>([&](auto gi) {
        constexpr int G = decltype(gi)::value;
        float xv[XMX][8];
        md_x8<XMX>(xs, K, b * Q::QK + Q::goff(u, G), mc, xv);
#pragma unroll
        for (int r = 0; r < RPW; ++r)
            if (ok[r]) {
                if constexpr (SER) sched_barrier();   /* a rare path: keep it narrow */
                float w[8];
                Q::template dec<G>(raw[r], u, tab, w);
                md_acc<XMX>(w, xv, mc, acc[r]);
            }
    });
}

/* IQ1_S, a finite d: Gg<IQ1_S>::dec's dl * (byte + c) is exact (dl = d (2s + 1) has at most 15
 * significant bits, byte + c is one of +-1/8, +-7/8, +-9/8), so fma(byte, dl, dl * c) -- an exact
 * product plus an exact dl * c, whose sum is representable -- is the same float, in two
 * operations instead of three. (Not for an infinite dl: 0 * inf; md_task routes those blocks to
 * md_unit.) */
template <int RPW, int XMX>
__device__ __forceinline__ void md_unit_iq1s(const uint32_t (&raw)[RPW][3], int U, const float* xs,
                                             int K, int mc, const uint32_t* grid,
                                             const bool (&ok)[RPW], float (&acc)[RPW][XMX]) {
    gg_for<4>([&](auto gi) {
        constexpr int G = decltype(gi)::value;
        float xv[XMX][8];
        md_x8<XMX>(xs, K, 32 * U + 8 * G, mc, xv);
#pragma unroll
        for (int r = 0; r < RPW; ++r)
            if (ok[r]) {
                const uint32_t qh = raw[r][2];
                const float dl = gg_h2f_hw(raw[r][0]) * (float)(int)(2 * ((qh >> 12) & 7u) + 1);
                const float dlc = dl * ((qh & 0x8000u) ? -1.125f : -0.875f);
                const uint32_t ix = gg_byte(raw[r][1], G) | (((qh >> (3 * G)) & 7u) << 8);
                const uint2 g = *(const uint2*)(grid + 2 * ix);
                float w[8];
#pragma unroll
                for (int t = 0; t < 8; ++t) w[t] = fmaf((float)gg_byte(t < 4 ? g.x : g.y, t % 4), dl, dlc);
                md_acc<XMX>(w, xv, mc, acc[r]);
            }
    });
}

/* IQ2_XXS: Gg<IQ2_XXS>::dec's m = db * grid, negated by the sign bit, is |db| * grid with the sign
 * (sign bit) xor (db's sign) inserted -- the same bits, NaN and zeros included -- so the sign costs
 * a shift and a bit insert. */
template <int RPW, int XMX>
__device__ __forceinline__ void md_unit_iq2xxs(const uint32_t (&raw)[RPW][3], int U, const float* xs,
                                               int K, int mc, const uint32_t* grid,
                                               const bool (&ok)[RPW], float (&acc)[RPW][XMX]) {
    gg_for<4>([&](auto gi) {
        constexpr int G = decltype(gi)::value;
        float xv[XMX][8];
        md_x8<XMX>(xs, K, 32 * U + 8 * G, mc, xv);
#pragma unroll
        for (int r = 0; r < RPW; ++r)
            if (ok[r]) {
                const float db = gg_h2f_hw(raw[r][0]) * (0.5f + (float)(raw[r][2] >> 28)) * 0.25f;
                const float adb = fabsf(db);
                const uint32_t dsg = (__float_as_uint(db) >> 31) ? 0xffu : 0u;
                const uint2 g = *(const uint2*)(grid + 2 * gg_byte(raw[r][1], G));
                const uint32_t sx = (raw[r][2] >> (7 * G)) & 127u;
                const uint32_t sg = (sx | ((__builtin_popcount(sx) & 1u) << 7)) ^ dsg;
                float w[8];
#pragma unroll
                for (int t = 0; t < 8; ++t) {
                    const float m = adb * (float)gg_byte(t < 4 ? g.x : g.y, t % 4);
                    w[t] = __uint_as_float((__float_as_uint(m) & 0x7fffffffu) | ((sg << (31 - t)) & 0x80000000u));
                }
                md_acc<XMX>(w, xv, mc, acc[r]);
            }
    });
}

/* One step of md_task: the lane's units U, U + 32, ... (UF of them) of its RPW rows. NF > 0: every
 * row exists, and so do the first NF units of every lane (no guards there: straight code the
 * scheduler can interleave); NF = 0: all guarded. */
template <int T, int RPW, int UF, int XMX, int NF>
__device__ __forceinline__ void md_step(const uint8_t* const (&wr)[RPW], const bool (&okr)[RPW], int U,
                                        int UK, const float* xs, int K, int mc, const void* tab,
                                        float (&acc)[RPW][XMX]) {
    using Q = Gg<T>;
    bool ok[RPW];
#pragma unroll
    for (int r = 0; r < RPW; ++r) ok[r] = NF > 0 || okr[r];
    uint32_t raw[UF][RPW][Q::NR];
    gg_for<UF>([&](auto fi) {
        constexpr int F = decltype(fi)::value;
        const int V = U + 32 * F;
        if (F < NF || V < UK) {
            const int b = V / Q::UPB;
#pragma unroll
            for (int r = 0; r < RPW; ++r)
                if (ok[r]) {
                    if constexpr (T == GG_IQ1_S || T == GG_IQ2_XXS)
                        Q::load_w(wr[r] + (long long)b * Q::BB, V - b * Q::UPB, raw[F][r]);
                    else
                        Q::load(wr[r] + (long long)b * Q::BB, V - b * Q::UPB, raw[F][r]);
                }
        }
    });
    bool fast = T == GG_IQ2_XXS;
    if constexpr (T == GG_IQ1_S) {
        bool bad = false;
        gg_for<UF>([&](auto fi) {
            constexpr int F = decltype(fi)::value;
            if (F < NF || U + 32 * F < UK) {
#pragma unroll
                for (int r = 0; r < RPW; ++r)
                    if (ok[r]) bad |= (raw[F][r][0] & 0x7c00u) == 0x7c00u;
            }
        });
        fast = __builtin_amdgcn_ballot_w32(bad) == 0u;
    }
    if (fast) {
        if constexpr (T == GG_IQ1_S || T == GG_IQ2_XXS) {
            gg_for<UF>([&](auto fi) {
                constexpr int F = decltype(fi)::value;
                const int V = U + 32 * F;
                /* Unit by unit: the loads above stay in flight together, but one unit's LDS reads
                 * are not hoisted over another's (that would hold every unit's activations). */
                if constexpr (F < NF) sched_barrier();
                if (F < NF || V < UK) {
                    if constexpr (T == GG_IQ1_S)
                        md_unit_iq1s<RPW, XMX>(raw[F], V, xs, K, mc, (const uint32_t*)tab, ok, acc);
                    else
                        md_unit_iq2xxs<RPW, XMX>(raw[F], V, xs, K, mc, (const uint32_t*)tab, ok, acc);
                }
            });
        }
    } else {
        gg_for<UF>([&](auto fi) {
            constexpr int F = decltype(fi)::value;
            const int V = U + 32 * F;
            if constexpr (F < NF) sched_barrier();
            if (F < NF || V < UK)
                md_unit<T, RPW, XMX, (T == GG_IQ1_S)>(raw[F], V, xs, K, mc, tab, ok, acc);
        });
    }
}

/* md_step for the I-quants through a wave-private LDS chunk: the first NFS of the lane's units are
 * whole 4-block chunks of each of the RPW rows (32 units, 4 * BB contiguous bytes a row), which
 * the wave reads with 8-byte loads at consecutive addresses -- every byte once, the fewest load
 * instructions, and each line of a host-pool expert crosses the link once -- then hands out
 * through LDS, unit by unit, as md_step's raw words. Units past NFS load directly (guarded). The
 * values and their order are md_step's. */
__device__ __forceinline__ uint32_t md_l16(const uint8_t* p) { return *(const uint16_t*)(const void*)p; }

/* A wave-uniform pointer kept in scalar registers (loads then take it as their base). */
__device__ __forceinline__ const uint8_t* md_uniform(const uint8_t* p) {
    const unsigned long long v = (unsigned long long)p;
    const unsigned lo = (unsigned)__builtin_amdgcn_readfirstlane((int)(unsigned)v);
    const unsigned hi = (unsigned)__builtin_amdgcn_readfirstlane((int)(unsigned)(v >> 32));
    return (const uint8_t*)(((unsigned long long)hi << 32) | lo);
}

template <int T, int RPW, int UF, int XMX, int NFS>
__device__ __forceinline__ void md_step_stg(const uint8_t* w0, long long w_ld, int U0, int lane, int UK,
                                            const float* xs, int K, int mc, const void* tab, uint8_t* buf,
                                            float (&acc)[RPW][XMX]) {
    using Q = Gg<T>;
    static_assert(T == GG_IQ1_S || T == GG_IQ2_XXS, "the three-word I-quants");
    constexpr int CB = 4 * Q::BB, CBP = (CB + 15) / 16 * 16, LPR = CB / 8, NS = RPW * LPR;
    constexpr int NJ = (NS + 31) / 32, NT_ = UF - NFS > 0 ? UF - NFS : 1;
    static_assert(CB % 8 == 0, "a chunk is whole 8-byte pieces");
    const int b0 = U0 >> 3;
    const uint8_t* cb = w0 + (long long)b0 * Q::BB;       /* uniform: a scalar base */
    bool sv[NJ];
    int go[NJ], ro[NJ];
#pragma unroll
    for (int j = 0; j < NJ; ++j) {
        const int idx = lane + 32 * j;
        sv[j] = idx < NS;
        const int r = sv[j] ? idx / LPR : 0, l = idx - r * LPR;
        go[j] = r * (int)w_ld + 8 * l;
        ro[j] = r * CBP + 8 * l;
    }
    gg_u32x2 g[NFS > 0 ? NFS : 1][NJ];
    gg_for<NFS>([&](auto fi) {
        constexpr int F = decltype(fi)::value;
#pragma unroll
        for (int j = 0; j < NJ; ++j)
            if (sv[j]) g[F][j] = *(gg_gu64a2)(const void*)(cb + (go[j] + 4 * F * Q::BB));
    });
    uint32_t rawt[NT_][RPW][Q::NR];
    gg_for<UF - NFS>([&](auto fi) {
        constexpr int F = decltype(fi)::value + NFS;
        const int V = U0 + lane + 32 * F;
        if (V < UK) {
            const int b = V / Q::UPB;
#pragma unroll
            for (int r = 0; r < RPW; ++r)
                Q::load_w(w0 + (long long)r * w_ld + (long long)b * Q::BB, V - b * Q::UPB, rawt[F - NFS][r]);
        }
    });
    bool ok[RPW];
#pragma unroll
    for (int r = 0; r < RPW; ++r) ok[r] = true;
    const int beta = lane >> 3, sub = lane & 7;
    auto run = [&](const uint32_t (&raw)[RPW][3], int V) {
        bool fast = T == GG_IQ2_XXS;
        if constexpr (T == GG_IQ1_S) {
            bool bad = false;
#pragma unroll
            for (int r = 0; r < RPW; ++r) bad |= (raw[r][0] & 0x7c00u) == 0x7c00u;
            fast = __builtin_amdgcn_ballot_w32(bad) == 0u;
        }
        if (fast) {
            if constexpr (T == GG_IQ1_S)
                md_unit_iq1s<RPW, XMX>(raw, V, xs, K, mc, (const uint32_t*)tab, ok, acc);
            else
                md_unit_iq2xxs<RPW, XMX>(raw, V, xs, K, mc, (const uint32_t*)tab, ok, acc);
        } else {
            md_unit<T, RPW, XMX, true>(raw, V, xs, K, mc, tab, ok, acc);
        }
    };
    gg_for<NFS>([&](auto fi) {
        constexpr int F = decltype(fi)::value;
        sched_barrier();
#pragma unroll
        for (int j = 0; j < NJ; ++j)
            if (sv[j]) *(gg_u32x2*)(void*)(buf + ro[j]) = g[F][j];
        uint32_t raw[RPW][3];
#pragma unroll
        for (int r = 0; r < RPW; ++r) {
            const uint8_t* bp = buf + r * CBP + beta * Q::BB;
            raw[r][0] = md_l16(bp);
            if constexpr (T == GG_IQ1_S) {
                raw[r][1] = md_l16(bp + 2 + 4 * sub) | (md_l16(bp + 4 + 4 * sub) << 16);
                raw[r][2] = md_l16(bp + 34 + 2 * sub);
            } else {
                raw[r][1] = md_l16(bp + 2 + 8 * sub) | (md_l16(bp + 4 + 8 * sub) << 16);
                raw[r][2] = md_l16(bp + 6 + 8 * sub) | (md_l16(bp + 8 + 8 * sub) << 16);
            }
        }
        run(raw, U0 + lane + 32 * F);
    });
    gg_for<UF - NFS>([&](auto fi) {
        constexpr int F = decltype(fi)::value + NFS;
        const int V = U0 + lane + 32 * F;
        sched_barrier();
        if (V < UK) run(rawt[F - NFS], V);
    });
}

/* RPW weight rows from n0 of the expert at wb against the mc staged rows at xs: lane = unit mod
 * 32 as gg_row, every unit of the lane's rows loaded before the first is decoded (UF of them a
 * lane a row, UF * 32 >= the row's units for the real shapes). */
template <int T, int RPW, int UF, int XMX>
__device__ __forceinline__ void md_task(const uint8_t* wb, long long w_ld, int n0, int N, int UK,
                                        const float* xs, int K, int mc, int lane, const void* tab,
                                        uint8_t* buf, float (&acc)[RPW][XMX]) {
    bool ok[RPW];
    const uint8_t* wr[RPW];
#pragma unroll
    for (int r = 0; r < RPW; ++r) {
        ok[r] = n0 + r < N;
        wr[r] = wb + (long long)(ok[r] ? n0 + r : 0) * w_ld;
    }
    const bool fullr = n0 + RPW <= N;
    for (int U0 = 0; U0 < UK; U0 += 32 * UF) {
        const int nf = fullr ? (UK - U0) >> 5 : 0;      /* units every lane has, this step */
        if constexpr (T == GG_IQ1_S || T == GG_IQ2_XXS) {
            if (buf && nf >= UF) {
                md_step_stg<T, RPW, UF, XMX, UF>(wr[0], w_ld, U0, lane, UK, xs, K, mc, tab, buf, acc);
                continue;
            }
            if (buf && UF > 1 && nf == UF - 1) {
                md_step_stg<T, RPW, UF, XMX, (UF > 1 ? UF - 1 : 0)>(wr[0], w_ld, U0, lane, UK, xs, K, mc, tab, buf, acc);
                continue;
            }
        }
        if (nf >= UF)
            md_step<T, RPW, UF, XMX, UF>(wr, ok, U0 + lane, UK, xs, K, mc, tab, acc);
        else if (UF > 1 && nf == UF - 1)
            md_step<T, RPW, UF, XMX, (UF > 1 ? UF - 1 : 0)>(wr, ok, U0 + lane, UK, xs, K, mc, tab, acc);
        else
            md_step<T, RPW, UF, XMX, 0>(wr, ok, U0 + lane, UK, xs, K, mc, tab, acc);
    }
}

/* ------------------------------------------------------------------ the I-quants' dot path
 * IQ1_S and IQ2_XXS against the staged bf16 rows by v_dot2_f32_bf16. The grid values (IQ1_S's
 * -1, 0, 1; IQ2_XXS's 8, 25, 43 with the signs xor-ed in) are exact in bf16 and so is every
 * product; a unit's 32 values sum pairwise into one f32 and the unit's scale applies once:
 * IQ1_S dl (sum x g + delta sum x) (sum x: the staged row's unit sums, kept beside it), IQ2_XXS
 * db sum x g. The weights are libref's floats (dl (g + delta), db g); only the rounding order
 * differs, so this path is within reduction-order tolerance of libref (not bit-equal to the
 * gemv). A step whose units hold a non-finite d, or a phase whose staged rows hold a non-finite
 * value (or IQ1_S unit sum), runs mdd_unit_exact: gg_gemv_kernel's per-value arithmetic.
 * Tables in LDS: IQ1_S 2048 x 8 bf16 (32 KiB); IQ2_XXS 256 x 8 bf16, then 128 sign masks (by the
 * seven stored sign bits, the eighth their parity: the xor of the eight signs as four bf16 pairs). */
constexpr int kMddTab1 = 2048 * 16, kMddTab2 = 256 * 16 + 128 * 16;
typedef __bf16 gg_bf16x2 __attribute__((ext_vector_type(2)));

__device__ __forceinline__ float mdd_dot2(uint32_t a, uint32_t b, float c) {
    return __builtin_amdgcn_fdot2_f32_bf16(__builtin_bit_cast(gg_bf16x2, a), __builtin_bit_cast(gg_bf16x2, b), c,
                                           false);
}
/* bf16 bits of a small integer (exact). */
__device__ __forceinline__ uint32_t mdd_bfi(int v) { return __float_as_uint((float)v) >> 16; }

template <int T>
__device__ __forceinline__ void mdd_load_table(uint8_t* lds) {
    const int tid = (int)threadIdx.x, nt = (int)blockDim.x;
    r4d_u32x4* dst = (r4d_u32x4*)(void*)lds;
    constexpr int NE = T == GG_IQ1_S ? 2048 : 256;
    for (int i = tid; i < NE; i += nt) {
        uint64_t e;
        if constexpr (T == GG_IQ1_S) e = kGgIq1sGridP1[i];
        else e = kGgIq2xxsGrid[i];
        r4d_u32x4 v;
#pragma unroll
        for (int j = 0; j < 4; ++j) {
            int b0 = (int)((e >> (16 * j)) & 0xffu), b1 = (int)((e >> (16 * j + 8)) & 0xffu);
            if constexpr (T == GG_IQ1_S) { b0 -= 1; b1 -= 1; }      /* the table holds grid + 1 */
            v[j] = mdd_bfi(b0) | (mdd_bfi(b1) << 16);
        }
        dst[i] = v;
    }
    if constexpr (T == GG_IQ2_XXS) {
        for (int i = tid; i < 128; i += nt) {
            const uint32_t sg = (uint32_t)i | ((__builtin_popcount((uint32_t)i) & 1u) << 7);
            r4d_u32x4 v;
#pragma unroll
            for (int j = 0; j < 4; ++j) v[j] = (((sg >> (2 * j)) & 1u) << 15) | (((sg >> (2 * j + 1)) & 1u) << 31);
            ((r4d_u32x4*)(void*)(lds + 256 * 16))[i] = v;
        }
    }
}

/* A unit's 32 staged values of the mc rows as bf16 pairs (16 dwords a row). */
template <int XMX>
__device__ __forceinline__ void mdd_x32(const uint16_t* xb, int K, int V, int mc, uint32_t (&xv)[XMX][16]) {
#pragma unroll
    for (int m = 0; m < XMX; ++m)
        if (XMX == 1 || m < mc) {
#pragma unroll
            for (int G = 0; G < 4; ++G) {
                const r4d_u32x4 v = *(const r4d_u32x4*)(const void*)(xb + m * K + gg_xswz16(32 * V + 8 * G));
#pragma unroll
                for (int i = 0; i < 4; ++i) xv[m][4 * G + i] = v[i];
            }
        }
}

template <int T, int RPW, int XMX>
__device__ __forceinline__ void mdd_unit(const uint32_t (&raw)[RPW][3], int V, const uint16_t* xb, const float* xsm,
                                         int K, int UK, int mc, const uint8_t* tab, const bool (&ok)[RPW],
                                         float (&acc)[RPW][XMX]) {
    uint32_t xv[XMX][16];
    mdd_x32<XMX>(xb, K, V, mc, xv);
    float xs[XMX];
#pragma unroll
    for (int m = 0; m < XMX; ++m) xs[m] = 0.0f;
    if constexpr (T == GG_IQ1_S) {
#pragma unroll
        for (int m = 0; m < XMX; ++m)
            if (XMX == 1 || m < mc) xs[m] = xsm[m * UK + V];
    }
    const r4d_u32x4* t4 = (const r4d_u32x4*)(const void*)tab;
#pragma unroll
    for (int r = 0; r < RPW; ++r) {
        if (!ok[r]) continue;
        float s[XMX];
#pragma unroll
        for (int m = 0; m < XMX; ++m) s[m] = 0.0f;
        float sc, dc = 0.0f;
        if constexpr (T == GG_IQ1_S) {
            const uint32_t qh = raw[r][2];
            sc = gg_h2f_hw(raw[r][0]) * (float)(int)(2 * ((qh >> 12) & 7u) + 1);
            dc = (qh & 0x8000u) ? -0.125f : 0.125f;
            gg_for<4>([&](auto gi) {
                constexpr int G = decltype(gi)::value;
                const r4d_u32x4 g = t4[gg_byte(raw[r][1], G) | (((qh >> (3 * G)) & 7u) << 8)];
#pragma unroll
                for (int m = 0; m < XMX; ++m)
                    if (XMX == 1 || m < mc) {
#pragma unroll
                        for (int i = 0; i < 4; ++i) s[m] = mdd_dot2(xv[m][4 * G + i], g[i], s[m]);
                    }
            });
        } else {
            const uint32_t a1 = raw[r][2];
            sc = gg_h2f_hw(raw[r][0]) * (0.5f + (float)(a1 >> 28)) * 0.25f;
            gg_for<4>([&](auto gi) {
                constexpr int G = decltype(gi)::value;
                r4d_u32x4 g = t4[gg_byte(raw[r][1], G)];
                g ^= t4[256 + ((a1 >> (7 * G)) & 127u)];
#pragma unroll
                for (int m = 0; m < XMX; ++m)
                    if (XMX == 1 || m < mc) {
#pragma unroll
                        for (int i = 0; i < 4; ++i) s[m] = mdd_dot2(xv[m][4 * G + i], g[i], s[m]);
                    }
            });
        }
#pragma unroll
        for (int m = 0; m < XMX; ++m)
            if (XMX == 1 || m < mc) {
                const float u = T == GG_IQ1_S ? fmaf(dc, xs[m], s[m]) : s[m];
                acc[r][m] = fmaf(sc, u, acc[r][m]);
            }
    }
}

/* mdd_unit for one row whose 32 values (xv, bf16 pairs) and sum (xs) the lane keeps in registers
 * across the tasks of a run; two partial sums a row (groups 0, 2 and 1, 3). */
template <int T, int RPW>
__device__ __forceinline__ void mdd_unit_r(const uint32_t (&raw)[RPW][3], const uint32_t (&xv)[16], float xs,
                                           const uint8_t* tab, float (&acc)[RPW][1]) {
    const r4d_u32x4* t4 = (const r4d_u32x4*)(const void*)tab;
#pragma unroll
    for (int r = 0; r < RPW; ++r) {
        if (r > 0) sched_barrier();      /* a row's table reads at a time (registers) */
        float s2[2] = { 0.0f, 0.0f };
        if constexpr (T == GG_IQ1_S) {
            const uint32_t qh = raw[r][2];
            gg_for<4>([&](auto gi) {
                constexpr int G = decltype(gi)::value;
                const r4d_u32x4 g = t4[gg_byte(raw[r][1], G) | (((qh >> (3 * G)) & 7u) << 8)];
#pragma unroll
                for (int i = 0; i < 4; ++i) s2[G & 1] = mdd_dot2(xv[4 * G + i], g[i], s2[G & 1]);
            });
            const float sc = gg_h2f_hw(raw[r][0]) * (float)(int)(2 * ((qh >> 12) & 7u) + 1);
            const float dc = (qh & 0x8000u) ? -0.125f : 0.125f;
            acc[r][0] = fmaf(sc, fmaf(dc, xs, s2[0] + s2[1]), acc[r][0]);
        } else {
            const uint32_t a1 = raw[r][2];
            gg_for<4>([&](auto gi) {
                constexpr int G = decltype(gi)::value;
                r4d_u32x4 g = t4[gg_byte(raw[r][1], G)];
                g ^= t4[256 + ((a1 >> (7 * G)) & 127u)];
#pragma unroll
                for (int i = 0; i < 4; ++i) s2[G & 1] = mdd_dot2(xv[4 * G + i], g[i], s2[G & 1]);
            });
            const float sc = gg_h2f_hw(raw[r][0]) * (0.5f + (float)(a1 >> 28)) * 0.25f;
            acc[r][0] = fmaf(sc, s2[0] + s2[1], acc[r][0]);
        }
    }
}

/* The exact unit: each value dequantised as Gg<T>::dec does (the same float) and multiplied and
 * added in order, as gg_unit. */
template <int T, int RPW, int XMX>
__device__ __forceinline__ void mdd_unit_exact(const uint32_t (&raw)[RPW][3], int V, const uint16_t* xb, int K,
                                               int mc, const uint8_t* tab, const bool (&ok)[RPW],
                                               float (&acc)[RPW][XMX]) {
    const r4d_u32x4* t4 = (const r4d_u32x4*)(const void*)tab;
    gg_for<4>([&](auto gi) {
        constexpr int G = decltype(gi)::value;
        float xv[XMX][8];
#pragma unroll
        for (int m = 0; m < XMX; ++m)
            if (XMX == 1 || m < mc) {
                const r4d_u32x4 v = *(const r4d_u32x4*)(const void*)(xb + m * K + gg_xswz16(32 * V + 8 * G));
#pragma unroll
                for (int i = 0; i < 4; ++i) { xv[m][2 * i] = bf16w_lo(v[i]); xv[m][2 * i + 1] = bf16w_hi(v[i]); }
            }
#pragma unroll
        for (int r = 0; r < RPW; ++r)
            if (ok[r]) {
                sched_barrier();
                float w[8];
                if constexpr (T == GG_IQ1_S) {
                    const uint32_t qh = raw[r][2];
                    const float dl = gg_h2f(raw[r][0]) * (float)(int)(2 * ((qh >> 12) & 7u) + 1);
                    const float dt = (qh & 0x8000u) ? -0.125f : 0.125f;
                    const r4d_u32x4 g = t4[gg_byte(raw[r][1], G) | (((qh >> (3 * G)) & 7u) << 8)];
#pragma unroll
                    for (int t = 0; t < 8; ++t)
                        w[t] = dl * (((t & 1) ? bf16w_hi(g[t >> 1]) : bf16w_lo(g[t >> 1])) + dt);
                } else {
                    const float db = gg_h2f(raw[r][0]) * (0.5f + (float)(raw[r][2] >> 28)) * 0.25f;
                    const r4d_u32x4 g = t4[gg_byte(raw[r][1], G)];
                    const uint32_t sx = (raw[r][2] >> (7 * G)) & 127u;
                    const uint32_t sg = sx | ((__builtin_popcount(sx) & 1u) << 7);
#pragma unroll
                    for (int t = 0; t < 8; ++t) {
                        const float m = db * ((t & 1) ? bf16w_hi(g[t >> 1]) : bf16w_lo(g[t >> 1]));
                        w[t] = ((sg >> t) & 1u) ? -m : m;
                    }
                }
                md_acc<XMX>(w, xv, mc, acc[r]);
            }
    });
}

/* One step: the lane's units U, U + 32, ... (UF of them) of its RPW rows, all loaded before the
 * first is used (one round trip). NF as md_step. */
template <int T, int RPW, int UF, int XMX, int NF>
__device__ __forceinline__ void mdd_step(const uint8_t* const (&wr)[RPW], const bool (&okr)[RPW], int U, int UK,
                                         const uint16_t* xb, const float* xsm, int K, int mc, const uint8_t* tab,
                                         bool xbad, float (&acc)[RPW][XMX]) {
    using Q = Gg<T>;
    bool ok[RPW];
#pragma unroll
    for (int r = 0; r < RPW; ++r) ok[r] = NF > 0 || okr[r];
    uint32_t raw[UF][RPW][3];
    gg_for<UF>([&](auto fi) {
        constexpr int F = decltype(fi)::value;
        const int V = U + 32 * F;
#pragma unroll
        for (int r = 0; r < RPW; ++r) raw[F][r][0] = raw[F][r][1] = raw[F][r][2] = 0u;
        if (F < NF || V < UK) {
            const int b = V >> 3;
#pragma unroll
            for (int r = 0; r < RPW; ++r)
                if (ok[r]) Q::load_w(wr[r] + (long long)b * Q::BB, V - 8 * b, raw[F][r]);
        }
    });
    bool bad = xbad;
    gg_for<UF>([&](auto fi) {
        constexpr int F = decltype(fi)::value;
        if (F < NF || U + 32 * F < UK) {
#pragma unroll
            for (int r = 0; r < RPW; ++r)
                if (ok[r]) bad |= (raw[F][r][0] & 0x7c00u) == 0x7c00u;
        }
    });
    const bool fast = __builtin_amdgcn_ballot_w32(bad) == 0u;
    gg_for<UF>([&](auto fi) {
        constexpr int F = decltype(fi)::value;
        const int V = U + 32 * F;
        if constexpr (F < NF) sched_barrier();
        if (F < NF || V < UK) {
            if (fast) {
                if constexpr (XMX == 1) {
                    uint32_t xv[16];
#pragma unroll
                    for (int G = 0; G < 4; ++G) {
                        const r4d_u32x4 v = *(const r4d_u32x4*)(const void*)(xb + gg_xswz16(32 * V + 8 * G));
#pragma unroll
                        for (int i = 0; i < 4; ++i) xv[4 * G + i] = v[i];
                    }
                    mdd_unit_r<T, RPW>(raw[F], xv, T == GG_IQ1_S ? xsm[V] : 0.0f, tab, acc);
                } else {
                    mdd_unit<T, RPW, XMX>(raw[F], V, xb, xsm, K, UK, mc, tab, ok, acc);
                }
            } else {
                mdd_unit_exact<T, RPW, XMX>(raw[F], V, xb, K, mc, tab, ok, acc);
            }
        }
    });
}

template <int T, int RPW, int UF, int XMX>
__device__ __forceinline__ void mdd_task(const uint8_t* wb, long long w_ld, int n0, int N, int UK, const uint16_t* xb,
                                         const float* xsm, int K, int mc, int lane, const uint8_t* tab, bool xbad,
                                         float (&acc)[RPW][XMX]) {
    bool ok[RPW];
    const uint8_t* wr[RPW];
#pragma unroll
    for (int r = 0; r < RPW; ++r) {
        ok[r] = n0 + r < N;
        wr[r] = wb + (long long)(ok[r] ? n0 + r : 0) * w_ld;
    }
    const bool fullr = n0 + RPW <= N;
    for (int U0 = 0; U0 < UK; U0 += 32 * UF) {
        const int nf = fullr ? (UK - U0) >> 5 : 0;
        if (nf >= UF)
            mdd_step<T, RPW, UF, XMX, UF>(wr, ok, U0 + lane, UK, xb, xsm, K, mc, tab, xbad, acc);
        else if (UF > 1 && nf == UF - 1)
            mdd_step<T, RPW, UF, XMX, (UF > 1 ? UF - 1 : 0)>(wr, ok, U0 + lane, UK, xb, xsm, K, mc, tab, xbad, acc);
        else
            mdd_step<T, RPW, UF, XMX, 0>(wr, ok, U0 + lane, UK, xb, xsm, K, mc, tab, xbad, acc);
    }
}

/* The pipelined form of a wave's run of full tasks in one segment when a task is one step (32 UF
 * >= UK): the next task's units are loaded before this one is decoded, so every wave keeps a
 * task's bytes in flight while it works. NF units every lane has; TL: the last UK - 32 NF units
 * (32 / RPW of them) of the RPW rows spread over the lanes, a (row, unit) a lane, instead of the
 * first lanes only. */
template <int T, int RPW, int UF, int NF, bool TL>
__device__ __forceinline__ void mdd_fetch(const uint8_t* w0, long long w_ld, int lane, int UK,
                                          uint32_t (&raw)[UF][RPW][3]) {
    using Q = Gg<T>;
    constexpr int TW = 32 / RPW;
    gg_for<UF>([&](auto fi) {
        constexpr int F = decltype(fi)::value;
        if constexpr (F < NF) {
            const int V = lane + 32 * F, b = V >> 3;
#pragma unroll
            for (int r = 0; r < RPW; ++r) Q::load_w(w0 + r * w_ld + (long long)b * Q::BB, V - 8 * b, raw[F][r]);
        } else if constexpr (TL && F == NF) {
            const int r = lane / TW, V = 32 * NF + lane % TW, b = V >> 3;
            Q::load_w(w0 + r * w_ld + (long long)b * Q::BB, V - 8 * b, raw[F][0]);
        } else {
            const int V = lane + 32 * F, b = V >> 3;
            if (V < UK) {
#pragma unroll
                for (int r = 0; r < RPW; ++r) Q::load_w(w0 + r * w_ld + (long long)b * Q::BB, V - 8 * b, raw[F][r]);
            }
        }
    });
}

/* A unit's 32 staged values (bf16 pairs) and, for IQ1_S, its sum. */
template <int T>
__device__ __forceinline__ void mdd_xload(const uint16_t* xb, const float* xsm, int V, uint32_t (&xv)[16], float& xs) {
#pragma unroll
    for (int G = 0; G < 4; ++G) {
        const r4d_u32x4 v = *(const r4d_u32x4*)(const void*)(xb + gg_xswz16(32 * V + 8 * G));
#pragma unroll
        for (int i = 0; i < 4; ++i) xv[4 * G + i] = v[i];
    }
    xs = T == GG_IQ1_S ? xsm[V] : 0.0f;
}

/* XR: the lane's activation units sit in registers (xr, xsr) for the run; otherwise each step reads
 * them from LDS (fewer registers; the same values, so the same bits). */
template <int T, int RPW, int UF, int NF, bool TL, bool XR>
__device__ __forceinline__ void mdd_crunch(const uint32_t (&raw)[UF][RPW][3], const uint32_t (&xr)[UF][16],
                                           const float (&xsr)[UF], int lane, int UK, const uint16_t* xb,
                                           const float* xsm, int K, const uint8_t* tab, bool xbad,
                                           float (&acc)[RPW][1]) {
    constexpr int TW = 32 / RPW;
    bool ok[RPW];
#pragma unroll
    for (int r = 0; r < RPW; ++r) ok[r] = true;
    const bool ok1[1] = { true };
    bool bad = xbad;
    gg_for<UF>([&](auto fi) {
        constexpr int F = decltype(fi)::value;
        if constexpr (F < NF) {
#pragma unroll
            for (int r = 0; r < RPW; ++r) bad |= (raw[F][r][0] & 0x7c00u) == 0x7c00u;
        } else if constexpr (TL && F == NF) {
            bad |= (raw[F][0][0] & 0x7c00u) == 0x7c00u;
        } else {
            if (lane + 32 * F < UK) {
#pragma unroll
                for (int r = 0; r < RPW; ++r) bad |= (raw[F][r][0] & 0x7c00u) == 0x7c00u;
            }
        }
    });
    const bool fast = __builtin_amdgcn_ballot_w32(bad) == 0u;
    gg_for<UF>([&](auto fi) {
        constexpr int F = decltype(fi)::value;
        sched_barrier();
        if constexpr (F < NF) {
            const int V = lane + 32 * F;
            if (fast) {
                if constexpr (XR) mdd_unit_r<T, RPW>(raw[F], xr[F], xsr[F], tab, acc);
                else { uint32_t xl[16]; float xs; mdd_xload<T>(xb, xsm, V, xl, xs); mdd_unit_r<T, RPW>(raw[F], xl, xs, tab, acc); }
            } else {
                mdd_unit_exact<T, RPW, 1>(raw[F], V, xb, K, 1, tab, ok, acc);
            }
        } else if constexpr (TL && F == NF) {
            const int tr = lane / TW, V = 32 * NF + lane % TW;
            const uint32_t r1[1][3] = { { raw[F][0][0], raw[F][0][1], raw[F][0][2] } };
            float at[1][1] = { { 0.0f } };
            if (fast) {
                if constexpr (XR) mdd_unit_r<T, 1>(r1, xr[F], xsr[F], tab, at);
                else { uint32_t xl[16]; float xs; mdd_xload<T>(xb, xsm, V, xl, xs); mdd_unit_r<T, 1>(r1, xl, xs, tab, at); }
            } else {
                mdd_unit_exact<T, 1, 1>(r1, V, xb, K, 1, tab, ok1, at);
            }
#pragma unroll
            for (int r = 0; r < RPW; ++r) acc[r][0] = r == tr ? acc[r][0] + at[0][0] : acc[r][0];
        } else {
            const int V = lane + 32 * F;
            if (V < UK) {
                if (fast) {
                    if constexpr (XR) mdd_unit_r<T, RPW>(raw[F], xr[F], xsr[F], tab, acc);
                    else { uint32_t xl[16]; float xs; mdd_xload<T>(xb, xsm, V, xl, xs); mdd_unit_r<T, RPW>(raw[F], xl, xs, tab, acc); }
                } else {
                    mdd_unit_exact<T, RPW, 1>(raw[F], V, xb, K, 1, tab, ok, acc);
                }
            }
        }
    });
}

template <int T, int RPW, int UF, int NF, bool TL, int D, bool XR>
__device__ __forceinline__ void mdd_pipe(const GgMdArgs& A, const uint8_t* wb, int ta, int tc, int UK, const uint16_t* xb,
                                         const float* xsm, int lane, const uint8_t* tab, bool xbad, const int* lr,
                                         uint32_t (&rr)[D][UF][RPW][3], bool primed) {
    constexpr int TW = 32 / RPW;
    const long long ts = (long long)RPW * A.w_ld;
    /* D - 1 tasks ahead in flight: a ring of D task buffers (rr[0] already holds task ta when
     * primed: the kernel loaded it before staging the activations). */
    gg_for<D - 1>([&](auto ji) {
        constexpr int J = decltype(ji)::value;
        if (ta + J < tc && (J > 0 || !primed)) mdd_fetch<T, RPW, UF, NF, TL>(wb + (ta + J) * ts, A.w_ld, lane, UK, rr[J]);
    });
    /* The lane's units of the activation row (the same in every task of the run), in registers. */
    uint32_t xr[UF][16];
    float xsr[UF];
    if constexpr (XR) gg_for<UF>([&](auto fi) {
        constexpr int F = decltype(fi)::value;
        const int V = (TL && F == NF) ? 32 * NF + lane % TW : lane + 32 * F;
        if (F < NF || (TL && F == NF) || V < UK) {
#pragma unroll
            for (int G = 0; G < 4; ++G) {
                const r4d_u32x4 v = *(const r4d_u32x4*)(const void*)(xb + gg_xswz16(32 * V + 8 * G));
#pragma unroll
                for (int i = 0; i < 4; ++i) xr[F][4 * G + i] = v[i];
            }
            xsr[F] = T == GG_IQ1_S ? xsm[V] : 0.0f;
        } else {
#pragma unroll
            for (int i = 0; i < 16; ++i) xr[F][i] = 0u;
            xsr[F] = 0.0f;
        }
    });
    auto fin = [&](const uint32_t (&raw)[UF][RPW][3], int ti) {
        float acc[RPW][1];
#pragma unroll
        for (int r = 0; r < RPW; ++r) acc[r][0] = 0.0f;
        mdd_crunch<T, RPW, UF, NF, TL, XR>(raw, xr, xsr, lane, UK, xb, xsm, A.K, tab, xbad, acc);
        const int n0 = ti * RPW;
#pragma unroll
        for (int r = 0; r < RPW; ++r) {
            const float v = r4d_wave_sum(acc[r][0]);
            if (lane == 0) gg_put(A.y + (long long)lr[0] * A.y_ld + n0 + r, v);
        }
    };
    for (int ti = ta; ti < tc; ti += D) {
        gg_for<D>([&](auto ji) {
            constexpr int J = decltype(ji)::value;
            const int t = ti + J;
            if (t < tc) {
                if (t + D - 1 < tc) mdd_fetch<T, RPW, UF, NF, TL>(wb + (t + D - 1) * ts, A.w_ld, lane, UK, rr[(J + D - 1) % D]);
                sched_barrier();
                fin(rr[J], t);
            }
        });
    }
}

/* The pipelined run (one activation row, the decode case) when the shape allows it (gate_up: 2 rows
 * x 5 full steps; down: 4 rows x 2 full steps and the spread tail), a task ahead; false: the
 * caller runs the tasks one by one. */
template <int T, int RPW, int UF, int XMX>
__device__ __forceinline__ bool mdd_try_pipe(const GgMdArgs& A, const uint8_t* wb, int ta, int tc, int UK,
                                             const uint16_t* xb, const float* xsm, int mc, int lane,
                                             const uint8_t* tab, bool xbad, const int* lr,
                                             uint32_t (&rr)[2][UF][RPW][3], bool primed) {
    (void)tc;
    if (A.N % RPW) return false;          /* by the shape only: every pass of it takes one path */
    if constexpr (UF == 5 && RPW == 2) {
        if (UK == 160) { mdd_pipe<T, RPW, UF, 5, false, 2, true>(A, wb, ta, tc, UK, xb, xsm, lane, tab, xbad, lr, rr, primed); return true; }
    } else if constexpr (UF == 3 && RPW == 4) {
        if (UK == 64 + 8) { mdd_pipe<T, RPW, UF, 2, true, 2, true>(A, wb, ta, tc, UK, xb, xsm, lane, tab, xbad, lr, rr, primed); return true; }
    }
    return false;
}

/* The wave's first task into rr[0] before the activations are staged (its load latency under
 * the staging), when mdd_try_pipe will take it. */
template <int T, int RPW, int UF>
__device__ __forceinline__ bool mdd_prime(const GgMdArgs& A, const uint8_t* wb, int t, int UK, int lane,
                                          uint32_t (&rr)[2][UF][RPW][3]) {
    if (A.N % RPW) return false;
    if constexpr (UF == 5 && RPW == 2) {
        if (UK == 160) { mdd_fetch<T, RPW, UF, 5, false>(wb + (long long)t * RPW * A.w_ld, A.w_ld, lane, UK, rr[0]); return true; }
    } else if constexpr (UF == 3 && RPW == 4) {
        if (UK == 64 + 8) { mdd_fetch<T, RPW, UF, 2, true>(wb + (long long)t * RPW * A.w_ld, A.w_ld, lane, UK, rr[0]); return true; }
    }
    return false;
}

/* Rows [j0, j0 + rows) of the live list into LDS, a row of K values in md_x8's form: widened to
 * f32 (BF false) or the bf16 as they are. */
template <int NT, bool BF>
__device__ __forceinline__ void md_stage(const GgMdArgs& A, float* xs, const int* s_lt, int j0, int rows) {
    const int c8n = A.K >> 3;
    for (int idx = (int)threadIdx.x; idx < rows * c8n; idx += NT) {
        const int m = idx / c8n, kk = (idx - m * c8n) << 3;
        const uint16_t* src = A.x + (long long)s_lt[j0 + m] * A.x_ld + kk;
        if constexpr (BF) {
            uint32_t q[4];
            gg_x8raw(src, A.x_al != 0, q);
            uint16_t* d = (uint16_t*)(void*)xs + m * A.K + gg_xswz16(kk);
            r4d_u32x4 v;
            v[0] = q[0]; v[1] = q[1]; v[2] = q[2]; v[3] = q[3];
            *(r4d_u32x4*)(void*)d = v;
        } else {
            float v[8];
            gg_x8(src, A.x_al != 0, v);
            float* d = xs + m * A.K;
            *(float4*)(d + gg_xswz(kk)) = make_float4(v[0], v[1], v[2], v[3]);
            *(float4*)(d + gg_xswz(kk + 4)) = make_float4(v[4], v[5], v[6], v[7]);
        }
    }
}

template <int T, int RPW, int UF, int NW, int XMX, bool DOT = false>
__global__ __launch_bounds__(NW * 32) void gg_md_kernel(GgMdArgs A) {
    using Q = Gg<T>;
    constexpr int NT = NW * 32;
    extern __shared__ __attribute__((aligned(16))) uint8_t gg_smem[];
    const int tid = (int)threadIdx.x, lane = tid & 31, wave = tid >> 5;
    const int ne = A.n_expert, TT = A.T;
    /* Kept: each segment's expert weight and first live row (s_seg[ns] = the live count), each
     * live row's output row and activation row. */
    const uint8_t** s_segw = (const uint8_t**)(gg_smem + A.meta_off);
    int* s_lr = (int*)(s_segw + kMdMaxT);
    int* s_lt = s_lr + kMdMaxT;
    int* s_seg = s_lt + kMdMaxT;
    int* s_cnt = s_seg + kMdMaxT + 1;
    /* Scratch of the routing pass, under the activation rows. */
    float* xs = (float*)(gg_smem + A.x_off);
    const uint8_t** s_wt = (const uint8_t**)(gg_smem + A.x_off);
    int* s_off = (int*)(s_wt + ne);
    int* s_srt = s_off + ne + 1;
    int* s_le = s_srt + TT;
    int* s_dr = s_le + TT;

    if constexpr (DOT) mdd_load_table<T>(gg_smem);
    else gg_load_table<T>(gg_smem);
    for (int i = tid; i <= ne; i += NT) s_off[i] = A.off[i];
    for (int i = tid; i < TT; i += NT) s_srt[i] = A.sorted[i];
    if (A.wtab)
        for (int i = tid; i < ne; i += NT) s_wt[i] = A.wtab[i];
    lds_barrier();
    if (wave == 0) {
        const uint32_t lt = (1u << lane) - 1u;
        int nl = 0, nd = 0;
        for (int c0 = 0; c0 < TT; c0 += 32) {
            const int i = c0 + lane;
            int e = 0, tok = -1;
            if (i < TT) {
                const int flat = s_srt[i];
                if (flat >= 0) {
                    tok = A.a_sorted ? i : flat / A.top_k;
                    if (tok >= A.AR) tok = -1;
                }
                int lo = 0, hi = ne;          /* libref's search: the last offset <= i */
                while (lo + 1 < hi) {
                    const int mid = (lo + hi) >> 1;
                    if (s_off[mid] <= i) lo = mid; else hi = mid;
                }
                e = lo;
            }
            const bool live = i < TT && tok >= 0, dead = i < TT && tok < 0;
            const uint32_t bl = __builtin_amdgcn_ballot_w32(live), bd = __builtin_amdgcn_ballot_w32(dead);
            if (live) {
                const int p = nl + __builtin_popcount(bl & lt);
                s_lr[p] = i;
                s_lt[p] = tok;
                s_le[p] = e;
            }
            if (dead) s_dr[nd + __builtin_popcount(bd & lt)] = i;
            nl += __builtin_popcount(bl);
            nd += __builtin_popcount(bd);
        }
        /* Segments: a run of one expert's rows, cut every XM rows. */
        int ns = 0, run = 0;
        for (int c0 = 0; c0 < nl; c0 += 32) {
            const int j = c0 + lane;
            const bool in = j < nl;
            const bool head = in && (j == 0 || s_le[j] != s_le[j - 1]);
            const uint32_t hb = __builtin_amdgcn_ballot_w32(head);
            const uint32_t upto = hb & (lt | (1u << lane));
            const int rs = upto ? c0 + 31 - __builtin_clz(upto) : run;
            const bool start = in && (j - rs) % A.XM == 0;
            const uint32_t sb = __builtin_amdgcn_ballot_w32(start);
            if (start) {
                const int p = ns + __builtin_popcount(sb & lt);
                const int e = s_le[j];
                s_seg[p] = j;
                s_segw[p] = A.wtab ? s_wt[e] : A.w + (long long)e * A.w_es;
            }
            ns += __builtin_popcount(sb);
            if (hb) run = c0 + 31 - __builtin_clz(hb);
        }
        if (lane == 0) {
            s_seg[ns] = nl;
            s_cnt[0] = nl;
            s_cnt[1] = ns;
            s_cnt[2] = nd;
        }
    }
    lds_barrier();
    const int ns = s_cnt[1], nd = s_cnt[2];
    /* The dead rows: zeros, this block's share. */
    {
        const long long tot = (long long)nd * A.N;
        const long long z0 = tot * blockIdx.x / gridDim.x, z1 = tot * (blockIdx.x + 1) / gridDim.x;
        for (long long q = z0 + tid; q < z1; q += NT) {
            const int r = (int)(q / A.N);
            A.y[(long long)s_dr[r] * A.y_ld + (q - (long long)r * A.N)] = 0;
        }
    }
    if (ns == 0) return;
    const int TPS = (A.N + RPW - 1) / RPW;               /* tasks a segment */
    const long long W = (long long)ns * TPS, GW = (long long)gridDim.x * NW;
    const long long gb = (long long)blockIdx.x * NW;
    const long long bt0 = W * gb / GW, bt1 = W * (gb + NW) / GW;
    const long long wt0 = W * (gb + wave) / GW, wt1 = W * (gb + wave + 1) / GW;
    const int UK = A.K / Q::QK * Q::UPB;
    uint8_t* wbuf = A.raw_off >= 0 ? gg_smem + A.raw_off + wave * A.raw_wave : nullptr;
    uint32_t rr[2][UF][RPW][3];          /* the dot path's task ring (mdd_pipe) */
    int pr_sg = -1, pr_t = -1;
    if constexpr (DOT) {
        if (wt0 < wt1) {
            const int sg0 = (int)(wt0 / TPS), t0 = (int)(wt0 - (long long)sg0 * TPS);
            if (mdd_prime<T, RPW, UF>(A, md_uniform(s_segw[sg0]), t0, UK, lane, rr)) { pr_sg = sg0; pr_t = t0; }
        }
    }
    int s = (int)(bt0 / TPS);
    while (bt0 < bt1 && (long long)s * TPS < bt1) {
        /* A phase: the block's next segments whose rows fit the buffer together. */
        int s2 = s + 1;
        while (s2 < ns && (long long)s2 * TPS < bt1 && s_seg[s2 + 1] - s_seg[s] <= A.XB) ++s2;
        const int j0 = s_seg[s];
        lds_barrier();
        md_stage<NT, (XMX > 1 || DOT)>(A, xs, s_lt, j0, s_seg[s2] - j0);
        int* s_rb = (int*)(void*)(gg_smem + A.xs_off) + A.XB * (A.K >> 5);  /* the dot path's row flags */
        if constexpr (DOT)
            for (int i = tid; i < s_seg[s2] - j0; i += NT) s_rb[i] = 0;
        lds_barrier();
        if constexpr (DOT) {
            /* The unit sums (IQ1_S) and whether any staged value or sum is not finite. */
            const int rows = s_seg[s2] - j0, ukr = A.K >> 5;
            const uint16_t* x16 = (const uint16_t*)(const void*)xs;
            float* xsm = (float*)(void*)(gg_smem + A.xs_off);
            for (int idx = tid; idx < rows * ukr; idx += NT) {
                int bad = 0;
                const int m = idx / ukr, u = idx - m * ukr;
                float sum = 0.0f;
#pragma unroll
                for (int G = 0; G < 4; ++G) {
                    const r4d_u32x4 v = *(const r4d_u32x4*)(const void*)(x16 + m * A.K + gg_xswz16(32 * u + 8 * G));
#pragma unroll
                    for (int i = 0; i < 4; ++i) {
                        bad |= ((v[i] & 0x7f80u) == 0x7f80u) | ((v[i] & 0x7f800000u) == 0x7f800000u);
                        if constexpr (T == GG_IQ1_S) {
                            sum += bf16w_lo(v[i]);
                            sum += bf16w_hi(v[i]);
                        }
                    }
                }
                if constexpr (T == GG_IQ1_S) {
                    xsm[idx] = sum;
                    bad |= (__float_as_uint(sum) & 0x7f800000u) == 0x7f800000u;
                }
                if (bad) atomicOr(&s_rb[m], 1);
            }
            lds_barrier();
        }
        for (int sg = s; sg < s2; ++sg) {
            const long long base = (long long)sg * TPS;
            const int ta = (int)((wt0 > base ? wt0 : base) - base);
            const int tc = (int)((wt1 < base + TPS ? wt1 : base + TPS) - base);
            if (ta >= tc) continue;
            const int sj = s_seg[sg], mc = s_seg[sg + 1] - sj;
            const uint8_t* wb = md_uniform(s_segw[sg]);
            const float* xr = XMX > 1 ? (const float*)(const void*)((const uint16_t*)(const void*)xs + (long long)(sj - j0) * A.K)
                                      : xs + (long long)(sj - j0) * A.K;
            if constexpr (DOT) {
                const bool pr = sg == pr_sg && ta == pr_t;
                if (pr) pr_sg = -1;
                /* A row's own flag: its arithmetic never depends on the other rows of the pass. */
                const bool xbad = s_rb[sj - j0] != 0;
                if (mc == 1 && mdd_try_pipe<T, RPW, UF, 1>(A, wb, ta, tc, UK,
                                                  (const uint16_t*)(const void*)xs + (long long)(sj - j0) * A.K,
                                                  (const float*)(const void*)(gg_smem + A.xs_off) + (long long)(sj - j0) * (A.K >> 5),
                                                  mc, lane, gg_smem, xbad, s_lr + sj, rr, pr))
                    continue;
            }
            for (int ti = ta; ti < tc; ++ti) {
                const int n0 = ti * RPW;
                float acc[RPW][XMX];
#pragma unroll
                for (int r = 0; r < RPW; ++r)
#pragma unroll
                    for (int m = 0; m < XMX; ++m) acc[r][m] = 0.0f;
                if constexpr (DOT)
                    mdd_task<T, RPW, UF, XMX>(wb, A.w_ld, n0, A.N, UK,
                                              (const uint16_t*)(const void*)xs + (long long)(sj - j0) * A.K,
                                              (const float*)(const void*)(gg_smem + A.xs_off) + (long long)(sj - j0) * (A.K >> 5),
                                              A.K, mc, lane, gg_smem, s_rb[sj - j0] != 0, acc);
                else
                    md_task<T, RPW, UF, XMX>(wb, A.w_ld, n0, A.N, UK, xr, A.K, mc, lane, gg_smem, wbuf, acc);
#pragma unroll
                for (int r = 0; r < RPW; ++r) {
                    if (n0 + r >= A.N) continue;
#pragma unroll
                    for (int m = 0; m < XMX; ++m) {
                        if (m >= mc) continue;
                        const float v = r4d_wave_sum(acc[r][m]);
                        if (lane == 0) gg_put(A.y + (long long)s_lr[sj + m] * A.y_ld + n0 + r, v);
                    }
                }
            }
        }
        s = s2;
    }
}

/* ================================================================== tiled (prefill) */
constexpr int kTN = 128, kTP = 132;   /* tile columns (weight rows), LDS row floats of Ws */

struct GgTiledArgs {
    const uint16_t* x;
    long long x_ld;
    const uint8_t* w;
    const uint8_t* const* wtab;
    long long w_ld, w_es;
    void* y;
    long long y_ld;
    const int32_t* sorted;
    const int32_t* off;
    int M, N, K;                         /* MoE: M is T, the output rows */
    int n_expert, top_k, a_sorted, AR, x_al, tab_bytes;
};

/* BM activation rows x 128 weight rows a block. BM 128: 8 x 8 outputs a thread; BM 32: 4 x 4. Each
 * output is the same chain at either height (slabs in order, the slab's 32 values in order), so
 * the bits do not depend on BM. */
template <int T, int BM, bool MOE, typename OT>
__global__ __launch_bounds__(kGgThreads) void gg_tiled_kernel(GgTiledArgs A) {
    using Q = Gg<T>;
    static_assert(BM == 32 || BM == 128, "a tile is 32 or 128 rows");
    constexpr int TM = BM == 128 ? 8 : 4, TN = BM == 128 ? 8 : 4;
    constexpr int TXN = kTN / TN;                   /* threads across the columns */
    constexpr int XP = BM + 4;                      /* LDS row floats of Xs */
    extern __shared__ __attribute__((aligned(16))) uint8_t gg_smem[];
    __shared__ int s_e, s_r0, s_r1;
    __shared__ int s_tok[BM];
    const int tid = (int)threadIdx.x, lane = tid & 31, wave = tid >> 5;
    gg_load_table<T>(gg_smem);
    const void* tab = gg_smem;
    float* Ws = (float*)(gg_smem + A.tab_bytes);  /* [32][kTP]: slab value, weight row */
    float* Xs = Ws + 32 * kTP;                      /* [32][XP]: slab value, activation row */
    int e = 0, r0, r1;
    if constexpr (MOE) {
        /* Slot blockIdx.x -> (expert, its tile): the experts' tile counts scanned a wave of 32 at
         * a time. */
        if (wave == 0) {
            if (lane == 0) s_e = -1;
            const uint32_t slot = blockIdx.x;
            uint32_t base = 0;
            for (int e0 = 0; e0 < A.n_expert; e0 += 32) {
                const int ee = e0 + lane;
                int s = 0, t = 0;
                if (ee < A.n_expert) gg_range(A.off, ee, A.n_expert, A.M, &s, &t);
                const uint32_t tiles = (uint32_t)((t - s + BM - 1) / BM);
                const uint32_t inc = r4d_wave_prefix_u32(tiles, lane);
                const uint32_t tot = (uint32_t)__builtin_amdgcn_readlane((int)inc, 31);
                if (slot < base + tot) {
                    if (slot >= base + inc - tiles && slot < base + inc) {
                        s_e = ee;
                        s_r0 = s + (int)(slot - (base + inc - tiles)) * BM;
                        s_r1 = min(s_r0 + BM, t);
                    }
                    break;
                }
                base += tot;
            }
        }
        __syncthreads();
        e = s_e;
        if (e < 0) return;
        r0 = s_r0;
        r1 = s_r1;
    } else {
        r0 = (int)blockIdx.x * BM;
        r1 = min(r0 + BM, A.M);
    }
    if (tid < BM) {
        const int i = r0 + tid;
        int tk = -1;
        if (i < r1) {
            if constexpr (MOE) tk = gg_moe_tok(A.sorted, i, A.top_k, A.a_sorted, A.AR);
            else tk = i;
        }
        s_tok[tid] = tk;
    }
    __syncthreads();

    const int n0 = (int)blockIdx.y * kTN;
    const uint8_t* wb = A.w;
    if constexpr (MOE) wb = A.wtab ? A.wtab[e] : A.w + (long long)e * A.w_es;
    const int S = A.K / Q::QK * Q::UPB;
    /* Waves 0..3 decode a weight row each a slab, the next BM threads widen an activation row
     * each. */
    const bool wrole = tid < kTN;
    const bool xrole = tid >= kTN && tid < kTN + BM;
    const int ri = wrole ? tid : (xrole ? tid - kTN : 0);
    const bool nok = n0 + ri < A.N;
    const uint8_t* wrow = wb + (long long)(nok ? n0 + ri : 0) * A.w_ld;
    const int tokr = xrole ? s_tok[ri] : -1;
    const uint16_t* xrow = A.x + (long long)(tokr >= 0 ? tokr : 0) * A.x_ld;
    /* One prefetch register set for both roles: a unit's raw words, or four groups of eight bf16
     * (four dwords each), so the live set across the slab's multiply-adds is the larger, not the
     * sum. */
    constexpr int PF = Q::NR > 16 ? Q::NR : 16;
    uint32_t pf[PF];
    auto prefetch = [&](int s) {
        const int b = s / Q::UPB, u = s - b * Q::UPB;
        if (wrole) {
            if (nok) Q::load(wrow + (long long)b * Q::BB, u, pf);
        } else if (tokr >= 0) {
            gg_for<4>([&](auto gi) {
                constexpr int G = decltype(gi)::value;
                gg_x8raw(xrow + b * Q::QK + Q::goff(u, G), A.x_al != 0, pf + 4 * G);
            });
        }
    };
    float acc[TM][TN];
#pragma unroll
    for (int i = 0; i < TM; ++i)
#pragma unroll
        for (int j = 0; j < TN; ++j) acc[i][j] = 0.0f;
    const int ty = tid / TXN, tx = tid % TXN;
    prefetch(0);
    for (int s = 0; s < S; ++s) {
        const int u = s - (s / Q::UPB) * Q::UPB;
        if (wrole) {
            gg_for<4>([&](auto gi) {
                constexpr int G = decltype(gi)::value;
                float w[8];
                if (nok) {
                    Q::template dec<G>(pf, u, tab, w);
                } else {
#pragma unroll
                    for (int t = 0; t < 8; ++t) w[t] = 0.0f;
                }
#pragma unroll
                for (int t = 0; t < 8; ++t) Ws[(8 * G + t) * kTP + ri] = w[t];
            });
        } else if (xrole) {
#pragma unroll
            for (int i = 0; i < 16; ++i) {
                const uint32_t q = tokr >= 0 ? pf[i] : 0u;
                Xs[(2 * i) * XP + ri] = bf16w_lo(q);
                Xs[(2 * i + 1) * XP + ri] = bf16w_hi(q);
            }
        }
        lds_barrier();
        if (s + 1 < S) prefetch(s + 1);
#pragma unroll 2
        for (int kk = 0; kk < 32; ++kk) {
            float av[TM], bv[TN];
#pragma unroll
            for (int i = 0; i < TM; i += 4) {
                const float4 v = *(const float4*)(Xs + kk * XP + ty * TM + i);
                av[i] = v.x; av[i + 1] = v.y; av[i + 2] = v.z; av[i + 3] = v.w;
            }
#pragma unroll
            for (int j = 0; j < TN; j += 4) {
                const float4 v = *(const float4*)(Ws + kk * kTP + tx * TN + j);
                bv[j] = v.x; bv[j + 1] = v.y; bv[j + 2] = v.z; bv[j + 3] = v.w;
            }
#pragma unroll
            for (int i = 0; i < TM; ++i)
#pragma unroll
                for (int j = 0; j < TN; ++j) acc[i][j] += av[i] * bv[j];
        }
        lds_barrier();
    }
#pragma unroll
    for (int i = 0; i < TM; ++i) {
        const int lr = ty * TM + i, row = r0 + lr;
        if (row >= r1) continue;
        const bool live_row = s_tok[lr] >= 0;
        OT* yr = (OT*)A.y + (long long)row * A.y_ld;
#pragma unroll
        for (int j = 0; j < TN; ++j) {
            const int n = n0 + tx * TN + j;
            if (n < A.N) gg_put(yr + n, live_row ? acc[i][j] : 0.0f);
        }
    }
}

/* ================================================================== WMMA (prefill)
 *
 * The large-M rows on v_wmma_f32_16x16x16_bf16 with the scale factored out. libref's weight value
 * is d * s * g with d the f16 widened exactly, s the block's sub-scale and g a small grid integer;
 * the WMMA sees only bf16-exact operands -- the bf16 activation and an unscaled grid value -- so
 * every product is exact, a scale group of them sums in f32 (P), and the group's f32 scale
 * multiplies P once into the f32 accumulator (fma). Each weight value is libref's exactly; only
 * the order and rounding of the sum differ (no decode-band pass reaches these rows).
 *   IQ1_S:   (2 s + 1) (g + delta) = (2 s + 1) (8 g +- 1) / 8 is an odd integer <= 135 over 8,
 *            exact in bf16, so the sub-scale folds into the value and d applies once a slab.
 *   IQ2_XXS: +-grid (8, 25, 43); db = d (0.5 + s) 0.25 once a 32-value sub-block.
 *   Q8_0:    q (int8); d once a block.
 *   Q6_K:    q - 32; d sc once a 16-value group.
 *   Q5_K:    q (0..31); d1 once a 32-value group, and - m1 (sum x) from the staged rows' group sums.
 * Fragments (wave32, gfx12): A lane L is row L % 16, B lane L column L % 16, each lane half 8 K
 * values -- which 8 is the kernel's choice as long as A and B agree; here a lane half takes 8
 * consecutive values of one scale group, so a B fragment is one decoded unit group. D lane L is
 * column L % 16, rows 8 (L / 16) + e.
 *
 * MoE (gg_wm_kernel): a block is one expert's BM = 16 MT sorted rows (as the tiled kernel assigns
 * them) by 256 weight rows; wave w owns 32 weight rows (two 16-column tiles) and decodes their
 * blocks straight into B fragments: the I-quants by four v_perm_b32 from an LDS selector table
 * (each grid entry's 8 values as byte selectors into a two-dword pool of the bf16 values), the next
 * slab's raw words prefetched. The activation slab (BM rows x 128 values) is staged in LDS; 16-row
 * tiles with no live row skip their WMMAs, and a tile of dead rows only writes its zeros. */
constexpr int kWmS = 128;            /* values a slab */
constexpr int kWmXP = kWmS + 8;      /* bf16 a staged activation row: 272 bytes, rows 4 banks apart */
constexpr int kWmBN = 256;           /* weight rows a block: 8 waves x 2 tiles of 16 */

typedef __bf16 gg_v8bf __attribute__((ext_vector_type(8)));
typedef float gg_v8f __attribute__((ext_vector_type(8)));

__device__ __forceinline__ gg_v8f gg_wmma(r4d_u32x4 a, r4d_u32x4 b, gg_v8f c) {
    return __builtin_amdgcn_wmma_f32_16x16x16_bf16_w32_gfx12(__builtin_bit_cast(gg_v8bf, a),
                                                             __builtin_bit_cast(gg_v8bf, b), c);
}
/* Keep eight values computed here (an empty asm reading and writing each, one VGPR apiece). */
__device__ __forceinline__ void gg_pin8(gg_v8f& v) {
    float a0 = v[0], a1 = v[1], a2 = v[2], a3 = v[3], a4 = v[4], a5 = v[5], a6 = v[6], a7 = v[7];
    asm volatile("" : "+v"(a0), "+v"(a1), "+v"(a2), "+v"(a3), "+v"(a4), "+v"(a5), "+v"(a6), "+v"(a7));
    v[0] = a0; v[1] = a1; v[2] = a2; v[3] = a3; v[4] = a4; v[5] = a5; v[6] = a6; v[7] = a7;
}
/* A wave-uniform pointer in SGPRs (for the scalar prefetch). */
__device__ __forceinline__ const uint8_t* gg_sptr(const uint8_t* p) {
    const uint64_t u = (uint64_t)p;
    const uint32_t lo = (uint32_t)__builtin_amdgcn_readfirstlane((int)(uint32_t)u);
    const uint32_t hi = (uint32_t)__builtin_amdgcn_readfirstlane((int)(uint32_t)(u >> 32));
    return (const uint8_t*)(((uint64_t)hi << 32) | lo);
}
/* libref's products with an infinite d mix signs (and zeros): NaN. */
__device__ __forceinline__ float gg_wm_fin(float s) { return __builtin_isinf(s) ? __builtin_nanf("") : s; }
/* Four selector dwords against a pool (lo: low bytes, hi: high bytes of the values). */
__device__ __forceinline__ r4d_u32x4 gg_wm_perm4(uint32_t hi, uint32_t lo, r4d_u32x4 sel) {
    r4d_u32x4 b;
#pragma unroll
    for (int p = 0; p < 4; ++p) b[p] = __builtin_amdgcn_perm(hi, lo, sel[p]);
    return b;
}

template <int T> struct Wq;

/* Common: no staged activation sums (XG 0), no min term. A type with XG > 0 has its staged rows'
 * sums over XG-value groups, times XGK, in LDS: they start each chain (C), and Q5_K's min term
 * reads them again. */
struct WqBase {
    static constexpr int XG = 0, MINS = 0, CINIT = 0, ROLL = 0, GUARD = 0;
    /* Raw words loaded a slab ahead into a second set (bit k: word k); ROLL types reload the
     * others in place after their last use (reload<J>), which leaves a word whose next-slab first
     * use comes soon after its last use too little time to arrive -- those go early. */
    static constexpr uint32_t EARLY = 0xffffffffu;
    /* B fragments a K step ahead (decoded behind the previous step's WMMAs); the wide K-quant
     * blocks (Q6_K, Q5_K) decode in their own step: the second fragment set and the inits it
     * keeps live cost them a block a WGP (> 240 VGPRs). */
    static constexpr int PIPE = 1;
    /* A K step's LDS table reads, issued a step ahead of its decode (none for the K-quants). */
    struct Pf {};
    template <int J>
    __device__ static __forceinline__ void pre(const uint32_t*, int, const uint8_t*, Pf&) {}
    template <int J>
    __device__ static __forceinline__ void reload(const uint8_t*, int, int, uint32_t*) {}
    static constexpr float XGK = 0.0f;
    __device__ static __forceinline__ float mins(const uint32_t*, int, int) { return 0.0f; }
};

/* IQ1_S. Lane half h of slab c takes sub-blocks 4c + 2h and 4c + 2h + 1; K step J is group J & 3
 * of the lane's sub-block J >> 2. Table: the 2048 grid entries as bytes b = grid + 1 (two dwords),
 * then 16 pools by qh >> 12 (s, the delta's sign): the low and the high bytes of the bf16 values
 * (2 s + 1)(b - 1 + delta), b = 0, 1, 2. Decode: v_perm with the grid dword as the selector looks
 * four values' low (high) bytes up in the pool; two more v_perm interleave them into bf16 pairs. */
template <> struct Wq<GG_IQ1_S> : WqBase {
    static constexpr int RAW = 4, SPG = 8, TB = 2048 * 8 + 16 * 8;
    struct Pf { gg_u32x2 g, p; };
    __device__ static __forceinline__ int xoff(int J, int h) { return 64 * h + 8 * J; }
    __device__ static __forceinline__ void load(const uint8_t* row, int s, int h, uint32_t* r) {
        const uint8_t* b = row + (long long)(s >> 1) * 50;
        const int c = s & 1;
        r[0] = gg_u16(b);
        const gg_u32x2 q = *(gg_gu64a2)(const void*)(b + 2 + 16 * c + 8 * h);
        r[1] = q.x;
        r[2] = q.y;
        r[3] = *(gg_gu32a2)(const void*)(b + 34 + 8 * c + 4 * h);
    }
    __device__ static __forceinline__ float scale(const uint32_t* r, int, int) { return gg_wm_fin(gg_h2f(r[0])); }
    template <int J>
    __device__ static __forceinline__ void pre(const uint32_t* r, int, const uint8_t* tab, Pf& f) {
        constexpr int SB = J >> 2, G = J & 3;
        const uint32_t qh = SB ? (r[3] >> 16) : (r[3] & 0xffffu);
        const uint32_t gi = gg_byte(r[1 + SB], G) | (((qh >> (3 * G)) & 7u) << 8);
        f.g = *(const gg_u32x2*)(const void*)(tab + 8 * gi);
        f.p = *(const gg_u32x2*)(const void*)(tab + 2048 * 8 + 8 * (qh >> 12));
    }
    template <int J>
    __device__ static __forceinline__ r4d_u32x4 bfrag(const uint32_t*, int, const Pf& f, int) {
        r4d_u32x4 b;
#pragma unroll
        for (int w = 0; w < 2; ++w) {
            const uint32_t gw = w ? f.g.y : f.g.x;
            const uint32_t lo = __builtin_amdgcn_perm(f.p.x, f.p.x, gw), hi = __builtin_amdgcn_perm(f.p.y, f.p.y, gw);
            b[2 * w] = __builtin_amdgcn_perm(hi, lo, 0x05010400u);
            b[2 * w + 1] = __builtin_amdgcn_perm(hi, lo, 0x07030602u);
        }
        return b;
    }
    __device__ static __forceinline__ void table(uint8_t* lds) {
        const int tid = (int)threadIdx.x;
        for (int i = tid; i < 2048; i += (int)blockDim.x) ((uint64_t*)(void*)lds)[i] = kGgIq1sGridP1[i];
        if (tid < 16) {
            const float m = (float)(2 * (tid & 7) + 1), dl = (tid & 8) ? -0.125f : 0.125f;
            uint32_t lo = 0, hi = 0;
#pragma unroll
            for (int b = 0; b < 3; ++b) {
                const uint32_t bits = __float_as_uint(m * ((float)(b - 1) + dl)) >> 16;   /* exact */
                lo |= (bits & 0xffu) << (8 * b);
                hi |= (bits >> 8) << (8 * b);
            }
            gg_u32x2 pv;
            pv.x = lo;
            pv.y = hi;
            ((gg_u32x2*)(void*)(lds + 2048 * 8))[tid] = pv;
        }
    }
};

/* IQ2_XXS. K step J is sub-block J >> 1 of the slab, group 2 (J & 1) + h. Table: the 256 grid
 * entries as bf16 (8 / 25 / 43, exact), then 128 sign masks (0x8000 a negated value, by the seven
 * stored sign bits): a B fragment is one xor. */
template <> struct Wq<GG_IQ2_XXS> : WqBase {
    static constexpr int RAW = 9, SPG = 2, TB = 256 * 16 + 128 * 16;
    __device__ static __forceinline__ int xoff(int J, int h) { return 16 * J + 8 * h; }
    __device__ static __forceinline__ void load(const uint8_t* row, int s, int, uint32_t* r) {
        const uint8_t* b = row + (long long)(s >> 1) * 66 + 32 * (s & 1);
        r[0] = gg_u16(row + (long long)(s >> 1) * 66);
#pragma unroll
        for (int i = 0; i < 4; ++i) {
            const gg_u32x2 q = *(gg_gu64a2)(const void*)(b + 2 + 8 * i);
            r[1 + 2 * i] = q.x;
            r[2 + 2 * i] = q.y;
        }
    }
    __device__ static __forceinline__ float scale(const uint32_t* r, int q, int) {
        return gg_wm_fin(gg_h2f(r[0])) * (0.5f + (float)(r[2 + 2 * q] >> 28)) * 0.25f;   /* exact; inf d -> NaN either way */
    }
    struct Pf { r4d_u32x4 sel, sm; };
    template <int J>
    __device__ static __forceinline__ void pre(const uint32_t* r, int h, const uint8_t* tab, Pf& f) {
        constexpr int SB = J >> 1;
        const int G = 2 * (J & 1) + h;
        const uint32_t gi = (r[1 + 2 * SB] >> (8 * G)) & 0xffu;
        const uint32_t sx = (r[2 + 2 * SB] >> (7 * G)) & 127u;
        f.sel = *(const r4d_u32x4*)(const void*)(tab + 16 * gi);
        f.sm = *(const r4d_u32x4*)(const void*)(tab + 4096 + 16 * sx);
    }
    template <int J>
    __device__ static __forceinline__ r4d_u32x4 bfrag(const uint32_t*, int, const Pf& f, int) {
        return f.sel ^ f.sm;
    }
    __device__ static __forceinline__ void table(uint8_t* lds) {
        const int tid = (int)threadIdx.x;
        for (int i = tid; i < 256; i += (int)blockDim.x) {
            const uint64_t g = kGgIq2xxsGrid[i];
            r4d_u32x4 v;
#pragma unroll
            for (int p = 0; p < 4; ++p) {
                uint32_t w = 0;
#pragma unroll
                for (int t = 0; t < 2; ++t) {
                    const uint32_t by = (uint32_t)(g >> (16 * p + 8 * t)) & 0xffu;   /* 8, 25 or 43 */
                    w |= (__float_as_uint((float)by) >> 16) << (16 * t);              /* exact bf16 */
                }
                v[p] = w;
            }
            ((r4d_u32x4*)(void*)lds)[i] = v;
        }
        for (int i = tid; i < 128; i += (int)blockDim.x) {
            const uint32_t sg = (uint32_t)i | ((__builtin_popcount((uint32_t)i) & 1u) << 7);
            r4d_u32x4 v;
#pragma unroll
            for (int p = 0; p < 4; ++p) v[p] = (((sg >> (2 * p)) & 1u) << 15) | (((sg >> (2 * p + 1)) & 1u) << 31);
            ((r4d_u32x4*)(void*)(lds + 4096))[i] = v;
        }
    }
};

/* Two f32 values exact in bf16 as a bf16 pair, `a` low. */
__device__ __forceinline__ uint32_t gg_wm_pk(float a, float b) {
    return __builtin_amdgcn_perm(__float_as_uint(b), __float_as_uint(a), 0x07060302u);
}
/* Four bytes u (< 128) as two bf16 pairs of 128 + u: high byte 0x43, low byte u. */
__device__ __forceinline__ void gg_wm_u128(uint32_t u, uint32_t* b) {
    b[0] = __builtin_amdgcn_perm(0x43434343u, u, 0x04010400u);
    b[1] = __builtin_amdgcn_perm(0x43434343u, u, 0x04030402u);
}

/* Q8_0. Slab s is blocks 4s .. 4s + 3; K step J is block J >> 1, values 16 (J & 1) + 8h. The int8
 * values exact through f32 (v_cvt_f32_i32 of the sign-extended byte). */
template <> struct Wq<GG_Q8_0> : WqBase {
    static constexpr int RAW = 20, SPG = 2, TB = 0, ROLL = 1;
    static constexpr uint32_t EARLY = 0;
    __device__ static __forceinline__ int xoff(int J, int h) { return 16 * J + 8 * h; }
    __device__ static __forceinline__ void load1(const uint8_t* row, int s, int h, int i, uint32_t* r) {
        const uint8_t* b = row + (long long)(4 * s + i) * 34;
        r[5 * i] = gg_u16(b);
        const gg_u32x2 q0 = *(gg_gu64a2)(const void*)(b + 2 + 8 * h);
        const gg_u32x2 q1 = *(gg_gu64a2)(const void*)(b + 18 + 8 * h);
        r[5 * i + 1] = q0.x;
        r[5 * i + 2] = q0.y;
        r[5 * i + 3] = q1.x;
        r[5 * i + 4] = q1.y;
    }
    __device__ static __forceinline__ void load(const uint8_t* row, int s, int h, uint32_t* r) {
#pragma unroll
        for (int i = 0; i < 4; ++i) load1(row, s, h, i, r);
    }
    /* Block i's words after its last step, 2i + 1. */
    template <int J>
    __device__ static __forceinline__ void reload(const uint8_t* row, int s, int h, uint32_t* r) {
        if constexpr (J & 1) load1(row, s, h, J >> 1, r);
    }
    __device__ static __forceinline__ float scale(const uint32_t* r, int q, int) { return gg_wm_fin(gg_h2f(r[5 * q])); }
    template <int J>
    __device__ static __forceinline__ r4d_u32x4 bfrag(const uint32_t* r, int, const Pf&, int) {
        constexpr int B0 = 5 * (J >> 1) + 1 + 2 * (J & 1);
        r4d_u32x4 b;
#pragma unroll
        for (int w = 0; w < 2; ++w) {
            const uint32_t q = r[B0 + w];
            b[2 * w] = gg_wm_pk((float)gg_sbyte(q, 0), (float)gg_sbyte(q, 1));
            b[2 * w + 1] = gg_wm_pk((float)gg_sbyte(q, 2), (float)gg_sbyte(q, 3));
        }
        return b;
    }
    __device__ static __forceinline__ void table(uint8_t*) {}
};

/* Q6_K. Slab s is half c = s & 1 of block s >> 1; K step J is the 16-value group J (quarter
 * q = J >> 1, l = 16 (J & 1) + 8h + t), scale sc[8c + J]. The WMMA sees 128 + q6 (bf16 0x43 | q6,
 * one v_perm_b32 a pair) and each chain starts at -160 (sum x) over the group: the sum is
 * sum x (q6 - 32), every operand exact. */
template <> struct Wq<GG_Q6_K> : WqBase {
    static constexpr int RAW = 15, SPG = 1, TB = 0, XG = 16, CINIT = 1, ROLL = 1, PIPE = 0;
    static constexpr uint32_t EARLY = 0x4f00u;   /* qh pairs (8..11) and d (14) */
    static constexpr float XGK = -160.0f;
    __device__ static __forceinline__ int xoff(int J, int h) { return 16 * J + 8 * h; }
    /* ql pair i ((q & 1) = i >> 1, l-half i & 1), qh pair i (l-half), scales and d. */
    __device__ static __forceinline__ void lql(const uint8_t* b, int c, int h, int i, uint32_t* r) {
        const gg_u32x2 q = *(gg_gu64a2)(const void*)(b + 64 * c + 32 * (i >> 1) + 16 * (i & 1) + 8 * h);
        r[2 * i] = q.x;
        r[2 * i + 1] = q.y;
    }
    __device__ static __forceinline__ void lqh(const uint8_t* b, int c, int h, int i, uint32_t* r) {
        const gg_u32x2 q = *(gg_gu64a2)(const void*)(b + 128 + 32 * c + 16 * i + 8 * h);
        r[8 + 2 * i] = q.x;
        r[9 + 2 * i] = q.y;
    }
    __device__ static __forceinline__ void lsc(const uint8_t* b, int c, uint32_t* r) {
        const gg_u32x2 sc = *(gg_gu64a2)(const void*)(b + 192 + 8 * c);
        r[12] = sc.x;
        r[13] = sc.y;
        r[14] = gg_u16(b + 208);
    }
    __device__ static __forceinline__ void load(const uint8_t* row, int s, int h, uint32_t* r) {
        const uint8_t* b = row + (long long)(s >> 1) * 210;
        const int c = s & 1;
#pragma unroll
        for (int i = 0; i < 4; ++i) lql(b, c, h, i, r);
        lqh(b, c, h, 0, r);
        lqh(b, c, h, 1, r);
        lsc(b, c, r);
    }
    /* Last uses: ql pair i at step 4 + i (next used at i), the scale words at 3 and 7 (next
     * used at 0 and 4); qh and d (used every step) go early. */
    template <int J>
    __device__ static __forceinline__ void reload(const uint8_t* row, int s, int h, uint32_t* r) {
        const uint8_t* b = row + (long long)(s >> 1) * 210;
        const int c = s & 1;
        if constexpr (J >= 4) lql(b, c, h, J - 4, r);
        if constexpr (J == 3) r[12] = *(gg_gu32a2)(const void*)(b + 192 + 8 * c);
        if constexpr (J == 7) r[13] = *(gg_gu32a2)(const void*)(b + 196 + 8 * c);
    }
    /* d sc: fma(d, sc + 128, -128 d), sc + 128 the byte of sc ^ 0x80 (v_cvt_f32_ubyte); d sc is exact
     * (11 x 8 bits), so the fma returns it. An infinite d -> NaN, as gg_wm_fin(d sc). */
    __device__ static __forceinline__ float scale(const uint32_t* r, int J, int) {
        const float d = gg_wm_fin(gg_h2f(r[14]));
        const uint32_t u = gg_byte((J < 4 ? r[12] : r[13]) ^ 0x80808080u, J & 3);
        return __builtin_fmaf(d, (float)u, -128.0f * d);
    }
    template <int J>
    __device__ static __forceinline__ r4d_u32x4 bfrag(const uint32_t* r, int, const Pf&, int) {
        constexpr int Q = J >> 1, LH = J & 1;
        constexpr int QL = 2 * (2 * (Q & 1) + LH), QH = 8 + 2 * LH;
        r4d_u32x4 b;
#pragma unroll
        for (int w = 0; w < 2; ++w) {
            const uint32_t qh = r[QH + w];
            const uint32_t hs = Q < 2 ? qh << (4 - 2 * Q) : qh >> (2 * Q - 4);   /* qh bits 2Q, 2Q + 1 -> 4, 5 */
            const uint32_t u = ((r[QL + w] >> (4 * (Q >> 1))) & 0x0F0F0F0Fu) | (hs & 0x30303030u);   /* v_bfi */
            uint32_t p[2];
            gg_wm_u128(u, p);
            b[2 * w] = p[0];
            b[2 * w + 1] = p[1];
        }
        return b;
    }
    __device__ static __forceinline__ void table(uint8_t*) {}
};

/* Q5_K. Slab s is the chunk pair c = s & 1 of block s >> 1 (64-value chunks j = 2c, 2c + 1);
 * 32-value group g = J >> 1 (chunk j = 2c + (g >> 1), nibble hi = g & 1), l = 16 (J & 1) + 8h + t.
 * The WMMA sees 128 + q5, so P = sum x (128 + q5) and y = d1 P - (128 d1 + m1) sum x: one fma on
 * the staged group sum (the min term and the offset together). */
template <> struct Wq<GG_Q5_K> : WqBase {
    static constexpr int RAW = 16, SPG = 2, TB = 0, XG = 32, MINS = 1, ROLL = 1, GUARD = 1, PIPE = 0;
    static constexpr uint32_t EARLY = 0xf00fu;   /* d / dmin, scales (0..3) and qh pairs (12..15) */
    static constexpr float XGK = 1.0f;
    __device__ static __forceinline__ int xoff(int J, int h) { return 16 * J + 8 * h; }
    /* ql pair i (chunk 2c + (i >> 1), l-half i & 1), qh pair i (l-half), d / dmin and scales. */
    __device__ static __forceinline__ void lql(const uint8_t* b, int c, int h, int i, uint32_t* r) {
        const gg_u32x2 q = *(gg_gu64a2)(const void*)(b + 48 + 32 * (2 * c + (i >> 1)) + 16 * (i & 1) + 8 * h);
        r[4 + 2 * i] = q.x;
        r[5 + 2 * i] = q.y;
    }
    __device__ static __forceinline__ void lqh(const uint8_t* b, int h, int i, uint32_t* r) {
        const gg_u32x2 q = *(gg_gu64a2)(const void*)(b + 16 + 16 * i + 8 * h);
        r[12 + 2 * i] = q.x;
        r[13 + 2 * i] = q.y;
    }
    __device__ static __forceinline__ void lsc(const uint8_t* b, uint32_t* r) {
        r[0] = gg_d32(b);
        r[1] = gg_d32(b + 4);
        r[2] = gg_d32(b + 8);
        r[3] = gg_d32(b + 12);
    }
    __device__ static __forceinline__ void load(const uint8_t* row, int s, int h, uint32_t* r) {
        const uint8_t* b = row + (long long)(s >> 1) * 176;
        const int c = s & 1;
        lsc(b, r);
#pragma unroll
        for (int i = 0; i < 4; ++i) lql(b, c, h, i, r);
        lqh(b, h, 0, r);
        lqh(b, h, 1, r);
    }
    /* Last uses: ql pairs 0 / 1 at steps 2 / 3, 2 / 3 at 6 / 7 (next used two steps after
     * that, a slab on); d, scales and qh (used throughout) go early. */
    template <int J>
    __device__ static __forceinline__ void reload(const uint8_t* row, int s, int h, uint32_t* r) {
        const uint8_t* b = row + (long long)(s >> 1) * 176;
        const int c = s & 1;
        if constexpr (J == 2 || J == 3) lql(b, c, h, J - 2, r);
        if constexpr (J >= 6) lql(b, c, h, J - 4, r);
    }
    /* scale_min_k4(4c + g): q[g], q[g + 4], q[g + 8] are byte g of r[1], r[2], r[3]. */
    __device__ static __forceinline__ float scale(const uint32_t* r, int g, int s) {
        const uint32_t qa = gg_byte(r[1], g), qc = gg_byte(r[3], g);
        const uint32_t sc = (s & 1) ? ((qc & 0xFu) | ((qa >> 6) << 4)) : (qa & 63u);
        return gg_wm_fin(gg_h2f(r[0] & 0xffffu)) * (float)sc;   /* d sc exact; inf d -> NaN either way */
    }
    __device__ static __forceinline__ float mins(const uint32_t* r, int g, int s) {
        const uint32_t qb = gg_byte(r[2], g), qc = gg_byte(r[3], g);
        const uint32_t mn = (s & 1) ? ((qc >> 4) | ((qb >> 6) << 4)) : (qb & 63u);
        return -(128.0f * scale(r, g, s) + gg_wm_fin(gg_h2f(r[0] >> 16)) * (float)mn);
    }
    template <int J>
    __device__ static __forceinline__ r4d_u32x4 bfrag(const uint32_t* r, int, const Pf&, int s) {
        constexpr int G = J >> 1, JL = G >> 1, HI = G & 1, LH = J & 1;
        constexpr int QL = 4 + 2 * (2 * JL + LH), QH = 12 + 2 * LH;
        const int hb = 4 * (s & 1) + G;
        r4d_u32x4 b;
#pragma unroll
        for (int w = 0; w < 2; ++w) {
            const uint32_t u = ((r[QL + w] >> (4 * HI)) & 0x0F0F0F0Fu) | (((r[QH + w] >> hb) & 0x01010101u) << 4);
            uint32_t p[2];
            gg_wm_u128(u, p);
            b[2 * w] = p[0];
            b[2 * w + 1] = p[1];
        }
        return b;
    }
    __device__ static __forceinline__ void table(uint8_t*) {}
};

template <int T, int MT, bool MOE, typename OT>
__global__ __launch_bounds__(256) void gg_wm_kernel(GgTiledArgs A) {
    using W = Wq<T>;
    using Pf = typename W::Pf;
    constexpr int BM = 16 * MT;
    constexpr int XE = BM * kWmXP;                                  /* bf16 a staged slab */
    constexpr int XGE = W::XG > 0 ? kWmS / W::XG * BM : 0;          /* floats a slab's group sums */
    extern __shared__ __attribute__((aligned(16))) uint8_t gg_smem[];
    __shared__ int s_e, s_r0, s_r1, s_nmt, s_any;
    __shared__ int s_tok[BM];
    const int tid = (int)threadIdx.x, lane = tid & 31, wave = tid >> 5;
    int e = 0, r0, r1;
    if constexpr (MOE) {
        /* Slot blockIdx.x -> (expert, its tile), as gg_tiled_kernel. (Chunk-major -- a tile's 256-row
         * chunks together -- wins the all-VRAM bench but costs the real serve ~1.5x: the tiered
         * experts' weights stream better spread across the dispatch.) */
        if (wave == 0) {
            if (lane == 0) s_e = -1;
            const uint32_t slot = blockIdx.x;
            uint32_t base = 0;
            for (int e0 = 0; e0 < A.n_expert; e0 += 32) {
                const int ee = e0 + lane;
                int s = 0, t = 0;
                if (ee < A.n_expert) gg_range(A.off, ee, A.n_expert, A.M, &s, &t);
                const uint32_t tiles = (uint32_t)((t - s + BM - 1) / BM);
                const uint32_t inc = r4d_wave_prefix_u32(tiles, lane);
                const uint32_t tot = (uint32_t)__builtin_amdgcn_readlane((int)inc, 31);
                if (slot < base + tot) {
                    if (slot >= base + inc - tiles && slot < base + inc) {
                        s_e = ee;
                        s_r0 = s + (int)(slot - (base + inc - tiles)) * BM;
                        s_r1 = min(s_r0 + BM, t);
                    }
                    break;
                }
                base += tot;
            }
        }
        __syncthreads();
        e = s_e;
        if (e < 0) return;
        r0 = s_r0;
        r1 = s_r1;
    } else {
        r0 = (int)blockIdx.x * BM;
        r1 = min(r0 + BM, A.M);
    }
    if (tid == 0) {
        s_nmt = 0;
        s_any = 0;
    }
    if (tid < BM) {
        const int i = r0 + tid;
        int tk = -1;
        if (i < r1) {
            if constexpr (MOE) tk = gg_moe_tok(A.sorted, i, A.top_k, A.a_sorted, A.AR);
            else tk = i;
        }
        s_tok[tid] = tk;
    }
    __syncthreads();
    if (tid < BM && s_tok[tid] >= 0) {
        atomicMax(&s_nmt, tid / 16 + 1);
        atomicMax(&s_any, s_tok[tid]);
    }
    __syncthreads();
    const int nmt = __builtin_amdgcn_readfirstlane(s_nmt);   /* 16-row tiles up to the last live row */
    const int n0 = (int)blockIdx.y * kWmBN;
    if (nmt == 0) {
        for (int i = tid; i < (r1 - r0) * kWmBN; i += 256) {
            const int n = n0 + (i & (kWmBN - 1));
            if (n < A.N) gg_put((OT*)A.y + (long long)(r0 + i / kWmBN) * A.y_ld + n, 0.0f);
        }
        return;
    }
    W::table(gg_smem);
    /* Two staged slabs (slab s in buffer s & 1) and, XG > 0, their rows' group sums times XGK,
     * [group][row]. One barrier a slab: slab s + 1 is stored into the other buffer once slab s is
     * computed, and the barrier after it both publishes it and frees buffer s & 1. */
    uint16_t* Xs = (uint16_t*)(void*)(gg_smem + W::TB);
    float* Xg = (float*)(void*)(gg_smem + W::TB + 2 * XE * 2);
    const uint8_t* wb = A.w;
    if constexpr (MOE) wb = A.wtab ? A.wtab[e] : A.w + (long long)e * A.w_es;
    const int h = lane >> 4, c16 = lane & 15;
    const uint8_t* wr[2];
#pragma unroll
    for (int nt = 0; nt < 2; ++nt) {
        const int n = n0 + wave * 32 + nt * 16 + c16;
        wr[nt] = wb + (long long)(n < A.N ? n : A.N - 1) * A.w_ld;
    }
    /* Activation staging: MT 16-byte chunks a thread a slab (row q >> 4, values 8 (q & 15)); the
     * sixteen chunks of a row are sixteen consecutive lanes, so a group's sum is a shuffle away.
     * A dead row stages a live row (rows are independent; its outputs are written as zeros), so
     * every load is unconditional. */
    const int tany = s_any;
    const uint16_t* xsrc[MT];
    int xdo[MT];
#pragma unroll
    for (int i = 0; i < MT; ++i) {
        const int q = tid + 256 * i, row = q >> 4, kc = (q & 15) * 8;
        const int tk = s_tok[row];
        xsrc[i] = A.x + (long long)(tk >= 0 ? tk : tany) * A.x_ld + kc;
        xdo[i] = row * kWmXP + kc;
    }
    r4d_u32x4 xr[MT];
    auto xload = [&](int s) {
#pragma unroll
        for (int i = 0; i < MT; ++i) xr[i] = *(gg_gu128)(const void*)(xsrc[i] + s * kWmS);
    };
    auto xstore = [&](int b) {
        uint16_t* xs = Xs + b * XE;
#pragma unroll
        for (int i = 0; i < MT; ++i) {
            *(r4d_u32x4*)(void*)(xs + xdo[i]) = xr[i];
            if constexpr (W::XG > 0) {
                const int q = tid + 256 * i;
                float sm = 0.0f;
#pragma unroll
                for (int k = 0; k < 4; ++k) sm += bf16w_lo(xr[i][k]) + bf16w_hi(xr[i][k]);
                /* Lane-pair (quad) sums by DPP, not an LDS bpermute queued behind the slab's LDS
                 * traffic; every lane of the group then holds the same sum (a + b == b + a) and
                 * stores it. */
                sm += __int_as_float(__builtin_amdgcn_mov_dpp(__float_as_int(sm), 0xB1, 0xF, 0xF, false));
                if constexpr (W::XG == 32)
                    sm += __int_as_float(__builtin_amdgcn_mov_dpp(__float_as_int(sm), 0x4E, 0xF, 0xF, false));
                Xg[b * XGE + ((q & 15) * 8 / W::XG) * BM + (q >> 4)] = W::XGK * sm;
            }
        }
    };
    const int S = A.K / kWmS;
    /* Weight rows prefetched into L2 three slabs ahead (s_prefetch_data, no VGPRs): every second
     * slab each wave touches its 32 rows' bytes of slabs s + 3, s + 4 (PFL + 1 lines of 128 B), so
     * the register loads a slab ahead hit L2 instead of waiting out DRAM. */
    const uint8_t* prow = gg_sptr(wb + (long long)(n0 + __builtin_amdgcn_readfirstlane(wave) * 32) * A.w_ld);
    const int prmax = __builtin_amdgcn_readfirstlane(A.N - 1 - (n0 + wave * 32));   /* rows past N: the last */
    const long long psb = A.w_ld / S;                                             /* bytes a slab a row */
    const int pfl = (int)min(31LL, (2 * psb + 127) / 128);
    auto prefetch = [&](int s) {
        const uint8_t* p = prow + (long long)min(s + 3, S - 1) * psb;
#pragma unroll 1
        for (int i = 0; i < 32; ++i) {
            __builtin_amdgcn_s_prefetch_data(p, pfl);
            if (i < prmax) p += A.w_ld;
        }
    };
    const uint16_t* xa = Xs + c16 * kWmXP;
    const float* xgl = Xg + 8 * h;
    /* The whole K loop for NM live 16-row tiles (NM a constant: no branch splits a step, and its
     * LDS reads issue ahead of the WMMAs). GUARD (Q5_K): one loop for every live count, a tile at
     * a time behind a guard (its branch-free bodies spill). */
    auto run = [&](auto nmc) {
        constexpr int NM = decltype(nmc)::value;
        auto live = [&](int mt) { return !W::GUARD || mt < nmt; };
        gg_v8f acc[NM][2];
#pragma unroll
        for (int i = 0; i < NM; ++i)
#pragma unroll
            for (int j = 0; j < 2; ++j) acc[i][j] = (gg_v8f)(0.0f);
        /* Raw weight words: the EARLY ones in two sets (slab s computes from set s & 1 while set
         * (s + 1) & 1 loads), the ROLL types' others in one set reloaded in place. */
        uint32_t rE[2][2][W::RAW], rR[2][W::RAW];
        xload(0);
#pragma unroll
        for (int nt = 0; nt < 2; ++nt) {
            uint32_t t[W::RAW];
            W::load(wr[nt], 0, h, t);
#pragma unroll
            for (int k = 0; k < W::RAW; ++k) {
                if ((W::EARLY >> k) & 1u) rE[0][nt][k] = t[k];
                else rR[nt][k] = t[k];
            }
        }
        xstore(0);
        xload(1);
        /* B fragments run a K step ahead: step J computes step J + 1's (step 7 the next slab's step
         * 0) after issuing its own WMMAs, which hide the table reads (issued at the step's start)
         * and give the WMMAs' results time before the scale fmas. */
        r4d_u32x4 bf[2][2];
        Pf pf[2];
        lds_barrier();   /* the table (and slab 0) complete before step 0's table reads */
        {
            uint32_t rc[2][W::RAW];
#pragma unroll
            for (int nt = 0; nt < 2; ++nt)
#pragma unroll
                for (int k = 0; k < W::RAW; ++k) rc[nt][k] = ((W::EARLY >> k) & 1u) ? rE[0][nt][k] : rR[nt][k];
            if constexpr (W::PIPE) {
#pragma unroll
                for (int nt = 0; nt < 2; ++nt) W::template pre<0>(rc[nt], h, gg_smem, pf[nt]);
#pragma unroll
                for (int nt = 0; nt < 2; ++nt) bf[0][nt] = W::template bfrag<0>(rc[nt], h, pf[nt], 0);
            }
        }
        /* Slab s from buffer / raw set PB = s & 1. Step J: (a) step J + 1's A fragments and table
         * reads, (b) its WMMAs, (c) step J + 1's chain inits (CINIT), (d) step J + 1's B fragments,
         * (e) its scale fmas, then the ROLL reloads. */
        auto slab = [&](auto pc, int s) {
            constexpr int PB = decltype(pc)::value;
            uint32_t rc[2][W::RAW];
#pragma unroll
            for (int nt = 0; nt < 2; ++nt)
#pragma unroll
                for (int k = 0; k < W::RAW; ++k) rc[nt][k] = ((W::EARLY >> k) & 1u) ? rE[PB][nt][k] : rR[nt][k];
            /* Every load is unconditional (past the end they reread the last slab): a load skipped
             * on some path leaves the wait-count pass assuming the worst, a wait for the loads just
             * issued. */
            const int sn = s + 1 < S ? s + 1 : s;
            if constexpr (PB == 0) prefetch(s);
#pragma unroll
            for (int nt = 0; nt < 2; ++nt) {
                uint32_t t[W::RAW];
                W::load(wr[nt], sn, h, t);   /* the non-early words' loads are dead */
#pragma unroll
                for (int k = 0; k < W::RAW; ++k)
                    if ((W::EARLY >> k) & 1u) rE[PB ^ 1][nt][k] = t[k];
            }
            const uint16_t* xb = xa + PB * XE;
            const float* xg = xgl + PB * XGE;
            gg_v8f P[NM][2];
            r4d_u32x4 af[2][NM];
            gg_v8f ci[NM];
#pragma unroll
            for (int mt = 0; mt < NM; ++mt) {
                if (live(mt)) {
                    af[0][mt] = *(const r4d_u32x4*)(const void*)(xb + mt * 16 * kWmXP + W::xoff(0, h));
                    if constexpr (W::CINIT && W::PIPE) ci[mt] = *(const gg_v8f*)(const void*)(xg + mt * 16);
                }
            }
            gg_for<8>([&](auto jc) {
                constexpr int J = decltype(jc)::value, C = J & 1;
                /* (a) */
                if constexpr (!W::PIPE) {   /* (Pf is empty) */
                    if constexpr (J < 7) {
#pragma unroll
                        for (int mt = 0; mt < NM; ++mt)
                            if (live(mt))
                                af[C ^ 1][mt] = *(const r4d_u32x4*)(const void*)(xb + mt * 16 * kWmXP + W::xoff(J + 1, h));
                    }
#pragma unroll
                    for (int nt = 0; nt < 2; ++nt) bf[C][nt] = W::template bfrag<J>(rc[nt], h, pf[nt], s);
                } else if constexpr (J < 7) {
#pragma unroll
                    for (int mt = 0; mt < NM; ++mt)
                        if (live(mt))
                            af[C ^ 1][mt] = *(const r4d_u32x4*)(const void*)(xb + mt * 16 * kWmXP + W::xoff(J + 1, h));
#pragma unroll
                    for (int nt = 0; nt < 2; ++nt) W::template pre<J + 1>(rc[nt], h, gg_smem, pf[nt]);
                } else {
#pragma unroll
                    for (int nt = 0; nt < 2; ++nt) {
#pragma unroll
                        for (int k = 0; k < W::RAW; ++k) rc[nt][k] = ((W::EARLY >> k) & 1u) ? rE[PB ^ 1][nt][k] : rR[nt][k];
                        W::template pre<0>(rc[nt], h, gg_smem, pf[nt]);
                    }
                }
                gg_v8f g8[NM];
                if constexpr (W::MINS && W::PIPE && J % W::SPG == W::SPG - 1) {
#pragma unroll
                    for (int mt = 0; mt < NM; ++mt)
                        if (live(mt)) g8[mt] = *(const gg_v8f*)(const void*)(xg + (J * 16 / W::XG) * BM + mt * 16);
                }
                /* (b) */
#pragma unroll
                for (int mt = 0; mt < NM; ++mt) {
                    if (live(mt)) {
                        if constexpr (J % W::SPG == 0) {
                            gg_v8f c0 = (gg_v8f)(0.0f);
                            if constexpr (W::CINIT && W::PIPE) c0 = ci[mt];
                            else if constexpr (W::CINIT) c0 = *(const gg_v8f*)(const void*)(xg + (J * 16 / W::XG) * BM + mt * 16);
#pragma unroll
                            for (int nt = 0; nt < 2; ++nt) P[mt][nt] = gg_wmma(af[C][mt], bf[C][nt], c0);
                        } else {
#pragma unroll
                            for (int nt = 0; nt < 2; ++nt) P[mt][nt] = gg_wmma(af[C][mt], bf[C][nt], P[mt][nt]);
                        }
                    }
                }
                /* (c) */
                if constexpr (W::CINIT && W::PIPE && J < 7 && (J + 1) % W::SPG == 0) {
#pragma unroll
                    for (int mt = 0; mt < NM; ++mt)
                        if (live(mt)) ci[mt] = *(const gg_v8f*)(const void*)(xg + ((J + 1) * 16 / W::XG) * BM + mt * 16);
                }
                /* (d) */
                if constexpr (W::PIPE) {
#pragma unroll
                    for (int nt = 0; nt < 2; ++nt)
                        bf[C ^ 1][nt] = W::template bfrag<(J + 1) & 7>(rc[nt], h, pf[nt], J < 7 ? s : sn);
                }
                /* (e) */
                if constexpr (J % W::SPG == W::SPG - 1) {
                    float sc[2], mn[2];
                    if constexpr (J < 7 || !W::PIPE) {
#pragma unroll
                        for (int nt = 0; nt < 2; ++nt) {
                            sc[nt] = W::scale(rc[nt], J / W::SPG, s);
                            if constexpr (W::MINS) mn[nt] = W::mins(rc[nt], J / W::SPG, s);
                        }
                    } else {   /* rc is the next slab's now: this slab's words */
#pragma unroll
                        for (int nt = 0; nt < 2; ++nt) {
                            uint32_t ro[W::RAW];
#pragma unroll
                            for (int k = 0; k < W::RAW; ++k) ro[k] = ((W::EARLY >> k) & 1u) ? rE[PB][nt][k] : rR[nt][k];
                            sc[nt] = W::scale(ro, J / W::SPG, s);
                            if constexpr (W::MINS) mn[nt] = W::mins(ro, J / W::SPG, s);
                        }
                    }
#pragma unroll
                    for (int mt = 0; mt < NM; ++mt) {
                        if (live(mt)) {
                            if constexpr (W::MINS && !W::PIPE) g8[mt] = *(const gg_v8f*)(const void*)(xg + (J * 16 / W::XG) * BM + mt * 16);
#pragma unroll
                            for (int nt = 0; nt < 2; ++nt)
#pragma unroll
                                for (int q = 0; q < 8; ++q) {
                                    acc[mt][nt][q] = __builtin_fmaf(P[mt][nt][q], sc[nt], acc[mt][nt][q]);
                                    if constexpr (W::MINS) acc[mt][nt][q] = __builtin_fmaf(g8[mt][q], mn[nt], acc[mt][nt][q]);
                                }
                        }
                    }
                    /* The step's sums here (each value its own VGPR, so they stay in-place v_fmac /
                     * dual-issue), not sunk past the slab with every P kept live. */
#pragma unroll
                    for (int mt = 0; mt < NM; ++mt)
#pragma unroll
                        for (int nt = 0; nt < 2; ++nt) gg_pin8(acc[mt][nt]);
                }
                if constexpr (W::ROLL) {
#pragma unroll
                    for (int nt = 0; nt < 2; ++nt) W::template reload<J>(wr[nt], sn, h, rR[nt]);
                }
                /* Mid-slab: stage slab s + 1 into the other buffer (its loads, issued mid-slab s - 1,
                 * had a slab to land) and start slab s + 2's; the slab's remaining steps hide it. The
                 * barrier after the slab both publishes s + 1 and frees this buffer (the last slab
                 * stages a buffer nobody reads). */
                if constexpr (J == 3) {
                    xstore(PB ^ 1);
                    xload(s + 2 < S ? s + 2 : S - 1);
                }
                /* A step's reads issue together, but no further ahead: hoisting the next steps'
                 * fragments spills the wide-block types. */
                __builtin_amdgcn_sched_barrier(0);
            });
            lds_barrier();
        };
        for (int s = 0; s < S; s += 2) {   /* S is even (K % 256 == 0) */
            slab(std::integral_constant<int, 0>{}, s);
            slab(std::integral_constant<int, 1>{}, s + 1);
        }
        gg_for<MT>([&](auto mc) {
            constexpr int mt = decltype(mc)::value;
#pragma unroll
            for (int nt = 0; nt < 2; ++nt) {
                const int n = n0 + wave * 32 + nt * 16 + c16;
                if (n >= A.N) continue;
#pragma unroll
                for (int q = 0; q < 8; ++q) {
                    const int lr = mt * 16 + 8 * h + q, row = r0 + lr;
                    if (row >= r1) continue;
                    float v = 0.0f;
                    if constexpr (mt < NM) v = s_tok[lr] >= 0 ? acc[mt][nt][q] : 0.0f;
                    gg_put((OT*)A.y + (long long)row * A.y_ld + n, v);
                }
            }
        });
    };
    if constexpr (W::GUARD) {
        run(std::integral_constant<int, MT>{});
    } else {
        gg_for<MT>([&](auto ic) {
            constexpr int NM = decltype(ic)::value + 1;
            if (nmt == NM) run(std::integral_constant<int, NM>{});
        });
    }
}

/* ================================================================== embed_lookup */
template <int T>
__global__ __launch_bounds__(kGgThreads) void gg_embed_kernel(const int32_t* tok, const uint8_t* w,
                                                              long long w_ld, uint16_t* x,
                                                              long long x_ld, int M, int E, int V,
                                                              long long voff, float mult) {
    using Q = Gg<T>;
    extern __shared__ __attribute__((aligned(16))) uint8_t gg_smem[];
    gg_load_table<T>(gg_smem);
    __syncthreads();
    const void* tab = gg_smem;
    const int nU = E / Q::QK * Q::UPB;
    for (int m = (int)blockIdx.x; m < M; m += (int)gridDim.x) {
        const long long id = (long long)tok[m] - voff;
        uint16_t* xr = x + (long long)m * x_ld;
        if (id < 0 || id >= V) {
            for (int k = (int)threadIdx.x; k < E; k += kGgThreads) xr[k] = 0;
            continue;
        }
        const uint8_t* wr = w + id * w_ld;
        for (int U = (int)threadIdx.x; U < nU; U += kGgThreads) {
            const int b = U / Q::UPB, u = U - b * Q::UPB;
            uint32_t raw[Q::NR];
            Q::load(wr + (long long)b * Q::BB, u, raw);
            gg_for<4>([&](auto gi) {
                constexpr int G = decltype(gi)::value;
                float v[8];
                Q::template dec<G>(raw, u, tab, v);
                uint16_t* d = xr + b * Q::QK + Q::goff(u, G);
#pragma unroll
                for (int t = 0; t < 8; ++t) gg_put(d + t, v[t] * mult);
            });
        }
    }
}

/* ================================================================== host side */
struct GgType {
    const char* name;
    int t, qk, bb, tb;
};
constexpr GgType kGgTypes[] = {
    { "q8_0", GG_Q8_0, 32, 34, 0 },        { "q5_K", GG_Q5_K, 256, 176, 0 },
    { "q6_K", GG_Q6_K, 256, 210, 0 },      { "iq4_nl", GG_IQ4_NL, 32, 18, 64 },
    { "iq2_xxs", GG_IQ2_XXS, 256, 66, 2048 }, { "iq1_s", GG_IQ1_S, 256, 50, 16384 },
};
const GgType* gg_type(const char* s) {
    if (!s) return nullptr;
    for (const GgType& t : kGgTypes)
        if (!std::strcmp(t.name, s)) return &t;
    return nullptr;
}
int gg_tab_bytes(int t) {
    switch (t) {
    case GG_IQ4_NL: return Gg<GG_IQ4_NL>::TB;
    case GG_IQ2_XXS: return Gg<GG_IQ2_XXS>::TB;
    case GG_IQ1_S: return Gg<GG_IQ1_S>::TB;
    default: return 0;
    }
}
long long gg_r16(long long v) { return (v + 15) / 16 * 16; }

/* The activation rows staged whole in LDS: a row is K floats plus a pad of 4 every 32 (XR), and
 * as many rows as fit 36 KiB, at most `xm` (0 when one row does not fit). Past that a pass's rows
 * are staged in chunks of KC values, a multiple of 1024 (32 units of 32), as many as fit the same
 * 36 KiB for `xm` rows. Returns the buffer's floats. */
long long gg_xbuf(int xm, long long K, int* xlm, int* xr, int* kc) {
    *xr = (int)(K + K / 8);
    const long long f = 9216 / (K + K / 8);
    *xlm = (int)(f < xm ? f : xm);
    long long c = 9216 / ((long long)xm * 1152);
    if (c < 1) c = 1;
    const long long kr = (K + 1023) / 1024 * 1024;
    *kc = (int)(1024LL * c < kr ? 1024LL * c : kr);
    const long long whole = (long long)*xlm * *xr, chunk = (long long)xm * (*kc + *kc / 8);
    return *xlm >= xm ? whole : (whole > chunk ? whole : chunk);
}

bool gg_inner1(const RadTensor* t) { return t->rank < 2 || t->shape[t->rank - 1] == 1 || t->stride[t->rank - 1] == 1; }
bool gg_al16(const void* p, long long ld) { return ((uintptr_t)p & 15u) == 0 && ld % 8 == 0; }

/* r4d_gg_gemv_pin (bench hook, r4d_selftest --perfgg): the decode band of gemm_nt_ggml / logits_gemm_ggml at a pinned
 * rows-a-wave (1, 2 or 4) and grid cap, 0 = the rule. Every form keeps lane = unit mod 32, a lane's units in order and
 * the same butterfly, so the bits are the rule's whatever is pinned. */
int g_gg_pin_rpw = 0, g_gg_pin_grid = 0;

/* ------------------------------------------------------------------ the decode band's form (gg_gemv)
 *
 * gemm_nt_ggml's decode band (M <= kGgDecodeRows) launches gg_gemv_kernel in a form: RPW weight rows a wave and a
 * grid of at most `cap` blocks over the row groups. The stock rule takes two rows a wave from 3 activation rows when
 * N has at least 2048 rows, else one, and caps the grid at 256. One card's bench (r4d_selftest --perfgg, DeepSeek-
 * V4.1-Flash's dense TP4 shapes) found other forms up to a third faster at some (type, shape, M): more blocks for a
 * wide N at one row (the grid of 256 leaves CUs idle while each block walks four row groups), two rows a wave for a
 * narrow N at 4 and 8 rows, four for engram_kv at 8. The runtime switch gg_gemv picks:
 *
 *   0  the stock rule, byte for byte today's launch (the default; RADIANCE_DS41_GG_GEMV unset)
 *   1  the measured table kGgForms (r4d_ds41_gg_forms.h, generated by tools/gg_forms.py from the bench's lines): an
 *      entry names (type, N, K, an M band) and the form; any other key, and logits_gemm_ggml, keep the stock rule
 *
 * The bits are the same in every form, by construction, not by measurement alone. A form changes only which wave
 * of which block computes an output row and how many units a lane keeps in flight; the arithmetic of one output
 * (row n, activation row m) does not move:
 *   - the wave that owns row n (n0 = row group x 8 x RPW + wave x RPW, r = n - n0) sums it in acc[r][m] alone, and
 *     no other wave or block touches that output;
 *   - lane = unit mod 32 in every form: gg_row walks U = U0 + lane, + 32, + 64, ... and calls gg_unit for each in
 *     that order; UF (units in flight, 8 / 4 / 2 by RPW and the type) only batches the loads, the F loop then
 *     accumulates V = U + 32 F in ascending order, so a lane's sequence of units is the same at any RPW;
 *   - inside gg_unit, acc[r][m] += xv[t] * w[r][t] runs over the unit's four groups G and eight values t in order,
 *     with the same decoded w (Q::dec per row) and the same staged x for every RPW; the unit is compiled
 *     -ffp-contract=off (CMakeLists.txt), so every product is rounded on its own in every instantiation;
 *   - the activation rows are staged by gg_stage with the same XM, XLM, XR and KC (gg_xbuf takes M and K, not the
 *     form), whole or in K chunks, and a block that takes several row groups only reuses what it staged;
 *   - r4d_wave_sum closes the sum with one butterfly (xor 16, 8, 4, 2, 1) and lane 0 rounds it once to the output.
 * The grid only deals the row groups out to blocks (it = blockIdx.x, += gridDim.x). r4d_selftest --perfgg compares
 * every form's bytes with the stock rule's at every measured (type, shape, M), and its gg_gemv case the table's. */
struct GgForm {
    int ty;                       /* GG_* */
    int N, K;                     /* this rank's extents, as gemm_nt_ggml's N and K */
    int m_lo, m_hi;               /* activation rows, inclusive */
    int rpw;                      /* weight rows a wave: 1, 2 or 4 */
    int cap;                      /* blocks at most (the row groups are dealt out round robin) */
};
#include "r4d_ds41_gg_forms.h"

/* The gg_gemv values this libr4d knows: 0 the stock rule, 1 the form table. Others are refused (rad_fn4_accepts /
 * rad_fn4_switch), so a later form can take the next value without an older libr4d misreading it. */
bool gg_gemv_known(int v) { return v == 0 || v == 1; }

/* RADIANCE_DS41_GG_GEMV at load: unset or empty is 0; a value this libr4d knows is taken; anything else is the stock
 * rule, said on stderr (the core's /admin/fn4 reports what this applies, rad_fn4_value). Then rad_fn4_switch's
 * "gg_gemv". */
int gg_gemv_env() {
    const char* v = std::getenv("RADIANCE_DS41_GG_GEMV");
    if (!v || !*v) return 0;
    char* end = nullptr;
    const long n = std::strtol(v, &end, 10);
    if (end == v || *end || !gg_gemv_known((int)n)) {
        std::fprintf(stderr, "radiance: libr4d: RADIANCE_DS41_GG_GEMV=%s is not a decode-band form this libr4d knows "
                             "(0 the stock rule, 1 the form table): the stock rule\n", v);
        return 0;
    }
    if (n == 1)
        std::fprintf(stderr, "radiance: libr4d: gemm_nt_ggml's decode band takes the measured form table (%d entries; "
                             "RADIANCE_DS41_GG_GEMV=1, the fn4 switch gg_gemv)\n", (int)R4D_GG_FORMS_N);
    return (int)n;
}
std::atomic<int> g_gg_gemv{ gg_gemv_env() };

/* The table's form for (type, N, K, M), or false: the stock rule. A linear scan of a few dozen entries, run only
 * when a launch is issued live (a recorded pass plays its packets). */
bool gg_form(int ty, long long N, long long K, long long M, int* rpw, int* cap) {
    for (const GgForm& f : kGgForms)
        if (f.ty == ty && f.N == N && f.K == K && M >= f.m_lo && M <= f.m_hi && f.rpw > 0 && f.cap > 0) {
            *rpw = f.rpw;
            *cap = f.cap;
            return true;
        }
    return false;
}
template <int T>
int gg_launch_gemv_t(RadStream s, int rpw, bool moe, bool f32out, const GgGemvArgs& A, unsigned grid,
                     unsigned lds) {
    if (!moe && rpw == 4 && T != GG_F32) {
        if (f32out) return R4D_EMIT(s, (gg_gemv_kernel<T, (T == GG_F32 ? 1 : 4), false, float>), dim3(grid), dim3(kGgThreads), lds, A);
        return R4D_EMIT(s, (gg_gemv_kernel<T, (T == GG_F32 ? 1 : 4), false, uint16_t>), dim3(grid), dim3(kGgThreads), lds, A);
    }
    if (moe) {
        if (rpw == 2 && T != GG_F32)
            return R4D_EMIT(s, (gg_gemv_kernel<T, (T == GG_F32 ? 1 : 2), true, uint16_t>), dim3(grid), dim3(kGgThreads), lds, A);
        return R4D_EMIT(s, (gg_gemv_kernel<T, 1, true, uint16_t>), dim3(grid), dim3(kGgThreads), lds, A);
    }
    if (f32out) {
        if (rpw == 2 && T != GG_F32)
            return R4D_EMIT(s, (gg_gemv_kernel<T, (T == GG_F32 ? 1 : 2), false, float>), dim3(grid), dim3(kGgThreads), lds, A);
        return R4D_EMIT(s, (gg_gemv_kernel<T, 1, false, float>), dim3(grid), dim3(kGgThreads), lds, A);
    }
    if (rpw == 2 && T != GG_F32)
        return R4D_EMIT(s, (gg_gemv_kernel<T, (T == GG_F32 ? 1 : 2), false, uint16_t>), dim3(grid), dim3(kGgThreads), lds, A);
    return R4D_EMIT(s, (gg_gemv_kernel<T, 1, false, uint16_t>), dim3(grid), dim3(kGgThreads), lds, A);
}

template <int T>
int gg_launch_tiled_t(RadStream s, int bm, bool moe, bool f32out, const GgTiledArgs& A, dim3 grid,
                      unsigned lds) {
    if (bm == 32) {
        if (moe) return R4D_EMIT(s, (gg_tiled_kernel<T, 32, true, uint16_t>), grid, dim3(kGgThreads), lds, A);
        if (f32out) return R4D_EMIT(s, (gg_tiled_kernel<T, 32, false, float>), grid, dim3(kGgThreads), lds, A);
        return R4D_EMIT(s, (gg_tiled_kernel<T, 32, false, uint16_t>), grid, dim3(kGgThreads), lds, A);
    }
    if (moe) return R4D_EMIT(s, (gg_tiled_kernel<T, 128, true, uint16_t>), grid, dim3(kGgThreads), lds, A);
    if (f32out) return R4D_EMIT(s, (gg_tiled_kernel<T, 128, false, float>), grid, dim3(kGgThreads), lds, A);
    return R4D_EMIT(s, (gg_tiled_kernel<T, 128, false, uint16_t>), grid, dim3(kGgThreads), lds, A);
}

int gg_launch_gemv(RadStream s, int ty, int rpw, bool moe, bool f32out, const GgGemvArgs& A,
                   unsigned grid, unsigned lds) {
#define GG_CALL_GEMV(T) gg_launch_gemv_t<T>(s, rpw, moe, f32out, A, grid, lds)
    switch (ty) {
    case GG_Q8_0: return GG_CALL_GEMV(GG_Q8_0);
    case GG_Q5_K: return GG_CALL_GEMV(GG_Q5_K);
    case GG_Q6_K: return GG_CALL_GEMV(GG_Q6_K);
    case GG_IQ4_NL: return GG_CALL_GEMV(GG_IQ4_NL);
    case GG_IQ2_XXS: return GG_CALL_GEMV(GG_IQ2_XXS);
    case GG_IQ1_S: return GG_CALL_GEMV(GG_IQ1_S);
    case GG_F32: return GG_CALL_GEMV(GG_F32);
    default: return R4D_NO(RAD_E_DTYPE);
    }
#undef GG_CALL_GEMV
}

/* The decode kernel's shape a type: the I-quants' three-word units keep every unit of a lane's
 * rows in flight (RPW x UF units: 8 x 3 for a row of up to 96 units, the down projection's 72;
 * 4 x 5 up to 160, gate_up's), the multi-word types two rows of two, the float form one. */
template <int T, int NW>
int gg_launch_md_t(RadStream s, int UK, int xmx, const GgMdArgs& A, unsigned grid, unsigned lds) {
    const dim3 g(grid), b(NW * 32);
#define GG_MD_X(R, F)                                                                              \
    (xmx == 1 ? R4D_EMIT(s, (gg_md_kernel<T, R, F, NW, 1>), g, b, lds, A)                           \
              : R4D_EMIT(s, (gg_md_kernel<T, R, F, NW, kMdXM>), g, b, lds, A))
    if constexpr (T == GG_IQ1_S || T == GG_IQ2_XXS) {
        if (UK <= 96) return GG_MD_X(4, 3);
        if (UK <= 160) return GG_MD_X(4, 5);
        return GG_MD_X(2, 8);
    } else if constexpr (T == GG_F32) {
        return GG_MD_X(1, 2);
    } else {
        return GG_MD_X(2, 2);
    }
#undef GG_MD_X
}

/* The dot path (16 waves a block, a row a segment): RPW 4 x UF 3 up to 96 units (down), 2 x 5 up to
 * 160 (gate_up). */
template <int T>
int gg_launch_mdd_t(RadStream s, int UK, int xmx, const GgMdArgs& A, unsigned grid, unsigned lds) {
    const dim3 g(grid), b(16 * 32);
#define GG_MDD_X(R, F) R4D_EMIT(s, (gg_md_kernel<T, R, F, 16, 1, true>), g, b, lds, A)
    (void)xmx;
    if (UK <= 96) return GG_MDD_X(4, 3);
    if (UK <= 160) return GG_MDD_X(2, 5);
    return GG_MDD_X(2, 8);
#undef GG_MDD_X
}

int gg_launch_mdd(RadStream s, int ty, int UK, int xmx, const GgMdArgs& A, unsigned grid, unsigned lds) {
    if (ty == GG_IQ1_S) return gg_launch_mdd_t<GG_IQ1_S>(s, UK, xmx, A, grid, lds);
    if (ty == GG_IQ2_XXS) return gg_launch_mdd_t<GG_IQ2_XXS>(s, UK, xmx, A, grid, lds);
    return R4D_NO(RAD_E_DTYPE);
}

/* 16 waves a block. */
int gg_launch_md(RadStream s, int ty, int UK, int xmx, const GgMdArgs& A, unsigned grid, unsigned lds) {
#define GG_CALL_MD(T) gg_launch_md_t<T, 16>(s, UK, xmx, A, grid, lds)
    switch (ty) {
    case GG_Q8_0: return GG_CALL_MD(GG_Q8_0);
    case GG_Q5_K: return GG_CALL_MD(GG_Q5_K);
    case GG_Q6_K: return GG_CALL_MD(GG_Q6_K);
    case GG_IQ4_NL: return GG_CALL_MD(GG_IQ4_NL);
    case GG_IQ2_XXS: return GG_CALL_MD(GG_IQ2_XXS);
    case GG_IQ1_S: return GG_CALL_MD(GG_IQ1_S);
    case GG_F32: return GG_CALL_MD(GG_F32);
    default: return R4D_NO(RAD_E_DTYPE);
    }
#undef GG_CALL_MD
}

/* The device's compute units, once a device. */
int gg_cu_count() {
    static int cache[64];
    int dev = 0;
    if (hipGetDevice(&dev) != hipSuccess || dev < 0 || dev >= 64) return 64;
    if (cache[dev] <= 0) {
        int v = 0;
        if (hipDeviceGetAttribute(&v, hipDeviceAttributeMultiprocessorCount, dev) != hipSuccess || v <= 0) v = 64;
        cache[dev] = v;
    }
    return cache[dev];
}

int gg_launch_tiled(RadStream s, int ty, int bm, bool moe, bool f32out, const GgTiledArgs& A,
                    dim3 grid, unsigned lds) {
#define GG_CALL_TILED(T) gg_launch_tiled_t<T>(s, bm, moe, f32out, A, grid, lds)
    switch (ty) {
    case GG_Q8_0: return GG_CALL_TILED(GG_Q8_0);
    case GG_Q5_K: return GG_CALL_TILED(GG_Q5_K);
    case GG_Q6_K: return GG_CALL_TILED(GG_Q6_K);
    case GG_IQ4_NL: return GG_CALL_TILED(GG_IQ4_NL);
    case GG_IQ2_XXS: return GG_CALL_TILED(GG_IQ2_XXS);
    case GG_IQ1_S: return GG_CALL_TILED(GG_IQ1_S);
    case GG_F32: return GG_CALL_TILED(GG_F32);
    default: return R4D_NO(RAD_E_DTYPE);
    }
#undef GG_CALL_TILED
}

/* LDS of the WMMA kernel: the table, the two staged slabs, their group sums. */
template <int T>
constexpr unsigned gg_wm_lds(int bm) {
    return (unsigned)(Wq<T>::TB + 2 * bm * kWmXP * 2 + (Wq<T>::XG > 0 ? 2 * (kWmS / Wq<T>::XG) * bm * 4 : 0));
}
/* 16-row tiles a block: three; IQ1_S four. IQ1_S at 4 is held to 2 blocks a WGP (LDS 50 KiB, 241+
 * VGPRs) and at 3 runs 3 (1.15x in the uniform-routing bench), but the real serve's skewed routing
 * splits more heavy experts into extra tiles, each re-reading the expert's weights. */
int gg_wm_mt(int ty) { return ty == GG_IQ1_S ? 4 : 3; }
template <int T>
int gg_launch_wm_t(bool moe, bool f32out, RadStream s, const GgTiledArgs& A, dim3 grid) {
    constexpr int MT = T == GG_IQ1_S ? 4 : 3;
    const unsigned lds = gg_wm_lds<T>(16 * MT);
    if (moe) return R4D_EMIT(s, (gg_wm_kernel<T, MT, true, uint16_t>), grid, dim3(256), lds, A);
    if (f32out) return R4D_EMIT(s, (gg_wm_kernel<T, MT, false, float>), grid, dim3(256), lds, A);
    return R4D_EMIT(s, (gg_wm_kernel<T, MT, false, uint16_t>), grid, dim3(256), lds, A);
}

int gg_launch_wm(RadStream s, int ty, bool moe, bool f32out, const GgTiledArgs& A, dim3 grid) {
    switch (ty) {
    case GG_IQ2_XXS: return gg_launch_wm_t<GG_IQ2_XXS>(moe, f32out, s, A, grid);
    case GG_IQ1_S: return gg_launch_wm_t<GG_IQ1_S>(moe, f32out, s, A, grid);
    case GG_Q8_0: return gg_launch_wm_t<GG_Q8_0>(moe, f32out, s, A, grid);
    case GG_Q6_K: return gg_launch_wm_t<GG_Q6_K>(moe, f32out, s, A, grid);
    case GG_Q5_K: return gg_launch_wm_t<GG_Q5_K>(moe, f32out, s, A, grid);
    default: return R4D_NO(RAD_E_DTYPE);
    }
}

int gg_launch_embed(RadStream s, int ty, const int32_t* tok, const uint8_t* w, long long w_ld,
                    uint16_t* x, long long x_ld, int M, int E, int V, long long voff, float mult) {
    const unsigned grid = (unsigned)(M < 4096 ? M : 4096);
    const unsigned lds = (unsigned)gg_r16(gg_tab_bytes(ty));
#define GG_CALL_EMBED(T) \
    R4D_EMIT(s, gg_embed_kernel<T>, dim3(grid), dim3(kGgThreads), lds, tok, w, w_ld, x, x_ld, M, E, V, voff, mult)
    switch (ty) {
    case GG_Q8_0: return GG_CALL_EMBED(GG_Q8_0);
    case GG_Q5_K: return GG_CALL_EMBED(GG_Q5_K);
    case GG_Q6_K: return GG_CALL_EMBED(GG_Q6_K);
    case GG_IQ4_NL: return GG_CALL_EMBED(GG_IQ4_NL);
    case GG_IQ2_XXS: return GG_CALL_EMBED(GG_IQ2_XXS);
    case GG_IQ1_S: return GG_CALL_EMBED(GG_IQ1_S);
    case GG_F32: return GG_CALL_EMBED(GG_F32);
    default: return R4D_NO(RAD_E_DTYPE);
    }
#undef GG_CALL_EMBED
}

/* The weight operand of a linear: native blocks (u8, [N, K] declared or [N, row bytes]) or the
 * float logical form [N, K]. Sets the kernel type and the row stride in bytes. */
int gg_weight2(const RadTensor* w, const GgType* gt, long long N, long long K, int* ty, long long* ld) {
    if (!w || !w->data || w->rank != 2 || w->shape[0] != N) return R4D_NO(RAD_E_SHAPE);
    const long long rb = K / gt->qk * gt->bb;
    if (w->dtype == RAD_U8) {
        if (w->shape[1] != rb && w->shape[1] != K) return R4D_NO(RAD_E_SHAPE);
        if (gt->t == GG_Q5_K && ((uintptr_t)w->data & 3u)) return R4D_NO(RAD_E_STRIDE);
        if ((uintptr_t)w->data & 1u) return R4D_NO(RAD_E_STRIDE);
        *ty = gt->t;
        *ld = rb;
        return RAD_OK;
    }
    if (w->dtype == RAD_F32) {
        if (w->shape[1] != K || !gg_inner1(w) || ((uintptr_t)w->data & 3u)) return R4D_NO(RAD_E_SHAPE);
        *ty = GG_F32;
        *ld = (long long)w->stride[0] * 4;
        return RAD_OK;
    }
    return R4D_NO(RAD_E_DTYPE);
}

/* gemm_nt_ggml and logits_gemm_ggml: y[M, N] = x[M, K] . w[N, K]^T. */
int gg_gemm(const RadArgs* a, RadStream s, const char* nN, const char* nK, bool logits, bool gemv) {
    if (!a || a->n_t < 3) return R4D_NO(RAD_E_INVAL);
    const RadTensor *x = r4d_opt(a, 0), *w = r4d_opt(a, 1), *y = r4d_opt(a, 2);
    if (!x || !w || !y || !x->data || !w->data || !y->data) return R4D_NO(RAD_E_INVAL);
    const GgType* gt = gg_type(r4d_gets(a, "type"));
    if (!gt) return R4D_NO(RAD_E_DTYPE);
    const long long N = r4d_geti_or(a, nN, 0), K = r4d_geti_or(a, nK, 0);
    if (N <= 0 || K <= 0 || K % gt->qk || N > 0x7fffffffLL || K > 0x7fffffffLL) return R4D_NO(RAD_E_SHAPE);
    if (x->rank != 2 || x->dtype != RAD_BF16 || x->shape[1] != K || !gg_inner1(x)) return R4D_NO(RAD_E_SHAPE);
    const long long M = x->shape[0], Mb = r4d_geti_or(a, "M", 0);
    if (M <= 0 || M > 0x7fffffffLL || (Mb > 0 && M > Mb)) return R4D_NO(RAD_E_SHAPE);
    if (y->rank != 2 || y->dtype != (logits ? (uint32_t)RAD_F32 : (uint32_t)RAD_BF16) ||
        y->shape[1] != N || y->shape[0] < M || !gg_inner1(y))
        return R4D_NO(RAD_E_SHAPE);
    int ty = 0;
    long long w_ld = 0;
    const int rc = gg_weight2(w, gt, N, K, &ty, &w_ld);
    if (rc != RAD_OK) return rc;
    const long long x_ld = M > 1 ? x->stride[0] : K, y_ld = M > 1 ? y->stride[0] : N;
    const int x_al = gg_al16(x->data, x_ld) ? 1 : 0;
    const long long tb = gg_r16(gg_tab_bytes(ty));
    /* Every pass of up to kGgDecodeRows rows runs the decode kernel, whichever row (gemv or tiled)
     * the engine picked: a row's outputs are then the same bits whatever else is in the pass
     * (decode, a speculative verify pass and a short prefill agree); the tiled kernel sums in
     * another order. */
    (void)gemv;
    if (M <= kGgDecodeRows) {
        GgGemvArgs A{};
        A.x = (const uint16_t*)x->data; A.x_ld = x_ld;
        A.w = (const uint8_t*)w->data; A.wtab = nullptr; A.w_ld = w_ld; A.w_es = 0;
        A.y = y->data; A.y_ld = y_ld;
        A.M = (int)M; A.N = (int)N; A.K = (int)K;
        A.XM = (int)(M < kGgXM ? M : kGgXM);
        const long long xbuf = gg_xbuf(A.XM, K, &A.XLM, &A.XR, &A.KC);
        int rpw = (M >= 3 && ty != GG_F32 && (N + 15) / 16 >= 128) ? 2 : 1;
        long long gcap = 256;
        /* gg_gemv = 1: the measured form of this (type, N, K, M), if the table has one (see GgForm); a bench pin
         * overrides it. Off, or no entry: the stock rule above. */
        if (!logits && ty != GG_F32 && g_gg_pin_rpw == 0 && g_gg_pin_grid == 0 &&
            g_gg_gemv.load(std::memory_order_relaxed) == 1) {
            int frpw = 0, fcap = 0;
            if (gg_form(ty, N, K, M, &frpw, &fcap)) {
                rpw = frpw;
                gcap = fcap;
            }
        }
        if (g_gg_pin_rpw > 0 && ty != GG_F32) rpw = g_gg_pin_rpw;
        const long long nrg = (N + 8 * rpw - 1) / (8 * rpw);
        A.rgpi = 1; A.ipe = (int)nrg;
        A.x_al = x_al;
        A.live_off = (int)tb; A.x_off = (int)tb;
        const long long lds = tb + xbuf * 4;
        if (g_gg_pin_grid > 0) gcap = g_gg_pin_grid;
        const unsigned grid = (unsigned)(nrg < gcap ? nrg : gcap);
        return gg_launch_gemv(s, ty, rpw, false, logits, A, grid, (unsigned)lds);
    }
    GgTiledArgs A{};
    A.x = (const uint16_t*)x->data; A.x_ld = x_ld;
    A.w = (const uint8_t*)w->data; A.wtab = nullptr; A.w_ld = w_ld; A.w_es = 0;
    A.y = y->data; A.y_ld = y_ld;
    A.M = (int)M; A.N = (int)N; A.K = (int)K;
    A.x_al = x_al; A.tab_bytes = (int)tb;
    /* The WMMA kernel (factored scales) for every block type DeepSeek-V4.1 uses. */
    if (x_al && ty != GG_F32 && ty != GG_IQ4_NL && K % (2 * kWmS) == 0 && (N + kWmBN - 1) / kWmBN <= 65535) {
        const int bmw = 16 * gg_wm_mt(ty);
        const long long gx = (M + bmw - 1) / bmw, gyw = (N + kWmBN - 1) / kWmBN;
        return gg_launch_wm(s, ty, false, logits, A, dim3((unsigned)gx, (unsigned)gyw));
    }
    const long long gy = (N + kTN - 1) / kTN;
    if (gy > 65535) return R4D_NO(RAD_E_SHAPE);
    const int bm = M <= 64 ? 32 : 128;
    const dim3 grid((unsigned)((M + bm - 1) / bm), (unsigned)gy);
    return gg_launch_tiled(s, ty, bm, false, logits, A, grid, (unsigned)(tb + 32 * (kTP + bm + 4) * 4));
}

/* moe_gemm_ggml: y[i] = a[row(i)] . w[e(i)]^T over the expert-sorted rows. */
int gg_moe(const RadArgs* a, RadStream s, bool gemv) {
    if (!a || a->n_t < 5) return R4D_NO(RAD_E_INVAL);
    const RadTensor *A_ = r4d_opt(a, 0), *W = r4d_opt(a, 1), *so = r4d_opt(a, 2), *of = r4d_opt(a, 3),
                    *Y = r4d_opt(a, 4);
    if (!A_ || !W || !so || !of || !Y || !A_->data || !W->data || !so->data || !of->data || !Y->data)
        return R4D_NO(RAD_E_INVAL);
    const GgType* gt = gg_type(r4d_gets(a, "type"));
    if (!gt) return R4D_NO(RAD_E_DTYPE);
    const long long N = r4d_geti_or(a, "N", 0), K = r4d_geti_or(a, "K", 0);
    const long long ne = r4d_geti_or(a, "n_expert", 0), top_k = r4d_geti_or(a, "top_k", 0);
    const char* ord = r4d_gets(a, "a_order");
    const bool a_sorted = ord && !std::strcmp(ord, "sorted");
    if (ord && !a_sorted && std::strcmp(ord, "token")) return R4D_NO(RAD_E_UNSUPPORTED);
    if (N <= 0 || K <= 0 || K % gt->qk || ne <= 0 || ne > kGgMaxExpert || top_k <= 0 ||
        N > 0x7fffffffLL || K > 0x7fffffffLL)
        return R4D_NO(RAD_E_SHAPE);
    if (A_->rank != 2 || A_->dtype != RAD_BF16 || A_->shape[1] != K || !gg_inner1(A_)) return R4D_NO(RAD_E_SHAPE);
    if (Y->rank != 2 || Y->dtype != RAD_BF16 || Y->shape[1] != N || !gg_inner1(Y)) return R4D_NO(RAD_E_SHAPE);
    const long long T = Y->shape[0], AR = A_->shape[0];
    if (T <= 0 || AR <= 0 || T > 0x7fffffffLL || AR > 0x7fffffffLL) return R4D_NO(RAD_E_SHAPE);
    if ((so->dtype != RAD_I32 && so->dtype != RAD_U32) || (of->dtype != RAD_I32 && of->dtype != RAD_U32) ||
        !r4d_contig(so) || !r4d_contig(of))
        return R4D_NO(RAD_E_DTYPE);
    if (r4d_numel(so) < T || r4d_numel(of) < ne + 1) return R4D_NO(RAD_E_SHAPE);
    if (W->rank != 3 || W->shape[0] < ne || W->shape[1] != N) return R4D_NO(RAD_E_SHAPE);
    const long long rb = K / gt->qk * gt->bb;
    int ty = 0;
    long long w_ld = 0, w_es = 0;
    const bool table = W->stride[0] == 0;
    if (W->dtype == RAD_U8) {
        if (W->shape[2] != rb && W->shape[2] != K) return R4D_NO(RAD_E_SHAPE);
        ty = gt->t;
        w_ld = rb;
        w_es = N * rb;
        if (!table && ((uintptr_t)W->data & (gt->t == GG_Q5_K ? 3u : 1u))) return R4D_NO(RAD_E_STRIDE);
    } else if (W->dtype == RAD_F32) {
        if (W->shape[2] != K || W->stride[2] != 1) return R4D_NO(RAD_E_SHAPE);
        ty = GG_F32;
        w_ld = (long long)W->stride[1] * 4;
        w_es = (long long)W->stride[0] * 4;
    } else {
        return R4D_NO(RAD_E_DTYPE);
    }
    const long long x_ld = AR > 1 ? A_->stride[0] : K, y_ld = T > 1 ? Y->stride[0] : N;
    const long long tb = gg_r16(gg_tab_bytes(ty));
    const long long tokens = a_sorted ? (T + top_k - 1) / top_k : AR;
    const long long L = ne < T ? ne : T;       /* experts that can have rows */
    /* The decode kernel (gg_md_kernel) when the routing fits its lists and a row fits LDS (64 KiB). */
    /* The I-quants' dot path: bf16 rows, each with its unit sums for IQ1_S. */
    /* Every pass whose sorted rows fit the decode kernels' lists takes them, whichever row (gemv or
     * tiled) the engine picked: a token's outputs are then the same bits whatever else is in the
     * pass (decode, a speculative verify pass and a short prefill agree). */
    if (T <= kMdMaxT && (ty == GG_IQ1_S || ty == GG_IQ2_XXS)) {
        const long long tbd = gg_r16(ty == GG_IQ1_S ? kMddTab1 : kMddTab2);
        const long long meta = gg_r16(8LL * kMdMaxT + 4LL * (3 * kMdMaxT + 1 + 3));
        const long long temp = gg_r16(8 * ne + 4 * (ne + 1) + 12 * T);
        const long long rowb = 2 * K + 4 * (K / 32) + 4;    /* bf16 row, unit sums, flag */
        long long xb = kMdLds > tbd + meta + 16 ? (kMdLds - tbd - meta - 16) / rowb : 0;
        if (xb > T) xb = T;
        const long long xbytes = gg_r16(xb * rowb) > temp ? gg_r16(xb * rowb) : temp;
        if (xb >= 1 && tbd + meta + xbytes <= kMdLds) {
            GgMdArgs A{};
            A.x = (const uint16_t*)A_->data; A.x_ld = x_ld;
            A.w = table ? nullptr : (const uint8_t*)W->data;
            A.wtab = table ? (const uint8_t* const*)W->data : nullptr;
            A.w_ld = w_ld; A.w_es = w_es;
            A.y = (uint16_t*)Y->data; A.y_ld = y_ld;
            A.sorted = (const int32_t*)so->data; A.off = (const int32_t*)of->data;
            A.T = (int)T; A.N = (int)N; A.K = (int)K;
            A.n_expert = (int)ne; A.top_k = (int)top_k; A.a_sorted = a_sorted ? 1 : 0; A.AR = (int)AR;
            A.x_al = gg_al16(A_->data, x_ld) ? 1 : 0;
            A.XB = (int)xb;
            /* A row a segment: an expert with r live rows streams r times (the decode routing gives
             * most live experts one row; the repeats mostly hit L2), every task on the one-row
             * pipelined form, no straggling multi-row tasks. */
            const int xmx = 1;
            A.XM = 1;
            A.meta_off = (int)tbd;
            A.x_off = (int)(tbd + meta);
            A.xs_off = (int)(tbd + meta + xb * 2 * K);
            A.raw_off = -1;
            A.raw_wave = 0;
            const unsigned lds = (unsigned)(tbd + meta + xbytes);
            /* Blocks a CU: as many as its LDS holds (a WGP's 128 KiB), at most two. */
            long long bpc = 131072 / lds;
            if (bpc > 2) bpc = 2;
            if (bpc < 1) bpc = 1;
            const long long gq = (long long)gg_cu_count() * bpc;
            return gg_launch_mdd(s, ty, (int)(K / 32), xmx, A, (unsigned)gq, lds);
        }
    }
    if (T <= kMdMaxT) {
        const long long meta = gg_r16(8LL * kMdMaxT + 4LL * (3 * kMdMaxT + 1 + 3));
        const long long temp = gg_r16(8 * ne + 4 * (ne + 1) + 12 * T);
        const long long room = kMdLds - tb - meta;
        /* One token: f32 rows (no widening in the loop), a segment a row. More: bf16 rows, up to
         * kMdXM a segment, as many staged together as fit. */
        const long long xbf = room > 0 ? room / (2 * K) : 0;
        const bool bf = tokens >= 2 && xbf >= 2;
        long long xb = room > 0 ? room / ((bf ? 2 : 4) * K) : 0;
        if (xb > T) xb = T;
        /* The I-quants' chunk buffers (md_step_stg): RPW rows of 4 blocks a wave, 16 waves. */
        const long long uk_ = K / gt->qk * (gt->qk == 256 ? 8 : 1);
        const bool iq = ty == GG_IQ1_S || ty == GG_IQ2_XXS;
        const long long rwave = iq ? (uk_ <= 160 ? 4 : 2) * ((4 * gt->bb + 15) / 16 * 16) : 0;
        const long long rbytes = rwave * 16;
        if (rbytes && xb > 1 && tb + meta + xb * (bf ? 2 : 4) * K + rbytes > kMdLds) {
            const long long r2 = (kMdLds - tb - meta - rbytes) / ((bf ? 2 : 4) * K);
            if (r2 >= (bf ? 2 : 1)) xb = r2;
        }
        const long long xbytes = xb * (bf ? 2 : 4) * K > temp ? xb * (bf ? 2 : 4) * K : temp;
        const bool stg = rbytes && tb + meta + xbytes + rbytes <= kMdLds;
        if (xb >= 1 && tb + meta + xbytes <= kMdLds) {
            GgMdArgs A{};
            A.x = (const uint16_t*)A_->data; A.x_ld = x_ld;
            A.w = table ? nullptr : (const uint8_t*)W->data;
            A.wtab = table ? (const uint8_t* const*)W->data : nullptr;
            A.w_ld = w_ld; A.w_es = w_es;
            A.y = (uint16_t*)Y->data; A.y_ld = y_ld;
            A.sorted = (const int32_t*)so->data; A.off = (const int32_t*)of->data;
            A.T = (int)T; A.N = (int)N; A.K = (int)K;
            A.n_expert = (int)ne; A.top_k = (int)top_k; A.a_sorted = a_sorted ? 1 : 0; A.AR = (int)AR;
            A.x_al = gg_al16(A_->data, x_ld) ? 1 : 0;
            A.XB = (int)xb;
            long long xm = bf ? (xb < kMdXM ? xb : kMdXM) : 1;
            if (xm > tokens) xm = tokens < 1 ? 1 : tokens;
            A.XM = (int)xm;
            A.meta_off = (int)tb;
            A.x_off = (int)(tb + meta);
            A.raw_off = stg ? (int)(tb + meta + xbytes) : -1;
            A.raw_wave = (int)rwave;
            const unsigned lds = (unsigned)(tb + meta + xbytes + (stg ? rbytes : 0));
            const int per_cu = (int)(65536 / lds);
            const long long gq = (long long)gg_cu_count() * (per_cu < 1 ? 1 : per_cu);
            const unsigned grid = (unsigned)(gq < 1 ? 1 : gq);
            const int UK = (int)(K / gt->qk * (gt->qk == 256 ? 8 : 1));
            const int ukf = ty == GG_F32 ? (int)(K / 32) : UK;
            const int xmx = bf ? kMdXM : 1;
            return gg_launch_md(s, ty, ukf, xmx, A, grid, lds);
        }
    }
    if (gemv && tokens <= 16) {
        GgGemvArgs A{};
        A.x = (const uint16_t*)A_->data; A.x_ld = x_ld;
        A.w = table ? nullptr : (const uint8_t*)W->data;
        A.wtab = table ? (const uint8_t* const*)W->data : nullptr;
        A.w_ld = w_ld; A.w_es = w_es;
        A.y = Y->data; A.y_ld = y_ld;
        A.sorted = (const int32_t*)so->data; A.off = (const int32_t*)of->data;
        A.M = (int)T; A.N = (int)N; A.K = (int)K;
        /* An expert's run is at most a row a token under a valid routing (top-k picks distinct
         * experts); a longer one takes more passes. */
        A.XM = (int)(tokens < kGgXM ? (tokens < 1 ? 1 : tokens) : kGgXM);
        const long long xbuf = gg_xbuf(A.XM, K, &A.XLM, &A.XR, &A.KC);
        /* Two weight rows a wave on wide experts of the multi-word unit types (twice the loads in
         * flight); the I-quants' three-word units already keep eight in flight a lane. */
        const int rpw = (ty != GG_F32 && ty != GG_IQ1_S && ty != GG_IQ2_XXS && N >= 1024) ? 2 : 1;
        const long long nrg = (N + 8 * rpw - 1) / (8 * rpw);
        long long rgpi = (L * nrg + 255) / 256;
        if (rgpi < 1) rgpi = 1;
        const long long ipe = (nrg + rgpi - 1) / rgpi;
        A.rgpi = (int)rgpi; A.ipe = (int)ipe;
        A.n_expert = (int)ne; A.top_k = (int)top_k; A.a_sorted = a_sorted ? 1 : 0; A.AR = (int)AR;
        A.x_al = gg_al16(A_->data, x_ld) ? 1 : 0;
        A.live_off = (int)tb;
        A.x_off = (int)(tb + gg_r16(ne * 4));
        const long long lds = A.x_off + xbuf * 4;
        const long long items = L * ipe;
        const unsigned grid = (unsigned)(items < 256 ? items : 256);
        return gg_launch_gemv(s, ty, rpw, true, false, A, grid, (unsigned)lds);
    }
    GgTiledArgs A{};
    A.x = (const uint16_t*)A_->data; A.x_ld = x_ld;
    A.w = table ? nullptr : (const uint8_t*)W->data;
    A.wtab = table ? (const uint8_t* const*)W->data : nullptr;
    A.w_ld = w_ld; A.w_es = w_es;
    A.y = Y->data; A.y_ld = y_ld;
    A.sorted = (const int32_t*)so->data; A.off = (const int32_t*)of->data;
    A.M = (int)T; A.N = (int)N; A.K = (int)K;
    A.n_expert = (int)ne; A.top_k = (int)top_k; A.a_sorted = a_sorted ? 1 : 0; A.AR = (int)AR;
    A.x_al = gg_al16(A_->data, x_ld) ? 1 : 0;
    A.tab_bytes = (int)tb;
    /* The WMMA kernel for the I-quants (every DeepSeek-V4.1 expert): 16 MT-row tiles. */
    if (A.x_al && (ty == GG_IQ1_S || ty == GG_IQ2_XXS) && K % (2 * kWmS) == 0) {
        const int bmw = 16 * gg_wm_mt(ty);
        const long long gx = (T + bmw - 1) / bmw + L, gy = (N + kWmBN - 1) / kWmBN;
        if (gy > 65535 || gx > 0x7fffffffLL) return R4D_NO(RAD_E_SHAPE);
        return gg_launch_wm(s, ty, true, false, A, dim3((unsigned)gx, (unsigned)gy));
    }
    /* 32-row tiles while the experts' runs average under 64 rows (prefill over many experts). */
    const int bm = T < 64 * L ? 32 : 128;
    const long long gx = (T + bm - 1) / bm + L, gy = (N + kTN - 1) / kTN;
    if (gy > 65535 || gx > 0x7fffffffLL) return R4D_NO(RAD_E_SHAPE);
    return gg_launch_tiled(s, ty, bm, true, false, A, dim3((unsigned)gx, (unsigned)gy),
                           (unsigned)(tb + 32 * (kTP + bm + 4) * 4));
}

}  // namespace

extern "C" int r4d_rad_gemm_nt_ggml_gemv(const RadArgs* a, RadStream s) { return gg_gemm(a, s, "N", "K", false, true); }
extern "C" int r4d_rad_gemm_nt_ggml_tiled(const RadArgs* a, RadStream s) { return gg_gemm(a, s, "N", "K", false, false); }
extern "C" int r4d_rad_logits_gemm_ggml_gemv(const RadArgs* a, RadStream s) {
    return gg_gemm(a, s, "n_vocab", "n_embd", true, true);
}
extern "C" int r4d_rad_logits_gemm_ggml_tiled(const RadArgs* a, RadStream s) {
    return gg_gemm(a, s, "n_vocab", "n_embd", true, false);
}
extern "C" int r4d_rad_moe_gemm_ggml_gemv(const RadArgs* a, RadStream s) { return gg_moe(a, s, true); }
extern "C" int r4d_rad_moe_gemm_ggml_tiled(const RadArgs* a, RadStream s) { return gg_moe(a, s, false); }

/* embed_lookup_ggml: the id's row dequantised, times `mult`, rounded once. A negative id or one
 * outside [vocab_offset, vocab_offset + n_vocab) writes a zero row (libref also refuses an id past
 * the vocabulary on a rank holding all of it, which a device launch cannot see). */
extern "C" int r4d_rad_embed_lookup_ggml(const RadArgs* a, RadStream s) {
    if (!a || a->n_t < 3) return R4D_NO(RAD_E_INVAL);
    const RadTensor *tok = r4d_opt(a, 0), *w = r4d_opt(a, 1), *x = r4d_opt(a, 2);
    if (!tok || !w || !x || !tok->data || !w->data || !x->data) return R4D_NO(RAD_E_INVAL);
    const GgType* gt = gg_type(r4d_gets(a, "type"));
    if (!gt) return R4D_NO(RAD_E_DTYPE);
    const long long E = r4d_geti_or(a, "n_embd", 0), V = r4d_geti_or(a, "n_vocab", 0);
    const long long voff = r4d_geti_or(a, "vocab_offset", 0);
    if (E <= 0 || V <= 0 || voff < 0 || E % gt->qk || E > 0x7fffffffLL || V > 0x7fffffffLL)
        return R4D_NO(RAD_E_SHAPE);
    if (tok->dtype != RAD_I32 || !r4d_contig(tok)) return R4D_NO(RAD_E_DTYPE);
    if (x->dtype != RAD_BF16) return R4D_NO(RAD_E_DTYPE);
    if (!w->data || w->rank != 2 || w->shape[0] < V) return R4D_NO(RAD_E_SHAPE);
    const long long rb = E / gt->qk * gt->bb;
    int ty = 0;
    long long w_ld = 0;
    if (w->dtype == RAD_U8) {
        if (w->shape[1] != rb && w->shape[1] != E) return R4D_NO(RAD_E_SHAPE);
        if ((uintptr_t)w->data & (gt->t == GG_Q5_K ? 3u : 1u)) return R4D_NO(RAD_E_STRIDE);
        ty = gt->t;
        w_ld = rb;
    } else if (w->dtype == RAD_F32) {
        if (w->shape[1] != E || !gg_inner1(w)) return R4D_NO(RAD_E_SHAPE);
        ty = GG_F32;
        w_ld = (long long)w->stride[0] * 4;
    } else {
        return R4D_NO(RAD_E_DTYPE);
    }
    long long M = 0;
    const long long x_ld = r4d_rows_pitch(x, E, &M);
    if (x_ld < 0) return R4D_NO(RAD_E_STRIDE);
    if (M <= 0 || M > 0x7fffffffLL || r4d_numel(tok) < M) return R4D_NO(RAD_E_SHAPE);
    const float mult = (float)r4d_getf(a, "mult", 1.0);
    return gg_launch_embed(s, ty, (const int32_t*)tok->data, (const uint8_t*)w->data, w_ld,
                           (uint16_t*)x->data, x_ld, (int)M, (int)E, (int)V, voff, mult);
}

extern "C" void r4d_gg_gemv_pin(int rpw, int grid) {
    g_gg_pin_rpw = (rpw == 1 || rpw == 2 || rpw == 4) ? rpw : 0;
    g_gg_pin_grid = grid > 0 ? grid : 0;
}

/* The core's runtime switches (core/runtime/fn4_switch.h): "gg_gemv" 0 / 1 (the decode band's form, see GgForm).
 * rad_fn4_switch applies, called between steps with every rank thread parked: 1 = applied, 0 = not a libr4d switch,
 * < 0 = refused (a value this libr4d does not know). rad_fn4_accepts says the same without applying (the server
 * checks a request with it before queueing), rad_fn4_value what is applied (what /admin/fn4 reports). */
extern "C" int rad_fn4_accepts(const char* name, int value) {
    if (!name) return 0;
    if (!std::strcmp(name, "gg_gemv")) return gg_gemv_known(value) ? 1 : -1;
    return 0;
}
extern "C" int rad_fn4_switch(const char* name, int value) {
    const int ok = rad_fn4_accepts(name, value);
    if (ok <= 0) return ok;
    g_gg_gemv.store(value, std::memory_order_relaxed);
    return 1;
}
extern "C" int rad_fn4_value(const char* name, int* applied) {
    if (!name || !applied) return 0;
    if (!std::strcmp(name, "gg_gemv")) {
        *applied = g_gg_gemv.load(std::memory_order_relaxed);
        return 1;
    }
    return 0;
}
