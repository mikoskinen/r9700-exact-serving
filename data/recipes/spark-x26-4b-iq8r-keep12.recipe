# Quality-preferred tested allocation for Spark X2.6 4B.
# Keep layers 0..11 in source BF16; fit the six projections in layers 12..35 to IQ8R.
# The ordered recipe glob syntax has no exclusions, so the 144 layer/projection rules below
# explicitly begin at layer 12. Unmatched weights keep their checkpoint encoding.
# The tied output head remains RTN-quantized; the small attention gate and other non-target
# tensors remain BF16/FP32 as described in docs/ARCHITECTURES.md.
#
# Reproduce from the BF16 checkpoint with the published RADGRAM2 calibration directory:
#   CALIB=/path/to/grams rad-convert /path/to/XHToken-Spark-X2.6-4B \
#     --recipe data/recipes/spark-x26-4b-iq8r-keep12.recipe \
#     --set quantization_config.quant_method=w8a8 \
#     --set quantization_config.fmt=fwht128 -o spark-x2.6-4b-iq8r-keep12.rad
# This is a tested allocation, not a universal task-quality guarantee.
blk.12.attn_q.weight gptq codes=i8 group=128 scale=bf16 transform=fwht128 clamp=sym rule=search calib=$CALIB
blk.12.attn_k.weight gptq codes=i8 group=128 scale=bf16 transform=fwht128 clamp=sym rule=search calib=$CALIB
blk.12.attn_v.weight gptq codes=i8 group=128 scale=bf16 transform=fwht128 clamp=sym rule=search calib=$CALIB
blk.12.attn_output.weight gptq codes=i8 group=128 scale=bf16 transform=fwht128 clamp=sym rule=search calib=$CALIB
blk.12.ffn_gate_up.weight gptq codes=i8 group=128 scale=bf16 transform=fwht128 clamp=sym rule=search calib=$CALIB
blk.12.ffn_down.weight gptq codes=i8 group=128 scale=bf16 transform=fwht128 clamp=sym rule=search calib=$CALIB
