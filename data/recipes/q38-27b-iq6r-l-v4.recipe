# q38-27b-iq6r-l-v4.recipe -- IQ6R-L-V4: Qwen3.8-27B at ~6.939 bits a weight.
# IQR-V4: every trunk linear rotated by fwht128 and fitted by GPTQ in act order (tcq_order=1) against the
# calib Hessians, its codes a tail-biting trellis down each column whose 2^16 states' values are computed
# from the state (tcq=16 tcq_code=mad; 2^15 at two bits) under one f32 scale a row, the head-fed projections
# under a bf16 scale a (row, 128) block; widths by layer band and projection from measured prices
# (6-bit, 7-bit, int8; docs/IQR.md, "IQR-V4"). Served by qwen35_w8a8 at i8a8h with rotated int8 activations.
# The lm_head is int8, GPTQ'd against the head's input Hessian.
#
#   CALIB=<calib Hessians, RADGRAM2> rad-convert <Qwen3.8-27B bf16> --recipe data/recipes/q38-27b-iq6r-l-v4.recipe \
#       --set quantization_config.quant_method=w8a8 --set quantization_config.fmt=fwht128 -o OUT.rad
#
# The competition's private tiers 1+2: 6.939 bpw, mean KL 0.00068, top-1 99.08% (IQ6R-L-V3: 6.939 bpw, 0.00072).

blk.0.ssm_inz.weight gptq codes=u7 tcq=16 tcq_code=mad tcq_rows=256 block=1x* scale=f32 transform=fwht128 tcq_gain=1.30 damp=0.01 calib=$CALIB tcq_order=1
blk.0.ssm_out.weight gptq codes=u7 tcq=16 tcq_code=mad tcq_rows=256 block=1x* scale=f32 transform=fwht128 tcq_gain=1.5 damp=0.01 calib=$CALIB tcq_order=1
blk.0.ffn_gate_up.weight gptq codes=u7 tcq=16 tcq_code=mad tcq_rows=512 block=1x* scale=f32 transform=fwht128 tcq_gain=1.30 damp=0.01 calib=$CALIB tcq_order=1
blk.0.ffn_down.weight gptq codes=u6 tcq=16 tcq_code=mad tcq_rows=256 block=1x* scale=f32 transform=fwht128 tcq_gain=1.24 damp=0.01 calib=$CALIB tcq_order=1
blk.1.ssm_inz.weight gptq codes=u7 tcq=16 tcq_code=mad tcq_rows=256 block=1x* scale=f32 transform=fwht128 tcq_gain=1.30 damp=0.01 calib=$CALIB tcq_order=1
blk.1.ssm_out.weight gptq codes=u7 tcq=16 tcq_code=mad tcq_rows=256 block=1x* scale=f32 transform=fwht128 tcq_gain=1.5 damp=0.01 calib=$CALIB tcq_order=1
blk.1.ffn_gate_up.weight gptq codes=u7 tcq=16 tcq_code=mad tcq_rows=512 block=1x* scale=f32 transform=fwht128 tcq_gain=1.30 damp=0.01 calib=$CALIB tcq_order=1
blk.1.ffn_down.weight gptq codes=u6 tcq=16 tcq_code=mad tcq_rows=256 block=1x* scale=f32 transform=fwht128 tcq_gain=1.24 damp=0.01 calib=$CALIB tcq_order=1
