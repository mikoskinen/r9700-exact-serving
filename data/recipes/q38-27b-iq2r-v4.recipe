# q38-27b-iq2r-v4.recipe -- IQ2R-V4: Qwen3.8-27B at ~2.470 bits a weight.
# IQR-V4: every trunk linear rotated by fwht128 and fitted by GPTQ in act order (tcq_order=1) against the
# calib Hessians, its codes a tail-biting trellis down each column whose 2^16 states' values are computed
# from the state (tcq=16 tcq_code=mad; 2^15 at two bits) under one f32 scale a row, the head-fed projections
# under a bf16 scale a (row, 128) block; widths by layer band and projection from measured prices
# (2-bit, 3-bit, 4-bit; docs/IQR.md, "IQR-V4"). Served by qwen35_w8a8 at i8a8h with rotated int8 activations.
# The lm_head is vocabulary-weighted (4.0 b mean, data/vhead/): its width classes output.k<B> are
# rows of the checkpoint tools/vhead.py builds from the bf16 one; GPTQ reads the head's input Hessian.
#
#   python3 tools/vhead.py <Qwen3.8-27B bf16> VHEAD data/vhead/q38-27b-vhead-4.0.cls
#   CALIB=<calib Hessians, RADGRAM2> rad-convert VHEAD --recipe data/recipes/q38-27b-iq2r-v4.recipe \
#       --set quantization_config.quant_method=w8a8 --set quantization_config.fmt=fwht128 -o OUT.rad
#
# The competition's private tiers 1+2: 2.470 bpw, mean KL 0.06113, top-1 91.23% (IQ2R-V3: 2.465 bpw, 0.06807).

blk.0.ssm_inz.weight gptq codes=u2 tcq=15 tcq_code=mad tcq_rows=256 block=1x* scale=f32 transform=fwht128 tcq_gain=1.04 damp=0.01 calib=$CALIB tcq_order=1
blk.0.ssm_out.weight gptq codes=u3 tcq=16 tcq_code=mad tcq_rows=256 block=1x* scale=f32 transform=fwht128 tcq_gain=1.08 damp=0.01 calib=$CALIB tcq_order=1
blk.0.ffn_gate_up.weight gptq codes=u2 tcq=15 tcq_code=mad tcq_rows=512 block=1x* scale=f32 transform=fwht128 tcq_gain=1.04 damp=0.01 calib=$CALIB tcq_order=1
blk.0.ffn_down.weight gptq codes=u2 tcq=15 tcq_code=mad tcq_rows=256 block=1x* scale=f32 transform=fwht128 tcq_gain=1.04 damp=0.01 calib=$CALIB tcq_order=1
blk.1.ssm_inz.weight gptq codes=u2 tcq=15 tcq_code=mad tcq_rows=256 block=1x* scale=f32 transform=fwht128 tcq_gain=1.04 damp=0.01 calib=$CALIB tcq_order=1
blk.1.ssm_out.weight gptq codes=u3 tcq=16 tcq_code=mad tcq_rows=256 block=1x* scale=f32 transform=fwht128 tcq_gain=1.08 damp=0.01 calib=$CALIB tcq_order=1
blk.1.ffn_gate_up.weight gptq codes=u2 tcq=15 tcq_code=mad tcq_rows=512 block=1x* scale=f32 transform=fwht128 tcq_gain=1.04 damp=0.01 calib=$CALIB tcq_order=1
